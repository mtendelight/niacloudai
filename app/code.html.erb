                <div class="quantity-wrapper">
    <button type="button" class="quantity-button btn-danger" data-action="decrease" style="font-size: 40px;">-</button>
    <%= f.number_field :quantity, value: 1, required: true, class: 'quantity-field new22', min: 0 %>
    <button type="button" class="quantity-button btn-success" data-action="increase" style="font-size: 40px;">+</button>
</div>

              
            </div>

          </div>
        </div>
        <div class="col-md-2   col-12"> <!-- Adjusted column size -->
          <div class="actions text-end"> <!-- Align actions to the right -->
            <%= link_to "Remove", "#", class: "remove_menu_item btn btn-danger" %> <!-- Added Bootstrap button styling -->
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<h3></h3>
    <div class="actions">
      <%= button_tag "+ Add Menu Item +", id: "add_menu_item", class: 'btn  btn-success menu-item-select ' %>   

     
    
    </div>
</div>
  

  

<h2>Order Items</h2>

<div id="order_items_summary" class="order-summary">
  <% @order.order_items.each do |order_item| %>
