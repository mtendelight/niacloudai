        <p>
          <%= "OrderItem ##{order_item.id}: #{menu_item.name} (Qty: #{order_item.quantity})" %>
        </p>
      </div>
    <% end %>
  <% end %>
</div>


     <div class="field center" style="width: 30%">
<br/>
<%= form.number_field :total_price, step: 0.01, readonly: true, value: 0, class: 'small-field new3' %>
<br/>
 <strong style="color: brown; font-size: 20px;"><b style="color: black;">By <br/><br/></b> <h3><%= current_user.username %></h3></strong>

<br/>
    <div>
      <%= form.submit "Place Order", class: 'btn btn-warning active ' %>
    
    </div>
<br/><br/>
  <% end %>
</div>

</div>

<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function() {
  const menuItemsContainer = document.getElementById('menu_items');
  const addMenuItemButton = document.getElementById('add_menu_item');
  const orderForm = document.getElementById('order_form'); // Assuming you have an order form element
  let itemIndex = <%= @order.order_items.size %>; // Start indexing from current count

  // Function to get price for menu item
  function getMenuItemPrice(menuItemId) {
    const menuItems = <%= raw MenuItem.all.to_json %>;
    const menuItem = menuItems.find(item => item.id == menuItemId);
    return menuItem ? menuItem.price : 0;
  }

  // Function to calculate the total price
  function calculateTotalPrice() {
    let total = 0;

    // Loop through each menu item fields
    menuItemsContainer.querySelectorAll('.menu_item_fields').forEach(function(itemFields) {
      const menuItemSelect = itemFields.querySelector('.menu-item-select');
      const quantityField = itemFields.querySelector('.quantity-field');

      // Get the selected option and its ID
      const selectedOption = menuItemSelect.selectedOptions[0];
      const price = parseFloat(selectedOption ? getMenuItemPrice(selectedOption.value) : 0) || 0;

      // Get the quantity from the order item
      const quantity = parseInt(quantityField.value) || 0; // Default to 0 if not set

      // Calculate total price for this item
      total += price * quantity; 
    });

    // Update the total price field in the form
    document.querySelector('input[name="order[total_price]"]').value = total.toFixed(2); // Format to 2 decimal places
  }

  // Function to initialize Select2
  function initializeSelect2(selectElement) {
    $(selectElement).select2({
      // Add any Select2 options here
      placeholder: "Select a menu item",
      allowClear: true
    });
  }

  // Function to initialize quantity controls
  function initializeQuantityControls(control) {
    const quantityInput = control.querySelector('.quantity-field');

    control.querySelector('[data-action="increase"]').addEventListener('click', () => {
      quantityInput.value = parseInt(quantityInput.value) + 1;
      calculateTotalPrice(); // Recalculate total after change
      updateOrderItemsSummary(); // Update summary after quantity change
    });

    control.querySelector('[data-action="decrease"]').addEventListener('click', () => {
      const newValue = parseInt(quantityInput.value) - 1;
      quantityInput.value = Math.max(newValue, 0); // Prevent negative quantity
      calculateTotalPrice(); // Recalculate total after change
      updateOrderItemsSummary(); // Update summary after quantity change
    });
  }

  // Function to add a new menu item
  function addNewMenuItem() {
    const newMenuItemFields = menuItemsContainer.children[0].cloneNode(true);
    
    // Update the name and id of inputs to include the new index
    newMenuItemFields.querySelectorAll('input, select').forEach(function(input) {
      const name = input.name.replace(/\[\d+\]/, `[${itemIndex}]`); // Update the index
      const id = input.id.replace(/_\d+$/, `_${itemIndex}`); // Update the ID
      input.name = name;
      input.id = id;
      input.value = ""; // Reset the value
    });
    
    // Reset quantity to 0 and price data attribute
    newMenuItemFields.querySelector('.quantity-field').value = 0; // Set default quantity to 0
    newMenuItemFields.querySelectorAll('.menu-item-select').forEach(select => {
      select.selectedIndex = 0; // Reset selection
    });
    
    // Initialize Select2 for the new menu item select
    const newMenuItemSelect = newMenuItemFields.querySelector('.menu-item-select');
    initializeSelect2(newMenuItemSelect);

    // Initialize quantity controls for the new menu item
    const quantityControls = newMenuItemFields.querySelector('.quantity-controls');
    initializeQuantityControls(quantityControls);
    
    menuItemsContainer.appendChild(newMenuItemFields);
    calculateTotalPrice(); // Update total price after adding new item
    updateOrderItemsSummary(); // Update summary after adding new item
    itemIndex++; // Increment index for the next item
  }

  // Event listener for adding a new menu item
  addMenuItemButton.addEventListener('click', function(e) {
    e.preventDefault();
    menuItemsContainer.style.display = 'block'; // Show menu items container
    addNewMenuItem(); // Add new menu item
  });

  // Use event delegation for menu items container
  menuItemsContainer.addEventListener('click', function(e) {
    const target = e.target;

    // Check if 'Remove' button is clicked
    if (target.classList.contains('remove_menu_item')) {
      e.preventDefault();
      const itemFields = target.closest('.menu_item_fields');
      if (itemFields) {
        itemFields.remove();
        // Update total price and summary after removal
        calculateTotalPrice();
        updateOrderItemsSummary();
      }
    }
  });

  // Listen for changes in the menu item selection
  menuItemsContainer.addEventListener('change', function(e) {
    const target = e.target;

    // Check if a menu item selection has changed
    if (target.classList.contains('menu-item-select')) {
      // Update total price and summary when a menu item is selected or changed
      calculateTotalPrice();
      updateOrderItemsSummary();
    }
  });

  // Event listener for quantity changes
  menuItemsContainer.addEventListener('input', function(e) {
    if (e.target && e.target.classList.contains('quantity-field')) {
      calculateTotalPrice(); // Update total price when quantity changes
      updateOrderItemsSummary(); // Update summary when quantity changes
    }
  });

  // Function to update the order items summary
  function updateOrderItemsSummary() {
    const summaryContainer = document.getElementById('order_items_summary');
    summaryContainer.innerHTML = ""; // Clear current summary
    menuItemsContainer.querySelectorAll('.menu_item_fields').forEach(function(itemFields) {
      const menuItemSelect = itemFields.querySelector('.menu-item-select');
      const selectedOption = menuItemSelect.selectedOptions[0];
      const quantity = itemFields.querySelector('.quantity-field').value;
      if (selectedOption) {
        const itemSummary = document.createElement('p');
        itemSummary.textContent = `OrderItem #${selectedOption.value}: ${selectedOption.textContent} (Qty: ${quantity})`;
        summaryContainer.appendChild(itemSummary);
      }
    });
  }

  // Initialize the order items when the page loads
  function initializeOrderItems() {
    menuItemsContainer.querySelectorAll('.menu_item_fields').forEach(function(itemFields, index) {
      const quantityControls = itemFields.querySelector('.quantity-controls');
      initializeQuantityControls(quantityControls); // Initialize for existing items

      // Initialize Select2 for the first item only if it’s the first row
      if (index === 0) {
        // Do not apply Select2
      } else {
        const menuItemSelect = itemFields.querySelector('.menu-item-select');
        initializeSelect2(menuItemSelect);
      }
    });
  }

orderForm.addEventListener('submit', function(e) {
    let hasZeroQuantity = false;

    // Check for any item with quantity of 0
    menuItemsContainer.querySelectorAll('.menu_item_fields').forEach(function(itemFields) {
        const quantityField = itemFields.querySelector('.quantity-field');
        const quantity = parseInt(quantityField.value) || 0; // Default to 0 if not set
        if (quantity === 0) {
            hasZeroQuantity = true;
        }
    });

    // If there's an item with 0 quantity, prevent submission and show a confirm prompt
    if (hasZeroQuantity) {
        e.preventDefault(); // Prevent form submission
        const confirmSubmission = confirm("Hello <%=current_user.username %>, One or more items in your order have a quantity of 0. Please review the order before proceeding. Click 'Cancel' or 'OK' to make corrections.");
        if (!confirmSubmission) {
            return; // If the user clicks "Cancel", exit the function
        }
    }
});


// Validation for order submission
orderForm.addEventListener('submit', function(e) {
    let allQuantitiesValid = true;

    // Check if any item has a quantity of 0
    menuItemsContainer.querySelectorAll('.menu_item_fields').forEach(function(itemFields) {
        const quantityField = itemFields.querySelector('.quantity-field');
        const quantity = parseInt(quantityField.value) || 0; // Default to 0 if not set
        if (quantity === 0) {
            allQuantitiesValid = false;
        }
    });

    // If all quantities are greater than 0, show a confirmation prompt
    if (allQuantitiesValid) {
        e.preventDefault(); // Prevent form submission
        const confirmSubmission = confirm("Hello <%=current_user.username %>, Please confirm that the items listed under order items are accurate according to the customer's order before proceeding. Click 'OK' to continue to submit or 'Cancel' to go back and make corrections.");
        if (confirmSubmission) {
            // If the user clicks "OK", submit the form
            orderForm.submit();
        }
        // If the user clicks "Cancel", the form will not be submitted
    }
});

  initializeOrderItems(); // Run initialization on page load
});
</script>
