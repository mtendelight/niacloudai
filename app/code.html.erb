  <div class="container elena2" style="width: 100% !important;">
      

<div class="login">


<%= form_with(model: @order, local: true, html: { class: 'order-form', id: 'order_form' }, data: { turbo: false }) do |form| %>

  <% if @order.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@order.errors.count, "error") %> prevented this order from being saved:</h4>
      <ul>
        <% @order.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


   <h2 class="heading">
   
          (<%= link_to "Refresh", new_order_path, class: "btn btn-warning" %>)(<%= link_to "<<Back", orders_path, class: "btn btn-warning" %>)</h2>
   
 <br/>
 <div class="row"><div class="col">
 <div class="field center new22" style="width: 100%">
   <strong style="color: brown; font-weight: bold;"> <%= form.label :login, "Select Waiter", class: "required" %></strong>
 <%= form.collection_select :user_id, User.with_role('waiter').order(username: :asc), :id, :username, 
          { prompt: "Select Waiter", id: 'username_select' }, 
          { class: "form-control new24 elena", required: true, selected: @order.user_id } %>

  </div></div>

<div class="col">
    <div class="field center new22" style="width: 100%">
     <strong style="color: brown; font-weight: bold;"> <%= form.label :table_id, "Select Table", class: "required" %></strong>
      <%= form.collection_select :table_id, Table.all, :id, :number, { prompt: "Select Table No." }, { class: 'select_table small-field  elena', required: true } %>
    </div></div></div>

 <div class="form-group elena2">
  <%= form.hidden_field :kitchen_status_id, value: @order.kitchen_status_id %>
</div>


<h3>Menu</h3>

<div id="menu_items">

  <%= form.fields_for :order_items do |f| %>
    <div class="menu_item_fields new22">
      <div class="row mb-3 align-items-center"> <!-- Align items vertically -->
        <div class="col-md-7 col-12"> <!-- Adjusted column size -->
        <div class="field center">
    <%= f.label :menu_item_id, "Menu Item", class: "required" %>
