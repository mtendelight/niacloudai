<!-- app/views/devise/sessions/new.html.erb -->

<%= render "layouts/header" %>

<style>
/* ============================================================
   FLOW LOGIN PAGE
============================================================ */

.flow-login-page {
  min-height: calc(100vh - 1px);
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;

  padding: 30px 18px;

  box-sizing: border-box;

  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(25,195,156,.10),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 15%,
      rgba(77,163,255,.09),
      transparent 28%
    ),
    #061116;
}


/* ============================================================
   LOGIN CARD
============================================================ */

.flow-login-card {
  width: 100%;
  max-width: 440px;

  box-sizing: border-box;

  padding: 34px;

  background:
    linear-gradient(
      180deg,
      rgba(16,44,52,.96),
      rgba(8,26,32,.98)
    );

  border: 1px solid rgba(255,255,255,.08);

  border-radius: 24px;

  box-shadow:
    0 30px 80px rgba(0,0,0,.45),
    0 0 0 1px rgba(255,255,255,.02);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}


/* ============================================================
   LOGIN FORM
============================================================ */

.login {
  width: 100%;
  max-width: 100%;
  display: block;
}

.login form {
  width: 100%;
  max-width: 100%;
}


/* ============================================================
   BRAND
============================================================ */

.flow-login-brand {
  text-align: center;
  margin-bottom: 30px;
}

.flow-login-logo {
  width: 58px;
  height: 58px;

  object-fit: contain;

  border-radius: 16px;

  margin-bottom: 14px;

  box-shadow:
    0 0 0 6px rgba(77,163,255,.07),
    0 12px 30px rgba(0,0,0,.30);
}

.flow-login-title {
  margin: 0;

  color: #fff;

  font-family: "Manrope", sans-serif;

  font-size: 23px;

  font-weight: 800;

  letter-spacing: -.04em;
}

.flow-login-subtitle {
  display: block;

  margin-top: 6px;

  color: #71898e;

  font-family: "Space Mono", monospace;

  font-size: 8px;

  letter-spacing: .16em;

  text-transform: uppercase;
}


/* ============================================================
   STATUS
============================================================ */

.flow-login-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  margin-bottom: 25px;

  color: #7e989d;

  font-size: 10px;

  text-align: center;
}

.flow-login-status-dot {
  width: 7px;
  height: 7px;

  flex: 0 0 7px;

  border-radius: 50%;

  background: #19c39c;

  box-shadow:
    0 0 0 4px rgba(25,195,156,.08),
    0 0 14px rgba(25,195,156,.45);
}


/* ============================================================
   FLASH
============================================================ */

.flow-login-alert {
  width: 100%;
  box-sizing: border-box;

  padding: 12px 14px;

  margin-bottom: 20px;

  border-radius: 12px;

  border: 1px solid rgba(255,255,255,.08);

  background: rgba(255,255,255,.035);

  color: #cbdadc;

  font-size: 12px;

  overflow-wrap: anywhere;
}

.flow-login-alert.danger {
  border-color: rgba(255,90,90,.20);

  background: rgba(255,70,70,.07);

  color: #ffb2b2;
}

.flow-login-alert.success {
  border-color: rgba(25,195,156,.20);

  background: rgba(25,195,156,.06);

  color: #9ee8d5;
}


/* ============================================================
   FORM GROUP
============================================================ */

.flow-login-form-group {
  width: 100%;

  margin-bottom: 20px;
}


/* ============================================================
   LABEL
============================================================ */

.flow-login-label {
  display: block;

  margin-bottom: 8px;

  color: #9bb0b4;

  font-size: 11px;

  font-weight: 600;

  letter-spacing: .02em;
}


/* ============================================================
   INPUT / SELECT
============================================================ */

.flow-login-input,
.flow-login-select {

  display: block;

  width: 100% !important;

  max-width: 100% !important;

  min-width: 0;

  min-height: 48px;

  padding: 11px 14px;

  box-sizing: border-box;

  border-radius: 12px;

  border: 1px solid rgba(255,255,255,.09);

  background: rgba(255,255,255,.035);

  color: #fff;

  font-family: "DM Sans", sans-serif;

  font-size: 13px;

  outline: none;

  transition:
    border-color .2s ease,
    background .2s ease,
    box-shadow .2s ease;

  -webkit-appearance: none;
}

.flow-login-input::placeholder {
  color: #60777c;
}

.flow-login-input:focus,
.flow-login-select:focus {

  border-color: rgba(25,195,156,.45);

  background: rgba(25,195,156,.035);

  box-shadow:
    0 0 0 4px rgba(25,195,156,.07);
}

.flow-login-select option {
  background: #0b2027;
  color: #fff;
}


/* ============================================================
   LOGIN BUTTON
============================================================ */

.flow-login-button {

  display: block;

  width: 100% !important;

  max-width: 100% !important;

  min-height: 50px;

  box-sizing: border-box;

  border: 0;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #19c39c,
      #0d8d76
    );

  color: #fff;

  font-family: "Manrope", sans-serif;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: .01em;

  box-shadow:
    0 10px 30px rgba(25,195,156,.18);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    filter .2s ease;
}

.flow-login-button:hover {

  color: #fff;

  transform: translateY(-2px);

  filter: brightness(1.05);

  box-shadow:
    0 15px 35px rgba(25,195,156,.28);
}

.flow-login-button:active {
  transform: scale(.985);
}


/* ============================================================
   FOOTER
============================================================ */

.flow-login-footer {

  width: 100%;

  margin-top: 25px;

  padding-top: 20px;

  border-top:
    1px solid rgba(255,255,255,.06);

  text-align: center;

  color: #60777c;

  font-size: 10px;

  overflow-wrap: anywhere;
}

.flow-login-footer a {

  color: #6fa9ff !important;

  text-decoration: none;

  font-weight: 600;
}

.flow-login-footer a:hover {
  color: #19c39c !important;
}


/* ============================================================
   TABLET / MOBILE
============================================================ */

@media (max-width: 576px) {

  .flow-login-page {

    width: 100%;

    min-height: 100vh;

    padding: 20px 10px;

    align-items: flex-start;

    padding-top: 30px;

    overflow-x: hidden;
  }

  .flow-login-card {

    width: 100%;

    max-width: 100%;

    padding: 26px 18px;

    border-radius: 20px;

    box-sizing: border-box;
  }

  .flow-login-logo {
    width: 52px;
    height: 52px;
  }

  .flow-login-title {
    font-size: 21px;
  }

  .flow-login-input,
  .flow-login-select {

    width: 100% !important;

    min-height: 50px;

    font-size: 14px;
  }

  .flow-login-button {

    width: 100% !important;

    min-height: 52px;

    font-size: 14px;
  }
}


/* ============================================================
   VERY SMALL IPHONES
============================================================ */

@media (max-width: 390px) {

  .flow-login-page {

    padding-left: 7px;
    padding-right: 7px;

    padding-top: 22px;
  }

  .flow-login-card {

    padding: 22px 15px;

    border-radius: 18px;
  }

  .flow-login-brand {
    margin-bottom: 24px;
  }

  .flow-login-logo {
    width: 48px;
    height: 48px;
  }

  .flow-login-title {
    font-size: 19px;
  }

  .flow-login-status {
    font-size: 9px;
  }

  .flow-login-input,
  .flow-login-select {

    min-height: 48px;

    padding-left: 12px;
    padding-right: 12px;
  }
}


/* ============================================================
   iPHONE PORTRAIT SAFETY
============================================================ */

@media (max-width: 430px) {

  html,
  body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .flow-login-page {
    width: 100%;
    max-width: 100%;
  }

  .flow-login-card {
    width: 100%;
    max-width: 100%;
  }
}
</style>


<div class="flow-login-page">

  <div class="flow-login-card">

    <!-- ======================================================
         BRAND
    ======================================================= -->

    <div class="flow-login-brand">

      <%= image_tag "flogoo.png",
          alt: "Flow",
          class: "flow-login-logo" %>

      <h1 class="flow-login-title">
        Flow
      </h1>

      <span class="flow-login-subtitle">
        Command Centre
      </span>

    </div>


    <!-- ======================================================
         STATUS
    ======================================================= -->

    <div class="flow-login-status">

      <span class="flow-login-status-dot"></span>

      <span>
        SECURE OPERATIONS ACCESS
      </span>

    </div>


    <!-- ======================================================
         FLASH MESSAGES
    ======================================================= -->

    <% if flash[:timedout] && flash[:alert] %>

      <% flash.keep(:timedout) %>
      <% flash.keep(:alert) %>

      <div class="flow-login-alert danger">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        Your session expired.
        Please sign in again to continue.

      </div>

    <% else %>

      <% flash.each do |name, message| %>

        <div class="flow-login-alert <%= message.to_s.include?('Invalid') ? 'danger' : 'success' %>">

          <i class="bi <%= message.to_s.include?('Invalid') ? 'bi-exclamation-circle-fill' : 'bi-check-circle-fill' %> me-2"></i>

          <%= message %>

        </div>

      <% end %>

    <% end %>


    <!-- ======================================================
         LOGIN FORM
    ======================================================= -->

    <div class="login">

      <%= form_for(
            resource,
            as: resource_name,
            url: session_path(resource_name),
            html: { data: { turbo: false } }
          ) do |f| %>


        <!-- USERNAME -->

        <div class="flow-login-form-group">

          <%= f.label :login,
              "Username",
              class: "flow-login-label" %>

          <%= f.collection_select :login,

            User.joins(:roles)
                .where(
                  roles: {
                    name: ["superadmin"]
                  }
                )
                .distinct
                .order(username: :asc),

            :username,
            :username,

            { prompt: "Choose username to login..." },

            {
              class: "flow-login-select new22",
              id: "username_select"
            }

          %>

        </div>


        <!-- PASSWORD -->

        <div class="flow-login-form-group">

          <%= f.label :password,
              "Password",
              class: "flow-login-label" %>

          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "flow-login-input new22",
              placeholder: "Enter your password" %>

        </div>


        <!-- LOGIN -->

        <div>

          <%= f.submit "Log in",
              class: "flow-login-button",
              data: { turbo: false } %>

        </div>


      <% end %>

    </div>


    <!-- ======================================================
         DEVISE LINKS
    ======================================================= -->

    <div class="flow-login-footer">

      <%= render "devise/shared/links" %>

    </div>

  </div>

</div>