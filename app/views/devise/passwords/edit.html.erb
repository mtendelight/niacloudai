<%= render "layouts/header" %>

<div class="container">



<h2>Change your password</h2>
 <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="login">
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="form-group" style="word-break: break-word; white-space: pre-wrap;">
    <%= f.label :password, "New password" %><br />
    <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em><br />
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control new22" %>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation, "Confirm new password" %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control new22"%>
  </div>

  <div class="form-group  actions">
    <%= f.submit "Change my password" %>
  </div>
<% end %>
</div></div></div></div>
<hr/>
<div class="container" style="font-size: 20px; font-weight: bold;">


<%= render "devise/shared/links" %>
</div>


<style type="text/css">
  
  .login {
  display: flex;
  justify-content: center;
  align-items: center;
}
</style>