<%= render "layouts/header" %>

<div class="container">


<h2 style="word-break: break-word;
  white-space: pre-wrap;">Forgot your password?</h2>
<div class="login">
<%= form_for(resource, as: resource_name, url: password_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
<center>
  <div class="form-group">
   <p><%= f.label :email %><br />
   <%= f.email_field :email, class: "form-control new22" %></p>
  </div>
</center></div>
  <div class="actions">
    <%= f.submit "Send me reset password instructions", data: { disable_with: 'Please wait...' }%>
  </div>
<% end %>
<div style="font-size: 16px;">
<%= render "devise/shared/links" %></div>



<style type="text/css">
  

  .login {
  display: flex;
  justify-content: center;
  align-items: center;
}
</style>