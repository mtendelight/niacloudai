<!-- app/views/devise/sessions/new.html.erb -->

<%= render "layouts/header" %>

<style>
  .login {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  /* Adjust form or inner content inside .login if needed */
  .login .form-control {
    width: 100%;
    max-width: 400px;
    margin-bottom: 15px;
  }

  /* Make sure submit buttons are responsive too */
  .login .btn {
    width: 100%;
    max-width: 400px;
  }


</style>


<div class="container" style="width: 100%">
<div class="my-4 text-center">

  <!-- Brand -->
  <div class="mb-3 fw-bold fs-5 d-flex justify-content-center align-items-center gap-2">
    <span>NiaCloud</span>
    <%= image_tag "flogo.png", size: "40x30", style: "border-radius: 20px;" %>
    <span> ERP</span>
  </div>

 


 <% if flash[:timedout] && flash[:alert] %>
    <% flash.keep(:timedout) %>
    <% flash.keep(:alert) %>
    <div class = "alert alert-danger">
      Your session expired. Please sign in again to continue.
    </div>
  <% else %>
    <% flash.each do |name, message| %>
      <div class = "alert alert-<%= message.include?('Invalid') ? 'danger' : 'success'%>">
       <ul>
          <%= message %>
       </ul>
      </div>
    <% end %>
  <% end %>


<div class="container" style="width: 80%">
  <center>
    <div class="col-md-6">
      <div class="login">
  
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>
        <div class="new22">
          <div class="form-group"><center>
            <%= f.label :login, "Username or Email" %>
            <%= f.text_field :login, placeholder: "Username", class: "new22" %>
          </div>

          <div class="form-group">
            <%= f.label :password %>
            <%= f.password_field :password, autocomplete: 'off', class: 'form-control new22' %>
          </div>
</center>
          <div class=" actions">
            <%= f.submit 'Log in', class: 'btn btn-primary', data: { turbo: false } %>
          </div>
        <% end %></center>
  
<div class="container" style="font-size: 20px; font-weight: bold; width: 100%">
  <%= render "devise/shared/links" %>
</div>
</div></div></div></div></div>