<style type="text/css">
    
.full-width-container {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
}


.scroll-to-bottom {
  position: fixed;
  bottom: 100px;
  right: 0px;
  width: 40px;
  height: 40px;
  z-index: 999;
  background-color: white !important;
  border-radius: 50%;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  transition: background-color 0.3s;
}

.scroll-to-bottom:hover {
  background-color: #f0f0f0;
}

.scroll-to-bottom img {
  width: 20px;
  height: 20px;
}


/* ==========================================
   GLOBAL THEME — TOP & BOTTOM ONLY
   ========================================== */

:root {
  --theme-bg: #0f172a;
  --theme-bg-2: #111827;
  --theme-text: #ffffff;
}

/* TOP THEME AREA */
.theme-top {
  width: 100%;
  background: linear-gradient(
    135deg,
    var(--theme-bg),
    var(--theme-bg-2)
  );
  color: var(--theme-text);
}

/* BOTTOM THEME AREA */
.theme-bottom {
  width: 100%;
  background: linear-gradient(
    135deg,
    var(--theme-bg-2),
    var(--theme-bg)
  );
  color: var(--theme-text);
}

/* BODY RETAINS ITS NORMAL BACKGROUND */
body {
  background: inherit;
}

</style>


