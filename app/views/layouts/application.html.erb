<!-- =========================================================
       NIACLOUD GLOBAL THEME
  ========================================================== -->

  <style>




    html {
      scroll-behavior: smooth;
    }


    body {

      margin: 0;

      min-height: 100vh;

      font-family:
        "DM Sans",
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:
        radial-gradient(
          circle at 12% 4%,
          rgba(25,195,156,.12),
          transparent 25%
        ),
        radial-gradient(
          circle at 90% 15%,
          rgba(244,185,79,.10),
          transparent 22%
        ),
        var(--nc-ink);

      color: var(--nc-text);

      overflow-x: hidden;
    }


    body::before {

      content: "";

      position: fixed;

      inset: 0;

      z-index: -10;

      pointer-events: none;

      background:
        radial-gradient(
          ellipse at 72% 45%,
          rgba(25,195,156,.045),
          transparent 34%
        ),
        radial-gradient(
          ellipse at 35% 0%,
          rgba(244,185,79,.035),
          transparent 30%
        );
    }


    a {
      text-decoration: none;
    }


    img {
      max-width: 100%;
    }


    button,
    input,
    textarea,
    select {
      font-family: inherit;
    }


    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {

      font-family:
        "Manrope",
        sans-serif;

      letter-spacing: -.035em;
    }


    .mono {

      font-family:
        "Space Mono",
        monospace;
    }


    /* =========================================================
       GLOBAL CONTAINER
    ========================================================== */

    .container,
    .container-fluid {

      position: relative;
    }


    


    /* =========================================================
       NIACLOUD TOP BAR
    ========================================================== */

    .nc-topbar {

      min-height: 68px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      padding: 12px 20px;

      background:
        rgba(6,17,22,.78);

      border-bottom:
        1px solid var(--nc-line);

      backdrop-filter:
        blur(20px);

      -webkit-backdrop-filter:
        blur(20px);

      position: sticky;

      top: 0;

      z-index: 1000;
    }


    .nc-brand {

      display: flex;

      align-items: center;

      gap: 11px;

      color: #fff;

      font:
        800 19px "Manrope",
        sans-serif;
    }


    .nc-brand:hover {
      color: #fff;
    }


    .nc-brand-dot {

      width: 12px;
      height: 12px;

      border-radius: 50%;

      background:
        var(--nc-gold);

      box-shadow:
        0 0 0 6px
        rgba(244,185,79,.10),

        0 0 25px
        rgba(244,185,79,.35);
    }


    .nc-brand-muted {

      color: #7e959a;

      font-weight: 600;
    }


    .nc-topbar-right {

      display: flex;

      align-items: center;

      gap: 10px;
    }


    .nc-status {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      padding: 7px 10px;

      border-radius: 99px;

      border:
        1px solid
        rgba(25,195,156,.22);

      background:
        rgba(25,195,156,.06);

      color: var(--nc-mint);

      font:
        700 9px "Space Mono";
    }


    .nc-status::before {

      content: "";

      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: var(--nc-mint);

      box-shadow:
        0 0 10px
        rgba(25,195,156,.8);
    }


    
    /* =========================================================
       BUTTONS
    ========================================================== */

    .btn {

      border-radius:
        999px;

      font-weight:
        700;

      transition:
        all .22s ease;
    }


    .btn-primary {

      background:
        var(--nc-mint);

      border-color:
        var(--nc-mint);

      color:
        var(--nc-ink);
    }


    .btn-primary:hover {

      background:
        #24d3aa;

      border-color:
        #24d3aa;

      color:
        var(--nc-ink);

      transform:
        translateY(-2px);

      box-shadow:
        0 12px 25px
        rgba(25,195,156,.20);
    }


    .btn-warning {

      background:
        var(--nc-gold);

      border-color:
        var(--nc-gold);

      color:
        var(--nc-ink);
    }


    .btn-success {

      background:
        var(--nc-mint);

      border-color:
        var(--nc-mint);

      color:
        var(--nc-ink);
    }


    .btn-outline-light {

      border-color:
        rgba(255,255,255,.16);

      background:
        rgba(255,255,255,.04);

      color:
        #fff;
    }


    .btn-outline-light:hover {

      background:
        #fff;

      border-color:
        #fff;

      color:
        var(--nc-ink);
    }




    .form-control::placeholder {

      color:
        #71888d;
    }


    .form-control:focus,
    .form-select:focus {

      color:
        #fff !important;

      background:
        rgba(255,255,255,.065) !important;

      border-color:
        rgba(25,195,156,.55) !important;

      box-shadow:
        0 0 0 3px
        rgba(25,195,156,.10) !important;
    }




    /* =========================================================
       ALERTS
    ========================================================== */

    .alert {

      border-radius:
        15px;

      border:
        1px solid
        rgba(255,255,255,.08);
    }


    /* =========================================================
       NAV TABS
    ========================================================== */

    .nav-tabs {

      border-bottom:
        1px solid
        rgba(255,255,255,.09);
    }


    .nav-tabs .nav-link {

      color:
        #81999e;

      border:
        0;

      border-radius:
        10px 10px 0 0;
    }


    .nav-tabs .nav-link:hover {

      color:
        #fff;
    }


    .nav-tabs .nav-link.active {

      color:
        var(--nc-mint);

      background:
        rgba(25,195,156,.07);

      border-bottom:
        2px solid
        var(--nc-mint);
    }


    /* =========================================================
       DROPDOWNS
    ========================================================== */

    .dropdown-menu {

      border:
        1px solid
        rgba(255,255,255,.10);

      border-radius:
        16px;

      background:
        #0b2027;

      box-shadow:
        0 20px 60px
        rgba(0,0,0,.35);

      padding:
        2px;
    }


    .dropdown-item {

      color:
        #cbd9da;

      border-radius:
        10px;

      padding:
        9px 12px;
    }


    .dropdown-item:hover {

      color:
        #fff;

      background:
        rgba(25,195,156,.10);
    }


    /* =========================================================
       SCROLLBAR
    ========================================================== */

    ::-webkit-scrollbar {

      width:
        8px;

      height:
        8px;
    }


    ::-webkit-scrollbar-track {

      background:
        #061116;
    }


    ::-webkit-scrollbar-thumb {

      background:
        #23434b;

      border-radius:
        99px;
    }


    ::-webkit-scrollbar-thumb:hover {

      background:
        var(--nc-mint-dark);
    }


    /* =========================================================
       SCROLL BUTTON
    ========================================================== */

    .scroll-to-bottom {

      position:
        fixed;

      bottom:
        85px;

      right:
        20px;

      width:
        46px;

      height:
        46px;

      z-index:
        999;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border:
        1px solid
        rgba(255,255,255,.12);

      border-radius:
        50%;

      background:
        #0b252d !important;

      color:
        var(--nc-mint);

      box-shadow:
        0 10px 30px
        rgba(0,0,0,.30);

      transition:
        all .25s ease;
    }


    .scroll-to-bottom:hover {

      transform:
        translateY(-4px);

      background:
        var(--nc-mint) !important;

      color:
        var(--nc-ink);
    }


    .scroll-to-bottom i {

      font-size:
        20px;
    }


    .scroll-to-bottom img {

      width:
        20px;

      height:
        20px;
    }


    /* =========================================================
       MOBILE
    ========================================================== */

    @media (max-width: 768px) {

      .erp-shell {

        width:
          calc(100% - 14px);

        margin:
          7px auto;

        border-radius:
          18px;
      }


      .nc-topbar {

        min-height:
          60px;

        padding:
          10px 13px;
      }


      .nc-brand {

        font-size:
          16px;
      }


      .nc-brand-dot {

        width:
          10px;

        height:
          10px;
      }


      .nc-status {

        display:
          none;
      }


      .nc-main {

        padding:
          12px;
      }


      .card {

        border-radius:
          18px !important;
      }


      .scroll-to-bottom {

        right:
          12px;

        bottom:
          72px;

        width:
          42px;

        height:
          42px;
      }
    }


    /* =========================================================
       REDUCED MOTION
    ========================================================== */

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {

        scroll-behavior:
          auto !important;

        transition:
          none !important;

        animation:
          none !important;
      }
    }

  </style>