<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Fireside Workforce" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Icons -->
    <%= favicon_link_tag "p.png" %>

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
      }

      /* 🔷 NAVBAR */
      .navbar-custom {
        background: linear-gradient(135deg, #008080, #0d6efd);
      }

      .navbar-brand {
        font-weight: bold;
        color: #fff !important;
        font-size: 1.1rem;
      }

      .nav-link {
        color: #fff !important;
        font-size: 0.9rem;
        padding: 6px 10px !important;
        border-radius: 6px;
        transition: 0.2s ease;
      }

      .nav-link:hover {
        background: rgba(255,255,255,0.15);
      }

      .nav-icon {
        margin-right: 4px;
      }

      /* Active highlight */
      .nav-link.active {
        background: rgba(255,255,255,0.25);
      }

      /* Compact spacing */
      .navbar {
        padding-top: 6px;
        padding-bottom: 6px;
      }
    </style>
  </head>

  <body>

    <!-- 🔷 NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm">
      <div class="container-fluid">

        <!-- Brand -->
        <%= link_to root_path, class: "navbar-brand" do %>
          <i class="bi bi-fire me-1"></i> Momak
        <% end %>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menu -->
        <div class="collapse navbar-collapse" id="mainNavbar">

          <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

            <li class="nav-item">
              <%= link_to materials_path, class: "nav-link" do %>
                <i class="bi bi-box-seam nav-icon"></i> Materials
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to utilization_index_path, class: "nav-link" do %>
                <i class="bi bi-upload nav-icon"></i> Import
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to new_stocks_path, class: "nav-link" do %>
                <i class="bi bi-plus-square nav-icon"></i> Stock
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to issues_path, class: "nav-link" do %>
                <i class="bi bi-box-arrow-up-right nav-icon"></i> Issue
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to utilizes_path, class: "nav-link" do %>
                <i class="bi bi-graph-up nav-icon"></i> Utilization
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to repo_index_path, class: "nav-link" do %>
                <i class="bi bi-bar-chart nav-icon"></i> Reports
              <% end %>
            </li>

          </ul>
        </div>

      </div>
    </nav>

    <!-- 🔥 MAIN CONTENT -->
    <div class="container mt-4">
      <%= yield %>
    </div>

  </body>
</html>