<style type="text/css">

/* The navigation menu */
.navbari {
  overflow: hidden;
  background-color: #333;
}

/* Navigation links */
.navbari a {
  float: left;
  font-size: 16px;
  color: white;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}

/* The subnavigation menu */
.subnav {
  float: left;
  overflow: hidden;
  margin-top:  0px;
}

/* Subnav button */
.subnav .subnavbtn {
  font-size: 16px;
  border: none;
  outline: none;
  color: white;
  padding: 12px 16px;
  background-color: inherit;
  font-family: inherit;
  margin: 0;
  top: 2px;
}

/* Add a red background color to navigation links on hover */
.navbari a:hover, .subnav:hover .subnavbtn {
  background-color: red;
}

/* Style the subnav content - positioned absolute */
.subnav-content {
  display: none;
  position: absolute;
  center: 0;
 background-color: #000000;
background-image: url("https://www.transparenttextures.com/patterns/skulls.png");
  color:  black;
  width: auto;
  z-index: 1;
  height: auto !important;
   overflow: visible !important;
 
}


.subnavi-content {
  display: none;
  position: absolute;
  center: 0;
 background-color: black !important;
background-image: url("https://www.transparenttextures.com/patterns/skulls.png");
  color:  black;
  width: auto;
  z-index: 1;
  height: auto !important;
   overflow: visible !important;
 
}


/* Style the subnav links */
.subnav-content a {
  float: left;
   overflow: visible !important;
  color: black;
  text-decoration: none;
}


.subnavi-content a {
  float: right;
  color: black;
  text-decoration: none;

}

/* Add a grey background color on hover */
.subnavi-content a:hover {
    
     overflow: visible !important;
  color: white;

}

/* Add a grey background color on hover */
.subnavi-content :hover {
   background-color: grey ;
   
  color: black;
}

.subnav-content :hover {
   background-color: grey ;
   
  color: black;
}


/* When you move the mouse over the subnav container, open the subnav content */
.subnav:hover .subnav-content {
  display: block;
}


.subnav:hover .subnavi-content {
  display: block;
}




.circle-image {
  border-radius: 50%;

}

 
</style>







