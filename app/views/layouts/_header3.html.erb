<script type="text/javascript">

$(document).ready(function() {
  $('.subnavbtn').on('click', function() {
    var subnavContent = $(this).next('.subnav-content');
    if (!subnavContent.hasClass('initial-click')) {
      // First click, show the dropdown content
      subnavContent.addClass('initial-click').show();
    } else {
      // Subsequent clicks, toggle the dropdown content
      subnavContent.toggle();
    }
  });
});

</script>


