<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

  <title>NiaCloud | <%= controller_name.to_s.humanize %></title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- =========================================================
       FONTS
  ========================================================== -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

  <!-- =========================================================
       BOOTSTRAP
  ========================================================== -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  >

  <!-- =========================================================
       CHOSEN
  ========================================================== -->
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/chosen/1.8.7/chosen.min.css"
    rel="stylesheet"
  >

  <!-- =========================================================
       SELECT2
  ========================================================== -->
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css"
    rel="stylesheet"
  >

  <!-- =========================================================
       APPLICATION
  ========================================================== -->
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

  <!-- =========================================================
       JAVASCRIPT
  ========================================================== -->
  <%= javascript_importmap_tags %>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/chosen/1.8.7/chosen.jquery.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

  <script src="https://unpkg.com/quagga@0.12.1/dist/quagga.min.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0/dist/chartjs-plugin-datalabels.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.22.1/moment.min.js"></script>


<style>

/* ============================================================
   NiaCloud COMMAND CENTRE
   PREMIUM APPLICATION SHELL
============================================================ */

:root{

  --nc-ink:#061116;
  --nc-ink2:#081a20;
  --nc-panel:#0b2027;
  --nc-panel2:#102c34;

  --nc-white:#ffffff;
  --nc-text:#dce8e8;
  --nc-muted:#81999e;
  --nc-muted2:#60777c;

  --nc-mint:#19c39c;
  --nc-mint-dark:#0d8d76;

  --nc-gold:#f4b94f;

  --nc-line:rgba(255,255,255,.09);
  --nc-line2:rgba(255,255,255,.06);

  --nc-sidebar:250px;

  --nc-shadow:
    0 25px 70px rgba(0,0,0,.32);

  --nc-radius:18px;
}


/* ============================================================
   GLOBAL
============================================================ */

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{

  margin:0 !important;
  padding:0 !important;

  min-height:100vh;

  font-family:"DM Sans",sans-serif;

  color:var(--nc-text);

  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(25,195,156,.08),
      transparent 28%
    ),
    radial-gradient(
      circle at 90% 10%,
      rgba(244,185,79,.06),
      transparent 25%
    ),
    var(--nc-ink) !important;

  overflow-x:hidden;
}


/* ============================================================
   APPLICATION SHELL
============================================================ */

.nc-shell{
  min-height:100vh;
}


/* ============================================================
   SIDEBAR
============================================================ */

.sidebar{

  position:fixed !important;

  left:0 !important;
  top:0 !important;
  bottom:0 !important;

width: calc(100% - var(--nc-sidebar)) !important;
  height:100vh !important;

  background:
    linear-gradient(
      180deg,
      #071920 0%,
      #061116 100%
    ) !important;

  border-right:1px solid var(--nc-line);

  overflow-y:auto;
  overflow-x:hidden;

  z-index:2147483646 !important;

  padding:0 !important;

  transform:translateX(0);

  transition:
    transform .3s ease,
    width .3s ease;

  scrollbar-width:thin;
  scrollbar-color:#29464d transparent;
}

:root {
  --nc-sidebar: 250px;
}

.sidebar {
  position: fixed !important;
  left: 0 !important;
  top: 0 !important;
  bottom: 0 !important;

  width: var(--nc-sidebar) !important;
  height: 100vh !important;

  margin: 0 !important;
  padding: 0 !important;

  box-sizing: border-box !important;

  z-index: 2147483646 !important;
}


:root {
  --nc-sidebar: 250px;
}

/* SIDEBAR */
.sidebar {
  position: fixed !important;

  left: 0 !important;
  top: 0 !important;
  bottom: 0 !important;

  width: var(--nc-sidebar) !important;
  height: 100vh !important;

  margin: 0 !important;
  box-sizing: border-box !important;

  z-index: 99999 !important;
}

/* ============================================================
   REMOVE LEFT GAP — CONTENT TOUCHES SIDEBAR
============================================================ */

.main {
  margin-left: var(--nc-sidebar) !important;
  margin-right: 0 !important;

  width: calc(100% - var(--nc-sidebar)) !important;
  max-width: calc(100% - var(--nc-sidebar)) !important;

  padding-left: 0 !important;
  padding-right: 0 !important;

  overflow-x: hidden !important;
}


/* Remove Bootstrap/container left spacing */
.main > .container,
.main > .container-fluid,
.main .container,
.main .container-fluid {
  margin-left: 0 !important;
  margin-right: 0 !important;

  padding-left: 0 !important;
  padding-right: 0 !important;

  width: 100% !important;
  max-width: none !important;
}


/* Remove row spacing */
.main .row {
  margin-left: 0 !important;
  margin-right: 0 !important;

  --bs-gutter-x: 0 !important;
}


/* Remove first-level content left spacing */
.main > * {
  margin-left: 0 !important;
}


/* Prevent Bootstrap columns from creating side gaps */
.main .row > [class*="col-"] {
  padding-left: 0 !important;
}


/* ============================================================
   IF YOUR PAGE CONTENT HAS A WRAPPER
============================================================ */

.main .content,
.main .page-content,
.main .content-wrapper,
.main .page-wrapper,
.main .dashboard-content {
  margin-left: 0 !important;
  padding-left: 0 !important;
}


/* sidebar scrollbar */

.sidebar::-webkit-scrollbar{
  width:5px;
}

.sidebar::-webkit-scrollbar-track{
  background:transparent;
}

.sidebar::-webkit-scrollbar-thumb{
  background:#29464d;
  border-radius:10px;
}


/* ============================================================
   SIDEBAR BRAND
============================================================ */

.nc-brand{

  height:76px;

  padding:0 20px;

  display:flex;
  align-items:center;
  gap:11px;

  border-bottom:1px solid var(--nc-line);

  position:sticky;
  top:0;

  background:rgba(6,17,22,.94);

  backdrop-filter:blur(20px);

  z-index:10;
}


.nc-brand-mark{

  width:34px;
  height:34px;

  border-radius:11px;

  display:grid;
  place-items:center;

  background:
    linear-gradient(
      135deg,
      var(--nc-gold),
      #e69e26
    );

  color:var(--nc-ink);

  box-shadow:
    0 0 0 5px rgba(244,185,79,.08),
    0 8px 25px rgba(244,185,79,.15);
}


.nc-brand-text{

  line-height:1.05;
}


.nc-brand-name{

  font-family:"Manrope",sans-serif;

  font-weight:800;

  font-size:16px;

  color:#fff;

  letter-spacing:-.03em;
}


.nc-brand-sub{

  display:block;

  margin-top:4px;

  color:#6f898e;

  font-family:"Space Mono",monospace;

  font-size:7px;

  letter-spacing:.12em;

  text-transform:uppercase;
}


/* ============================================================
   STATUS
============================================================ */

.nc-status{

  margin:17px 15px 10px;

  padding:10px 12px;

  border-radius:12px;

  background:rgba(25,195,156,.055);

  border:1px solid rgba(25,195,156,.12);

  display:flex;

  align-items:center;

  gap:9px;
}


.nc-status-dot{

  width:7px;
  height:7px;

  border-radius:50%;

  background:var(--nc-mint);

  box-shadow:
    0 0 0 4px rgba(25,195,156,.08),
    0 0 14px rgba(25,195,156,.45);
}


.nc-status strong{

  font-size:10px;

  color:#dceceb;
}


.nc-status span{

  display:block;

  color:#668086;

  font-family:"Space Mono",monospace;

  font-size:7px;

  margin-top:2px;
}


/* ============================================================
   NAV SECTION
============================================================ */

.nc-section-label{

  padding:16px 18px 7px;

  color:#4f696f;

  font-family:"Space Mono",monospace;

  font-size:8px;

  letter-spacing:.16em;

  text-transform:uppercase;
}


/* ============================================================
   NAV LINKS
============================================================ */

.sidebar .menu-button,
.sidebar .nav-link{

  width:calc(100% - 20px);

  min-height:46px;

  margin:3px 10px !important;

  padding:10px 12px !important;

  border:1px solid transparent !important;

  border-radius:12px !important;

  background:transparent !important;

  color:#91a7ab !important;

  text-decoration:none !important;

  display:flex !important;

  align-items:center !important;

  gap:11px;

  justify-content:flex-start !important;

  box-shadow:none !important;

  transition:
    background .2s ease,
    color .2s ease,
    border-color .2s ease,
    transform .2s ease;
}


.sidebar .menu-button:hover,
.sidebar .nav-link:hover{

  color:#fff !important;

  background:
    rgba(255,255,255,.045) !important;

  border-color:
    rgba(255,255,255,.06) !important;

  transform:translateX(2px);
}


/* ============================================================
   ICONS
============================================================ */

.sidebar .menu-button i,
.sidebar .nav-link i{

  width:32px;
  height:32px;

  min-width:32px;

  display:grid;
  place-items:center;

  border-radius:9px;

  background:#0d2830;

  color:#789399;

  font-size:15px;

  transition:.2s ease;
}


.sidebar .menu-button:hover i,
.sidebar .nav-link:hover i{

  color:var(--nc-mint);

  background:
    rgba(25,195,156,.10);
}


/* ============================================================
   TEXT
============================================================ */

.sidebar .menu-button strong,
.sidebar .nav-link strong{

  color:inherit !important;

  font-size:12px !important;

  font-weight:600 !important;

  letter-spacing:-.01em;
}


/* ============================================================
   ACTIVE STYLE
   Rails can add .active to current link
============================================================ */

.sidebar .menu-button.active,
.sidebar .nav-link.active{

  color:#fff !important;

  background:
    linear-gradient(
      90deg,
      rgba(25,195,156,.14),
      rgba(25,195,156,.035)
    ) !important;

  border-color:
    rgba(25,195,156,.16) !important;

  position:relative;
}


.sidebar .menu-button.active:before,
.sidebar .nav-link.active:before{

  content:"";

  position:absolute;

  left:-1px;
  top:9px;
  bottom:9px;

  width:3px;

  border-radius:0 4px 4px 0;

  background:var(--nc-mint);

  box-shadow:
    0 0 12px rgba(25,195,156,.5);
}


.sidebar .menu-button.active i,
.sidebar .nav-link.active i{

  color:var(--nc-mint);

  background:
    rgba(25,195,156,.12);
}


/* ============================================================
   SPECIAL WHATSAPP
============================================================ */

.sidebar #whatsapp_ai_leads i.bi-whatsapp,
.sidebar #whatsapp i.bi-whatsapp{

  color:#20d98b;
}


/* ============================================================
   BADGE
============================================================ */

.nc-nav-badge{

  margin-left:auto;

  min-width:20px;
  height:20px;

  padding:0 6px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:999px;

  background:rgba(244,185,79,.12);

  border:1px solid rgba(244,185,79,.18);

  color:var(--nc-gold);

  font-family:"Space Mono",monospace;

  font-size:7px;
}


/* ============================================================
   DIVIDER
============================================================ */

.nc-divider{

  height:1px;

  margin:15px 18px;

  background:var(--nc-line);
}


/* ============================================================
   BOTTOM NIA CLOUD LINK
============================================================ */

.nc-external{

  margin:15px 10px 20px !important;

  background:
    linear-gradient(
      135deg,
      rgba(25,195,156,.10),
      rgba(244,185,79,.05)
    ) !important;

  border:
    1px solid rgba(25,195,156,.13) !important;
}


.nc-external i{

  color:var(--nc-gold) !important;

  background:
    rgba(244,185,79,.10) !important;
}


/* ============================================================
   MAIN
============================================================ */




/* ============================================================
   TOP APPLICATION BAR
============================================================ */

.nc-topbar{

  position:sticky;

  top:0;

  z-index:1000;

  height:72px;

  display:flex;

  align-items:center;

  gap:15px;

  padding:0 25px;

  background:
    rgba(6,17,22,.84);

  border-bottom:
    1px solid var(--nc-line);

  backdrop-filter:blur(20px);
}


/* ============================================================
   MOBILE MENU
============================================================ */

.toggle-btn{

  position:fixed !important;

  left:15px !important;
  top:15px !important;

  width:43px !important;
  height:43px !important;

  padding:0 !important;

  display:none;

  align-items:center;
  justify-content:center;

  border:
    1px solid rgba(255,255,255,.12) !important;

  border-radius:12px !important;

  background:
    rgba(8,26,32,.95) !important;

  color:#fff !important;

  z-index:2147483647 !important;

  box-shadow:
    0 12px 30px rgba(0,0,0,.30);
}


/* ============================================================
   TOPBAR MOBILE BRAND
============================================================ */

.nc-mobile-title{

  display:none;

  align-items:center;

  gap:9px;

  color:#fff;

  font-family:"Manrope",sans-serif;

  font-weight:800;

  font-size:15px;
}


.nc-mobile-title .dot{

  width:10px;
  height:10px;

  border-radius:50%;

  background:var(--nc-gold);

  box-shadow:
    0 0 0 5px rgba(244,185,79,.08);
}


/* ============================================================
   COMMAND SEARCH
============================================================ */

.nc-command{

  height:42px;

  min-width:240px;

  max-width:430px;

  flex:1;

  display:flex;

  align-items:center;

  gap:10px;

  padding:0 13px;

  border:
    1px solid var(--nc-line);

  border-radius:12px;

  background:
    rgba(255,255,255,.035);

  color:#667f84;
}


.nc-command i{

  color:var(--nc-mint);

  font-size:14px;
}


.nc-command span{

  font-size:10px;

  color:#71898e;
}


.nc-command kbd{

  margin-left:auto;

  padding:4px 7px;

  border-radius:6px;

  background:#102a31;

  border:1px solid var(--nc-line);

  color:#71898e;

  font-family:"Space Mono",monospace;

  font-size:7px;
}


/* ============================================================
   TOPBAR ACTIONS
============================================================ */

.nc-top-actions{

  margin-left:auto;

  display:flex;

  align-items:center;

  gap:8px;
}


.nc-top-action{

  width:40px;
  height:40px;

  border:
    1px solid var(--nc-line);

  border-radius:11px;

  display:grid;
  place-items:center;

  color:#8ba1a5;

  background:
    rgba(255,255,255,.025);

  transition:.2s ease;
}


.nc-top-action:hover{

  color:#fff;

  border-color:
    rgba(25,195,156,.25);

  background:
    rgba(25,195,156,.07);
}


.nc-top-action.whatsapp{

  color:#20d98b;
}


/* ============================================================
   USER AREA
============================================================ */

.nc-user{

  display:flex;

  align-items:center;

  gap:9px;

  padding-left:9px;

  border-left:1px solid var(--nc-line);
}


.nc-avatar{

  width:34px;
  height:34px;

  display:grid;
  place-items:center;

  border-radius:10px;

  background:
    linear-gradient(
      135deg,
      #0d6b5b,
      #123e46
    );

  color:#fff;

  font-size:13px;
}


.nc-user-info strong{

  display:block;

  color:#fff;

  font-size:10px;
}


.nc-user-info span{

  display:block;

  color:#637b80;

  font-family:"Space Mono",monospace;

  font-size:7px;

  margin-top:2px;
}


/* ============================================================
   MOBILE DRAWER OVERLAY
============================================================ */

.nc-overlay{

  position:fixed;

  inset:0;

  background:
    rgba(0,0,0,.60);

  backdrop-filter:blur(3px);

  z-index:2147483645;

  display:none;
}


.nc-overlay.show{
  display:block;
}


/* ============================================================
   DROPDOWNS
============================================================ */

.dropdown-menu{

  background:#0b2027 !important;

  border:
    1px solid var(--nc-line) !important;

  border-radius:13px !important;

  box-shadow:
    0 20px 50px rgba(0,0,0,.40) !important;

  padding:7px !important;

  max-height:300px;

  overflow-y:auto;

  text-align:left;
}


.dropdown-item{

  width:auto !important;

  color:#9db1b5 !important;

  border-radius:8px;

  padding:9px 12px !important;

  font-size:12px;

  display:flex;

  align-items:center;

  justify-content:flex-start;

  gap:8px;
}


.dropdown-item:hover{

  color:#fff !important;

  background:
    rgba(25,195,156,.09) !important;
}


/* ============================================================
   CONTENT COMPATIBILITY
============================================================ */


/* ============================================================
   OLD MENU BUTTON COMPATIBILITY
============================================================ */

.menu-button{

  font-family:"DM Sans",sans-serif !important;

  font-size:12px !important;

  border-radius:12px !important;
}


/* ============================================================
   PROCESSING STATE
============================================================ */

.menu-button.disabled{

  pointer-events:none;

  opacity:.55;

  transform:none !important;
}


.menu-spinner{

  display:inline-block;

  width:14px;
  height:14px;

  margin-left:auto;

  border:
    2px solid rgba(255,255,255,.20);

  border-top-color:
    var(--nc-mint);

  border-radius:50%;

  animation:
    nc-spin .7s linear infinite;
}


@keyframes nc-spin{

  from{
    transform:rotate(0deg);
  }

  to{
    transform:rotate(360deg);
  }

}


/* ============================================================
   RESPONSIVE
============================================================ */

@media(max-width:991px){

  .sidebar{

    width:260px !important;

    transform:translateX(-100%);

    box-shadow:
      25px 0 70px rgba(0,0,0,.40);
  }


  .sidebar.mobile-open{

    transform:translateX(0);
  }




  .toggle-btn{

    display:flex !important;
  }


  .nc-topbar{

    padding-left:75px;

    height:68px;
  }


  .nc-mobile-title{

    display:flex;
  }


  .nc-command{

    display:none;
  }


  .nc-user-info{

    display:none;
  }


  .nc-user{

    border-left:0;

    padding-left:0;
  }

}


@media(max-width:576px){

  .nc-topbar{

    padding-right:12px;
    padding-left:70px;

    gap:8px;
  }


  .nc-mobile-title{

    font-size:14px;

    margin-right:auto;
  }


  .nc-top-action{

    width:37px;
    height:37px;
  }


  .nc-top-action.hide-mobile{

    display:none;
  }


  .nc-user{

    display:none;
  }


  .sidebar{

    width:285px !important;
  }

}





/* ============================================================
   ACCESSIBILITY
============================================================ */

button,
a{

  -webkit-tap-highlight-color:transparent;
}


button:focus-visible,
a:focus-visible{

  outline:
    2px solid var(--nc-mint);

  outline-offset:3px;
}


/* ============================================================
   CHAT COMPATIBILITY
============================================================ */

.fixed-chat-header{

  z-index:99999 !important;
}


.chat-input{

  z-index:99998 !important;
}


.chat-area{

  position:relative;

  z-index:1 !important;
}



</style>

</head>


<body>

<div class="nc-shell">


  <!-- ========================================================
       MOBILE OVERLAY
  ========================================================= -->

  <div class="nc-overlay" id="ncOverlay"></div>


  <!-- ========================================================
       MOBILE MENU BUTTON
  ========================================================= -->

  <button
    class="toggle-btn"
    id="ncToggle"
    type="button"
    aria-label="Open navigation"
    aria-expanded="false"
  >
    <i class="bi bi-list"></i>
  </button>


  <!-- ========================================================
       SIDEBAR
  ========================================================= -->

  <aside class="sidebar" id="ncSidebar">


    <!-- BRAND -->

  <%= link_to "/",
    class: "nc-brand text-decoration-none",
    aria: { label: "NiaCloud Home" } do %>

  <div class="nc-brand-mark">
    <i class="bi bi-cloud-fill"></i>
  </div>

  <div class="nc-brand-text">

    <div class="nc-brand-name">
      NiaCloud
    </div>

    <span class="nc-brand-sub">
      Technologies
    </span>

  </div>

<% end %>

<style>
  .nc-brand {
  color: inherit !important;
  text-decoration: none !important;
  cursor: pointer;

  transition:
    background .2s ease,
    opacity .2s ease;
}

.nc-brand:hover {
  color: inherit !important;
  text-decoration: none !important;
  background: rgba(255,255,255,.02);
}

.nc-brand:active {
  opacity: .85;
}
</style>


    <!-- SYSTEM STATUS -->

    <div class="nc-status">

      <span class="nc-status-dot"></span>

      <div>
        <strong>Command Centre</strong>
        <span>ALL SYSTEMS OPERATIONAL</span>
      </div>

    </div>


    <!-- ======================================================
         MAIN
    ======================================================= -->




    <!-- HOME -->

    <%= link_to "/",
        class: "nav-link menu-button",
        data: {
          nc_nav: true
        } do %>

      <i class="bi bi-grid-fill"></i>

      <strong>Overview</strong>

    <% end %>


    <% if user_signed_in? %>


      <!-- ==================================================
