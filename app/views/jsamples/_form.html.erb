<%= render "layouts/header" %>
<script src="https://upload-widget.cloudinary.com/latest/global/all.js"></script>

<<div class="container my-5">
  <div class="card shadow border-0 rounded-4 main-card">

    <div class="card-header text-white text-center py-3 header-gradient">
      <h4 class="fw-bold mb-0">
        <i class="bi bi-cloud-arrow-up-fill fs-4 me-2"></i> Upload New Jsample
      </h4>
    </div>
  <center>
    <div class="card-body p-4">
<div class="login">

      <%= form_with(model: @jsample, local: true, html: { class: "needs-validation", multipart: true }) do |form| %>

        <% if @jsample.errors.any? %>
          <div class="alert alert-danger rounded-3 shadow-sm">
            <h5><i class="bi bi-x-octagon-fill me-1"></i> Validation Errors</h5>
            <ul>
              <% @jsample.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
</div>
        <!-- SECTION: DETAILS -->
        <h5 class="section-title mt-3"><i class="bi bi-pencil-square me-2"></i> Sample Details</h5>
        <hr class="mt-1">

        <div class="row g-4 mb-4">
          <div class="col-md-4">
            <label class="form-label">
              Bale Name
            </label>
            <%= form.text_field :bale_name, class: "form-control modern-input", placeholder: "Enter bale name…" %>
            <small class="text-muted">Name of the bale you're sampling</small>
          </div>

          <div class="col-md-4">
            <label class="form-label">Pieces Range</label>
            <%= form.text_field :pieces_range, class: "form-control modern-input", placeholder: "e.g. 20–30 pcs" %>
            <small class="text-muted">Approximate number of pieces inside</small>
          </div>

          <div class="col-md-4">
            <label class="form-label">Price Range</label>
            <%= form.text_field :price_range, class: "form-control modern-input", placeholder: "e.g. KES 5,000 – 10,000" %>
            <small class="text-muted">Expected buying / selling range</small>
          </div>
        </div>

        <!-- SECTION: VIDEO -->
        <h5 class="section-title"><i class="bi bi-camera-reels-fill me-2"></i> Video Upload</h5>
        <hr class="mt-1">

        <div class="upload-box text-center mb-3" id="upload_video_btn">
          <i class="bi bi-cloud-arrow-up-fill upload-icon"></i>
          <p class="fw-semibold">Click to Upload Video</p>
          <p class="text-muted small">Max 200 MB — MP4 recommended</p>
        </div>

        <%= form.hidden_field :video_public_id, id: "video_public_id" %>

        <p id="upload_status" class="text-success text-center"></p>
        <p id="video_url" class="text-info text-center small"></p>

      <div class="text-center mb-4">
  <video id="video_preview"
         controls
         class="rounded shadow-sm d-none"
         style="width:200px; max-width:100%; height:auto;">
  </video>
</div>

        <!-- SUBMIT -->
        <div class="text-center mt-4">
          <%= form.submit "Save Sample", class: "btn btn-lg form-submit-btn px-5", id: "submit_btn", disabled: true %>
        </div>

      <% end %>

      <div class="text-center mt-4">
        <%= link_to jsamples_path, class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-arrow-left"></i> Back to Jsamples
        <% end %>
      </div>

    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const uploadBtn = document.getElementById("upload_video_btn");
  const hiddenField = document.getElementById("video_public_id");
  const statusText = document.getElementById("upload_status");
  const videoUrlText = document.getElementById("video_url");
  const submitBtn = document.getElementById("submit_btn");
  const preview = document.getElementById("video_preview");

  // Optional elements (exist only in old layout)
  const btnText = document.getElementById("upload_btn_text");
  const spinner = document.getElementById("upload_spinner");

  if (!uploadBtn) return; // Safety: no button found

  uploadBtn.addEventListener("click", function () {

    // If buttons exist, update UI
    if (btnText) btnText.innerText = "Uploading...";
    if (spinner) spinner.classList.remove("d-none");

    submitBtn.disabled = true;

    cloudinary.openUploadWidget({
      cloudName: "fireside",
      uploadPreset: "jsamples_unsigned",
      sources: ["local", "camera"],
      multiple: false,
      resourceType: "video",
      maxFileSize: 200_000_000 // 200MB
    }, (error, result) => {

      if (!error && result && result.event === "success") {
        const info = result.info;

        hiddenField.value = info.public_id;
        statusText.innerText = `Uploaded ✔ ${info.original_filename}`;
        videoUrlText.innerHTML = `<strong>Video URL:</strong> <a href="${info.secure_url}" target="_blank">${info.secure_url}</a>`;

        preview.src = info.secure_url;
        preview.classList.remove("d-none");

        submitBtn.disabled = false;

        // Reset button (if exists)
        if (btnText) btnText.innerText = "Upload Video";
        if (spinner) spinner.classList.add("d-none");
      }

      if (error) {
        console.error(error);
        statusText.innerText = "Upload failed. Try again.";

        // Reset button
        if (btnText) btnText.innerText = "Upload Video";
        if (spinner) spinner.classList.add("d-none");
      }
    });
  });
});
</script>

<style>

  .main-card {
  border-radius: 16px;
  overflow: hidden;
}

.header-gradient {
  background: linear-gradient(135deg, #1c2e4a, #ff7f50);
}

/* SECTION TITLES */
.section-title {
  font-weight: 600;
  color: #444;
}

/* INPUTS */
.modern-input {
  border-radius: 10px;
  padding: 10px 14px;
  transition: 0.2s;
}

.modern-input:focus {
  border-color: #ff7f50;
  box-shadow: 0 0 0 3px rgba(255, 127, 80, .25);
}

/* UPLOAD BOX */
.upload-box {
  border: 2px dashed #bbb;
  border-radius: 12px;
  padding: 40px 20px;
  cursor: pointer;
  transition: 0.3s ease;
  background: #fafafa;
}

.upload-box:hover {
  background: #eef7ff;
  border-color: #0d6efd;
  transform: translateY(-3px);
}

.upload-icon {
  font-size: 50px;
  color: #0d6efd;
}

/* SUBMIT BUTTON */
.form-submit-btn {
  background: linear-gradient(135deg, #1b884f, #28a745);
  color: white;
  border: none;
  border-radius: 50px;
  transition: .2s ease-in-out;
}

.form-submit-btn:hover {
  transform: scale(1.04);
  box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .form-submit-btn,
  .upload-box {
    width: 100%;
  }
}
.custom-btn { font-size: 14px; padding: 8px 20px; border-radius: 6px; }
.btn-success { min-width: 150px; }
.bg-gradient-primary { background: linear-gradient(135deg, #0f2d37, #ff7f50); }
.card { border-radius: 1rem; overflow: hidden; }
.form-label { color: #333; }
.btn-success:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.15); }
@media (max-width: 768px) { .card-body { padding: 1.5rem; } .btn { width: 100%; } }

/* CARD */
.smart-card {
  border-radius: 14px;
  overflow: hidden;
}

.header-gradient {
  background: linear-gradient(135deg, #1b2a49, #ff8450);
}

/* INPUTS */
.modern-input {
  border-radius: 8px;
  padding: 10px 14px;
  transition: all .2s ease;
}

.modern-input:focus {
  border-color: #ff8450;
  box-shadow: 0 0 0 3px rgba(255,132,80,0.25);
}

/* UPLOAD BUTTON */
.upload-btn {
  background: #0d6efd;
  color: white;
  border-radius: 8px;
  font-size: 15px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: .2s ease;
}

.upload-btn:hover {
  background: #084298;
  transform: translateY(-2px);
}

/* SUBMIT BUTTON */
.submit-btn {
  border-radius: 10px;
  letter-spacing: 0.5px;
  transition: .2s ease;
}

.submit-btn:hover {
  box-shadow: 0 6px 15px rgba(0,0,0,0.15);
  transform: translateY(-2px);
}

/* VIDEO PREVIEW */
.video-preview-wrapper video {
  max-width: 100%;
  height: auto;
}

/* MOBILE */
@media (max-width: 768px) {
  .upload-btn, .submit-btn {
    width: 100%;
  }
}
</style>
