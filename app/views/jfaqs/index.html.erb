<%= render "layouts/header" %>

<div class="faq-page">

  <!-- PREMIUM BACKGROUND -->
  <div class="faq-orb faq-orb-1"></div>
  <div class="faq-orb faq-orb-2"></div>
  <div class="faq-grid-bg"></div>

  <%= render 'jmcustomers/submenu' %>

  <!-- HERO -->
  <section class="faq-hero">

    <div class="faq-hero-inner">

      <div class="faq-pill">
        <i class="bi bi-patch-question-fill"></i>
        FAQ Center
      </div>

      <h1>Support Center</h1>

      <p>
        Find answers about mtumba bales, branches, payments,
        transport, delivery & wholesale support instantly.
      </p>

      <div class="faq-actions">
        <%= link_to new_jfaq_path,
            class: "btn-primary-premium" do %>
          <i class="bi bi-plus-circle-fill"></i>
          New FAQ
        <% end %>
      </div>

    </div>

  </section>

  <!-- CONTENT -->
  <div class="faq-container">

    <!-- SEARCH -->
    <div class="faq-search">

      <%= form_with url: jfaqs_path, method: :get, local: true do |f| %>

        <div class="search-box">

          <div class="search-icon">
            <i class="bi bi-search"></i>
          </div>

          <%= f.text_field :q,
                value: params[:q],
                placeholder: "Search payments, delivery, branches, bales...",
                class: "search-input" %>

          <% if params[:q].present? %>
            <%= link_to jfaqs_path,
                class: "search-clear",
                title: "Clear search" do %>
              <i class="bi bi-x-lg"></i>
            <% end %>
          <% end %>

          <%= button_tag type: "submit",
              class: "search-btn" do %>
            <i class="bi bi-search"></i>
            Search
          <% end %>

        </div>

      <% end %>

    </div>

    <!-- RESULTS -->
    <% if @jfaqs.any? %>

      <div class="faq-results-bar">
        <div class="results-count">
          <i class="bi bi-collection-fill"></i>
          <span>
            <strong><%= @jfaqs.count %></strong>
            FAQ<%= "s" unless @jfaqs.count == 1 %> found
          </span>
        </div>
      </div>

      <div class="faq-grid">

        <% @jfaqs.each do |jfaq| %>

          <div class="faq-card">

            <div class="faq-card-top">

              <span class="faq-badge">
                <i class="bi bi-bookmark-fill"></i>
                <%= jfaq.category.presence || "General" %>
              </span>

            </div>

            <div class="faq-card-body">

              <h3 class="faq-question">
                <%= truncate(jfaq.question, length: 85) %>
              </h3>

              <p class="faq-answer">
                <%= truncate(jfaq.answer, length: 150) %>
              </p>

            </div>

            <div class="faq-bottom">

              <%= link_to jfaq,
                  class: "btn-soft" do %>
                <i class="bi bi-eye-fill"></i>
                View
              <% end %>

              <%= link_to edit_jfaq_path(jfaq),
                  class: "btn-ghost" do %>
                <i class="bi bi-pencil-square"></i>
                Edit
              <% end %>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <!-- EMPTY -->
      <div class="empty-state">

        <div class="empty-box">

          <div class="empty-icon">
            <i class="bi bi-chat-square-text-fill"></i>
          </div>

          <h2>No FAQs Available</h2>

          <p>
            Create your first Janomax FAQ to help customers
            understand payments, branches, bales & transport.
          </p>

          <%= link_to new_jfaq_path,
              class: "btn-primary-premium" do %>
            <i class="bi bi-plus-circle-fill"></i>
            Add FAQ
          <% end %>

        </div>

      </div>

    <% end %>

  </div>
</div>

<style>
:root{
  --bg-primary:#020617;
  --bg-secondary:#0f172a;

  --card-bg:rgba(15,23,42,0.78);
  --card-border:rgba(255,255,255,0.08);

  --text-primary:#ffffff;
  --text-secondary:#cbd5e1;
  --text-muted:#94a3b8;

  --primary:#38bdf8;
  --primary-dark:#2563eb;

  --success:#22c55e;
  --danger:#ef4444;

  --radius:24px;
  --shadow:0 25px 60px rgba(0,0,0,0.45);
}

/* ===================================
   PAGE
=================================== */
.faq-page{
  position:relative;
  overflow:hidden;
  min-height:100vh;
  background:
    radial-gradient(circle at top left,#172554 0%,transparent 30%),
    radial-gradient(circle at bottom right,#0f172a 0%,transparent 35%),
    linear-gradient(180deg,#020617 0%,#0b1120 100%);
  color:var(--text-secondary);
  font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
}

/* ===================================
   BACKGROUND EFFECTS
=================================== */
.faq-orb{
  position:absolute;
  border-radius:50%;
  filter:blur(90px);
  opacity:.16;
  pointer-events:none;
}

.faq-orb-1{
  width:320px;
  height:320px;
  background:#0ea5e9;
  top:-120px;
  left:-120px;
}

.faq-orb-2{
  width:280px;
  height:280px;
  background:#2563eb;
  bottom:-100px;
  right:-90px;
}

.faq-grid-bg{
  position:absolute;
  inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
  background-size:40px 40px;
  mask-image:linear-gradient(to bottom, rgba(0,0,0,.45), transparent);
  pointer-events:none;
}

/* ===================================
   HERO
=================================== */
.faq-hero{
  position:relative;
  z-index:2;
  padding:90px 20px 65px;
  text-align:center;
}

.faq-pill{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:10px 18px;
  border-radius:999px;
  background:rgba(56,189,248,.12);
  border:1px solid rgba(56,189,248,.2);
  color:#7dd3fc;
  font-size:.82rem;
  font-weight:700;
  margin-bottom:22px;
  backdrop-filter:blur(10px);
}

.faq-hero-inner h1{
  font-size:clamp(2.2rem,5vw,4rem);
  font-weight:900;
  line-height:1.1;
  letter-spacing:-1.5px;
  color:#fff;
  margin-bottom:18px;
  text-shadow:0 10px 30px rgba(0,0,0,.35);
}

.faq-hero-inner p{
  max-width:760px;
  margin:auto;
  color:var(--text-muted);
  font-size:1.08rem;
  line-height:1.8;
}

/* ===================================
   HERO ACTIONS
=================================== */
.faq-actions{
  margin-top:28px;
}

.btn-primary-premium{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:14px 24px;
  border-radius:16px;
  background:linear-gradient(135deg,var(--primary),var(--primary-dark));
  color:#fff;
  text-decoration:none;
  font-weight:800;
  font-size:.95rem;
  transition:all .25s ease;
  box-shadow:0 15px 35px rgba(37,99,235,.35);
}

.btn-primary-premium:hover{
  transform:translateY(-2px);
  color:#fff;
  box-shadow:0 20px 45px rgba(37,99,235,.45);
}

/* ===================================
   CONTAINER
=================================== */
.faq-container{
  position:relative;
  z-index:2;
  max-width:1200px;
  margin:auto;
  padding:0 18px 90px;
}

/* ===================================
   SEARCH
=================================== */
.faq-search{
  display:flex;
  justify-content:center;
  margin-bottom:34px;
}

.faq-search form{
  width:100%;
  max-width:760px;
}

.search-box{
  display:flex;
  align-items:center;
  gap:10px;

  background:rgba(15,23,42,.75);
  backdrop-filter:blur(18px);

  border:1px solid rgba(255,255,255,.08);
  border-radius:20px;

  padding:8px;

  box-shadow:0 20px 45px rgba(0,0,0,.35);

  transition:all .25s ease;
}

.search-box:focus-within{
  border-color:rgba(56,189,248,.35);
  box-shadow:
    0 0 0 4px rgba(56,189,248,.12),
    0 25px 60px rgba(0,0,0,.45);
}

.search-icon{
  width:46px;
  height:46px;
  min-width:46px;
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(255,255,255,.04);
  color:#94a3b8;
  font-size:1rem;
}

.search-input{
  flex:1;
  border:none;
  outline:none;
  background:transparent;
  color:#fff;
  font-size:1rem;
  padding:14px 6px;
}

.search-input::placeholder{
  color:#64748b;
}

.search-clear{
  width:42px;
  height:42px;
  min-width:42px;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-decoration:none;
  color:#94a3b8;
  transition:.2s ease;
}

.search-clear:hover{
  background:rgba(239,68,68,.12);
  color:#ef4444;
}

.search-btn{
  border:none;
  display:flex;
  align-items:center;
  gap:8px;

  background:linear-gradient(135deg,#38bdf8,#2563eb);

  color:#fff;
  font-weight:700;

  padding:14px 20px;
  border-radius:14px;

  cursor:pointer;
  transition:.25s ease;
}

.search-btn:hover{
  transform:translateY(-1px);
  filter:brightness(1.08);
}

/* ===================================
   RESULTS BAR
=================================== */
.faq-results-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.results-count{
  display:flex;
  align-items:center;
  gap:10px;

  padding:12px 16px;

  border-radius:14px;

  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.06);

  color:#cbd5e1;
  font-size:.92rem;
}

.results-count i{
  color:#38bdf8;
}

/* ===================================
   GRID
=================================== */
.faq-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(290px,1fr));
  gap:22px;
}

/* ===================================
   CARD
=================================== */
.faq-card{
  position:relative;

  background:var(--card-bg);
  backdrop-filter:blur(18px);

  border:1px solid var(--card-border);
  border-radius:24px;

  padding:22px;

  overflow:hidden;

  transition:all .28s ease;

  box-shadow:0 15px 35px rgba(0,0,0,.25);
}

.faq-card::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.05),
      transparent 35%
    );
  pointer-events:none;
}

.faq-card:hover{
  transform:translateY(-8px);
  border-color:rgba(56,189,248,.28);
  box-shadow:0 30px 65px rgba(0,0,0,.45);
}

.faq-card-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.faq-badge{
  display:inline-flex;
  align-items:center;
  gap:8px;

  padding:8px 14px;
  border-radius:999px;

  background:rgba(56,189,248,.12);
  border:1px solid rgba(56,189,248,.18);

  color:#7dd3fc;
  font-size:.78rem;
  font-weight:700;
}

.faq-card-body{
  margin-top:18px;
}

.faq-question{
  color:#fff;
  font-size:1.12rem;
  line-height:1.6;
  font-weight:800;
  margin-bottom:14px;
}

.faq-answer{
  color:#94a3b8;
  font-size:.94rem;
  line-height:1.8;
  margin:0;
}

/* ===================================
   CARD ACTIONS
=================================== */
.faq-bottom{
  display:flex;
  justify-content:space-between;
  gap:12px;
  margin-top:24px;
}

.btn-soft,
.btn-ghost{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;

  padding:12px 14px;
  border-radius:14px;

  text-decoration:none;
  font-weight:700;
  font-size:.88rem;

  transition:.25s ease;
}

.btn-soft{
  background:rgba(56,189,248,.12);
  border:1px solid rgba(56,189,248,.18);
  color:#7dd3fc;
}

.btn-soft:hover{
  background:rgba(56,189,248,.18);
  color:#fff;
}

.btn-ghost{
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.08);
  color:#e2e8f0;
}

.btn-ghost:hover{
  background:rgba(255,255,255,.06);
  color:#fff;
}

/* ===================================
   EMPTY STATE
=================================== */
.empty-state{
  display:flex;
  justify-content:center;
  padding:60px 0;
}

.empty-box{
  max-width:520px;
  width:100%;

  text-align:center;

  background:rgba(15,23,42,.78);
  backdrop-filter:blur(18px);

  border:1px solid rgba(255,255,255,.08);

  border-radius:28px;

  padding:50px 30px;

  box-shadow:0 30px 70px rgba(0,0,0,.35);
}

.empty-icon{
  width:82px;
  height:82px;
  margin:0 auto 24px;

  border-radius:24px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:rgba(56,189,248,.12);
  border:1px solid rgba(56,189,248,.2);

  color:#38bdf8;
  font-size:2rem;
}

.empty-box h2{
  color:#fff;
  font-size:1.7rem;
  margin-bottom:14px;
}

.empty-box p{
  color:#94a3b8;
  line-height:1.9;
  margin-bottom:28px;
}

/* ===================================
   MOBILE
=================================== */
@media (max-width:768px){

  .faq-hero{
    padding:70px 18px 50px;
  }

  .faq-hero-inner h1{
    font-size:2.2rem;
  }

  .faq-hero-inner p{
    font-size:.98rem;
  }

  .search-box{
    flex-wrap:wrap;
    padding:12px;
  }

  .search-input{
    width:100%;
    padding:10px 2px;
  }

  .search-btn{
    width:100%;
    justify-content:center;
  }

  .faq-grid{
    grid-template-columns:1fr;
  }

  .faq-bottom{
    flex-direction:column;
  }

  .btn-soft,
  .btn-ghost{
    width:100%;
  }

}
</style>