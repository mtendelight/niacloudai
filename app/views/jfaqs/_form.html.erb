<%= render "layouts/header" %>

<div class="login faq-page">


<%= form_with(model: jfaq, class: "jfaq-form") do |form| %>

  <% if jfaq.errors.any? %>
    <div class="form-errors">
      <h3>
        <%= pluralize(jfaq.errors.count, "error") %> prevented saving:
      </h3>

      <ul>
        <% jfaq.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-card">

    <!-- QUESTION -->
    <div class="form-group">
      <%= form.label :question, "FAQ Question", class: "form-label" %>
      <%= form.text_field :question, class: "form-input", placeholder: "e.g. Do you deliver mtumba bales?", required: true %>
    </div>

    <!-- ANSWER -->
    <div class="form-group">
      <%= form.label :answer, "Answer", class: "form-label" %>
      <%= form.text_area :answer, rows: 5, class: "form-textarea", placeholder: "Write a clear answer...", required: true %>
    </div>

    <!-- CATEGORY -->
    <div class="form-group">
      <%= form.label :category, "Category", class: "form-label" %>
      <%= form.select :category,
        ["Shipping", "Payments", "Stock", "Branches", "Pricing", "General"],
        { prompt: "Select category" },
        class: "form-select", required: true %>
    </div>

    <!-- SUBMIT -->
    <div class="form-actions">
      <%= form.submit "Save FAQ", class: "btn-primary" %>
    </div>

  </div>
<% end %>

<style>
  .jfaq-form {
  max-width: 650px;
  margin: 0 auto;
}

.form-card {
  background: #0f172a;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.35);
}

.form-group {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 0.9rem;
  color: #cbd5e1;
  margin-bottom: 6px;
}

.form-input,
.form-textarea,
.form-select {
  width: 100%;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.12);
  background: #111827;
  color: #fff;
  outline: none;
}

.form-input:focus,
.form-textarea:focus,
.form-select:focus {
  border-color: #38bdf8;
  box-shadow: 0 0 0 2px rgba(56,189,248,0.2);
}

.form-actions {
  margin-top: 18px;
  text-align: right;
}

.btn-primary {
  background: linear-gradient(135deg, #38bdf8, #2563eb);
  border: none;
  padding: 10px 18px;
  color: #fff;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 600;
}

.btn-primary:hover {
  opacity: 0.9;
}

.form-errors {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.4);
  color: #fecaca;
  padding: 12px;
  border-radius: 10px;
  margin-bottom: 15px;
}
</style>