<%= render "layouts/header" %>

<div class="container my-4">

  <!-- 🔷 CUSTOMER CARD -->
  <div class="card shadow-lg border-0 mx-auto customer-card">
    
    <!-- HEADER -->
    <div class="card-header bg-gradient-primary text-white text-center py-3">
     <h4 class="fw-bold mb-0 d-flex justify-content-center align-items-center gap-2">
  <i class="bi bi-person-circle"></i>

  <%= @jmcustomer.name %>

  <% if @jmcustomer.blacklist? %>
    <span class="badge bg-danger">
      <i class="bi bi-shield-fill-exclamation"></i>
      BLACKLISTED
    </span>
  <% end %>
</h4>
    </div>

    <!-- LINKED LEAD -->
    <% if @jmcustomer.jmlead.present? %>
      <div class="alert alert-info text-center py-2 mb-0 rounded-0">
        <i class="bi bi-link-45deg"></i>
        Linked to Lead

        <%= link_to jmlead_path(@jmcustomer.jmlead),
              class: "btn btn-sm btn-outline-primary ms-2" do %>
          View Lead
        <% end %>
      </div>
    <% end %>

    <!-- BLACKLIST WARNING -->
<% if @jmcustomer.blacklist? %>
  <div class="alert alert-danger border-0 rounded-0 mb-0">
    <div class="d-flex align-items-center">
      <i class="bi bi-shield-fill-exclamation fs-2 me-3"></i>

      <div>
        <h5 class="mb-1 fw-bold">
          BLACKLISTED CUSTOMER
        </h5>

        <p class="mb-0">
          This customer has been <strong>blacklisted</strong>.
          Please exercise caution before processing orders, deliveries or issuing refunds.
          Management has been notified whenever this customer makes a payment.
        </p>
      </div>
    </div>
  </div>
<% end %>

    <!-- BODY -->
    <div class="card-body">

      <!-- BASIC INFO -->
      <div class="row text-center mb-3">
        <div class="col-6">
          <small class="text-muted">Phone</small>
          <div class="fw-bold">
            <i class="bi bi-telephone-fill text-success me-1"></i>
            <%= @jmcustomer.phone %>
          </div>
        </div>

        <div class="col-6">
          <small class="text-muted">Location</small>
          <div class="fw-bold">
            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
            <%= @jmcustomer.location.presence || "—" %>
          </div>
        </div>
      </div>

      <!-- TIER -->
      <div class="text-center mb-3">
        <span class="badge px-3 py-2 <%= @jmcustomer.tier_color %>">
          <%= @jmcustomer.tier_icon %> <%= @jmcustomer.tier_label %>
        </span>
      </div>

      <!-- ITEMS -->
      <h6 class="text-primary mb-2">
        <i class="bi bi-bag-check-fill me-1"></i> Items Purchased
      </h6>

      <% if @jmcustomer.jmcustomer_items.any? %>
        <% grouped = @jmcustomer.jmcustomer_items.group_by(&:janomax_id) %>

        <div class="items-box">
          <% grouped.each_with_index do |(id, items), index| %>
            <% name = items.first.janomax.item_name rescue "Unknown" %>
            <% count = items.size %>

            <div class="item-row d-flex justify-content-between align-items-center">
              <div>
                <span class="text-primary fw-bold me-1"><%= index + 1 %>.</span>
                <%= name %>
              </div>

              <% if count > 1 %>
                <span class="badge bg-secondary rounded-pill"><%= count %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-muted text-center fst-italic">
          <i class="bi bi-dash-circle"></i> No items added
        </div>
      <% end %>

      <!-- ACTIONS -->
      <div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
        <%= link_to new_jmcustomer_path,
              class: "btn btn-primary btn-sm px-3",
              data: { turbo: false } do %>
          <i class="bi bi-person-plus"></i> New Customer
        <% end %>

        <%= link_to edit_jmcustomer_path(@jmcustomer),
              class: "btn btn-warning btn-sm px-3",
              data: { turbo: false } do %>
          <i class="bi bi-pencil-square"></i> Escalate
        <% end %>

        <%= link_to jmcustomers_path,
              class: "btn btn-outline-secondary btn-sm px-3",
              data: { turbo: false } do %>
          <i class="bi bi-arrow-left"></i> Back
        <% end %>

   <%= link_to janomaxleads_path(status: "converted"),
      class: "btn btn-outline-success btn-sm px-3",
      data: { turbo: false } do %>
  <i class="bi bi-arrow-left"></i> Back to Converted Leads
<% end %>
      </div>

    </div>
  </div>

  <div class="card my-4 shadow-sm">
  <div class="card-header bg-primary text-white">
    <strong>Call Comments</strong>
  </div>

  <div class="card-body">
<div class="login">
    <%= form_with url: update_callcomments_jmcustomer_path(@jmcustomer),
                  method: :patch,
                  data: { turbo_stream: true } do |f| %>

      <div class="mb-3">
        <textarea id="new_callcomment"
                  name="new_callcomment"
                  rows="3"
                  class="form-control"
                  placeholder="Type new call comment..."></textarea>
      </div>

      <%= f.submit "Add Comment", class: "btn btn-success" %>
    <% end %>
  </div>
</div>

<div id="callcomments_list">

  <% comments = @jmcustomer.callcomments.to_s.split("\n\n").reverse %>

  <% if comments.any? %>
    <% comments.each do |c| %>
      <div class="call-comment my-2 p-3 shadow-sm rounded-3 bg-white border d-flex align-items-start gap-2">
        
        <!-- Icon on left -->
        <div class="text-primary mt-1">
          <i class="bi bi-telephone-fill"></i>
        </div>

        <!-- Comment content -->
        <div class="flex-grow-1">
          <!-- Timestamp -->
          <% timestamp, text = c.split("]", 2) %>
          <div class="small text-muted mb-1">
            <i class="bi bi-clock me-1"></i>
            <%= timestamp.gsub("[","") %>
          </div>

          <!-- Comment text -->
          <div class="text-dark">
            <i class="bi bi-chat-left-text-fill me-1 text-secondary"></i>
            <%= text.strip %>
          </div>
        </div>

      </div>
    <% end %>
  <% else %>
    <div class="text-muted fst-italic d-flex align-items-center gap-1">
      <i class="bi bi-info-circle"></i>
      No call comments yet.
    </div>
  <% end %>

</div>


<!-- HEADER -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h4 class="mb-0 fw-bold">
      <i class="bi bi-cash-stack text-success me-1"></i>
      Payments
    </h4>

    <%= link_to new_jmcustomer_jmpayment_path(@jmcustomer),
        class: "btn btn-primary btn-sm d-flex align-items-center gap-1" do %>
      <i class="bi bi-plus-circle"></i>
      Add Payment
    <% end %>
  </div>

  <!-- TABLE CARD -->
  <div class="card shadow-sm border-0">
    <div class="card-body p-0">

      <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

          <thead class="table-dark">
            <tr>
              <th><i class="bi bi-calendar-event me-1"></i> Date</th>
              <th><i class="bi bi-receipt me-1"></i> Ref</th>
              <th><i class="bi bi-shield-check me-1"></i> Mpesa Code</th>
              <th><i class="bi bi-person me-1"></i> Name</th>
              <th><i class="bi bi-telephone me-1"></i> Phone</th>
              <th><i class="bi bi-cash-coin me-1"></i> Amount</th>
          
            </tr>
          </thead>

          <tbody>

            <% payments = @jmcustomer.jmpayments.order(date: :desc) %>

            <% if payments.any? %>
              <% payments.each do |p| %>
                <tr>

                  <td>
                    <span class="badge bg-light text-dark">
                      <%= p.date %>
                    </span>
                  </td>

                  <td class="fw-semibold">
                    <%= p.transaction_ref %>
                  </td>

                  <td>
                    <code class="text-primary"><%= p.mpesa_code %></code>
                  </td>

                  <td>
                    <i class="bi bi-person-circle me-1 text-muted"></i>
                    <%= p.name %>
                  </td>

                  <td>
                    <i class="bi bi-phone me-1 text-muted"></i>
                    <%= p.mpesa_number %>
                  </td>

                  <!-- 💰 KSH FORMAT -->
                  <td class="fw-bold text-success">
                    KSh <%= number_with_delimiter(p.amount.to_i) %>
                  </td>

          

                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">
                  <i class="bi bi-inbox me-1"></i>
                  No payments found
                </td>
              </tr>
            <% end %>

          </tbody>
        </table>

      </div>

    </div>
  </div>

  <!-- BOTTOM ACTIONS -->
  <div class="d-flex justify-content-center mt-4 gap-2 flex-wrap">

    <%= link_to jmcustomers_path,
        class: "btn btn-outline-secondary d-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      Back
    <% end %>

    <%= link_to new_jmcustomer_jmpayment_path(@jmcustomer),
        class: "btn btn-primary d-flex align-items-center gap-1" do %>
      <i class="bi bi-plus-circle"></i>
      Add Payment
    <% end %>

  </div>

</div>
  <!-- 🔷 AUDIT LOG -->
  <div class="audit-section mt-5 mx-auto">
    <h5 class="text-primary mb-3 text-center">
      <i class="bi bi-clock-history"></i> Audit Logs
    </h5>

    <% if @jmcustomer.audits.present? %>
      <% @jmcustomer.audits.each do |audit| %>
        <div class="audit-card shadow-sm mb-2">
          <div class="audit-header">
            👤 <strong><%= audit.user&.username || "System" %></strong>
            <span class="text-muted small">
              • <%= audit.created_at.strftime("%d %b %Y, %I:%M %p") %>
            </span>
          </div>

          <div class="audit-body">
            <% if audit.audited_changes.present? %>
              <% audit.audited_changes.each do |attr, values| %>
                <% old_val, new_val = values.is_a?(Array) ? values : [nil, values] %>

                <div class="audit-change">
                  <strong><%= attr.titleize %></strong>:
                  <span class="text-muted"><%= old_val.presence || "—" %></span>
                  →
                  <span class="text-success"><%= new_val.presence || "—" %></span>
                </div>
              <% end %>
            <% else %>
              <em class="text-muted">No changes recorded</em>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center text-muted">No audit logs found</p>
    <% end %>
  </div>

</div>


<style>
  
  .customer-card {
  max-width: 520px;
  border-radius: 14px;
}

.bg-gradient-primary {
  background: linear-gradient(135deg, #007bff, #0056b3);
}

.items-box {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 10px;
}

.item-row {
  padding: 6px 4px;
  border-bottom: 1px solid #eee;
}

.item-row:last-child {
  border-bottom: none;
}

.audit-section {
  max-width: 650px;
}

.audit-card {
  border-left: 4px solid #0d6efd;
  background: #fff;
  border-radius: 6px;
  padding: 10px;
}

.audit-header {
  font-size: 0.9rem;
  margin-bottom: 5px;
}

.audit-body {
  font-size: 0.85rem;
}

.audit-change {
  margin-bottom: 3px;
}

.call-comment {
  transition: all 0.2s ease;
}

.call-comment:hover {
  background: #f8f9fa;
  transform: scale(1.01);
}
</style>


