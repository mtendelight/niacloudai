<%= render "layouts/header" %>

<div class="container my-4">

  <!-- CUSTOMER CARD -->
  <div class="card shadow-sm mb-4 border-0">
    <div class="card-body">
      <%= render "form1", jmcustomer: @jmcustomer %>
    </div>
  </div>

  <!-- HEADER -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h4 class="mb-0 fw-bold">
      <i class="bi bi-cash-stack text-success me-1"></i>
      Payments
    </h4>

    <%= link_to new_jmcustomer_jmpayment_path(@jmcustomer),
        class: "btn btn-primary btn-sm d-flex align-items-center gap-1" do %>
      <i class="bi bi-plus-circle"></i>
      Add Payment
    <% end %>
  </div>

  <!-- TABLE CARD -->
  <div class="card shadow-sm border-0">
    <div class="card-body p-0">

      <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

          <thead class="table-dark">
            <tr>
              <th><i class="bi bi-calendar-event me-1"></i> Date</th>
              <th><i class="bi bi-receipt me-1"></i> Ref</th>
              <th><i class="bi bi-shield-check me-1"></i> Mpesa Code</th>
              <th><i class="bi bi-person me-1"></i> Name</th>
              <th><i class="bi bi-telephone me-1"></i> Phone</th>
              <th><i class="bi bi-cash-coin me-1"></i> Amount</th>
          
            </tr>
          </thead>

          <tbody>

            <% payments = @jmcustomer.jmpayments.order(date: :desc) %>

            <% if payments.any? %>
              <% payments.each do |p| %>
                <tr>

                  <td>
                    <span class="badge bg-light text-dark">
                      <%= p.date %>
                    </span>
                  </td>

                  <td class="fw-semibold">
                    <%= p.transaction_ref %>
                  </td>

                  <td>
                    <code class="text-primary"><%= p.mpesa_code %></code>
                  </td>

                  <td>
                    <i class="bi bi-person-circle me-1 text-muted"></i>
                    <%= p.name %>
                  </td>

                  <td>
                    <i class="bi bi-phone me-1 text-muted"></i>
                    <%= p.mpesa_number %>
                  </td>

                  <!-- 💰 KSH FORMAT -->
                  <td class="fw-bold text-success">
                    KSh <%= number_with_delimiter(p.amount.to_i) %>
                  </td>

          

                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">
                  <i class="bi bi-inbox me-1"></i>
                  No payments found
                </td>
              </tr>
            <% end %>

          </tbody>
        </table>

      </div>

    </div>
  </div>

  <!-- BOTTOM ACTIONS -->
  <div class="d-flex justify-content-center mt-4 gap-2 flex-wrap">

    <%= link_to jmcustomers_path,
        class: "btn btn-outline-secondary d-flex align-items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i>
      Back
    <% end %>

    <%= link_to new_jmcustomer_jmpayment_path(@jmcustomer),
        class: "btn btn-primary d-flex align-items-center gap-1" do %>
      <i class="bi bi-plus-circle"></i>
      Add Payment
    <% end %>

  </div>

</div>