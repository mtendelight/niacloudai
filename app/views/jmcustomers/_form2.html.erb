<div class="form-wrapper">

  <%= form_with(model: jmcustomer, local: true) do |form| %>

    <div class="card edit-card shadow-sm border-0">

      <!-- HEADER -->
      <div class="card-header bg-white text-center border-0 pt-4">
        <h5 class="fw-bold text-primary mb-1">
          <i class="bi bi-pencil-square me-1"></i>
          Edit Customer
        </h5>
        <small class="text-muted">Update details & manage items</small>
      </div>

      <div class="card-body text-center">

        <!-- AVATAR -->
        <div class="reward-avatar mx-auto mb-3">
          <i class="bi bi-person-fill"></i>
          <span class="reward-points">
            <i class="bi bi-cash-coin me-1"></i>
            <%= jmcustomer.points %>
          </span>
        </div>

        <!-- NAME -->
        <h5 class="fw-bold text-primary mb-1"><%= jmcustomer.name %></h5>

        <!-- PHONE -->
        <div class="text-muted small">
          <i class="bi bi-telephone me-1"></i>
          <%= jmcustomer.phone %>
        </div>

        <!-- LOCATION -->
        <div class="text-muted small mb-2">
          <i class="bi bi-geo-alt me-1 text-danger"></i>
          <%= jmcustomer.location.presence || "No location" %>
        </div>

        <!-- LAST UPDATED -->
        <div class="updated-badge">
          <i class="bi bi-clock me-1"></i>
          Updated <%= time_ago_in_words(jmcustomer.updated_at) %> ago
        </div>

      </div>

      <!-- ITEMS -->
      <div class="px-4 pb-3">

        <h6 class="section-title">
          <i class="bi bi-box-seam me-1"></i> Items
        </h6>

        <div id="items-container" class="items-box">

          <% combined_items = jmcustomer.jmcustomer_items.group_by(&:janomax_id)
             .sort_by { |id, items| items.first.janomax&.item_name.to_s.downcase } %>

          <% combined_items.each do |janomax_id, items| %>
            <% first_item = items.first %>
            <% total_count = items.size %>

            <div class="item-row">

              <span class="row-number"></span>

              <%= form.fields_for :jmcustomer_items, first_item do |item_form| %>
                <%= item_form.collection_select :janomax_id,
                      Janomax.all.order(Arel.sql("LOWER(TRIM(item_name))")),
                      :id, :item_name,
                      {},
                      { class: "form-select elena flex-grow-1", disabled: true } %>

                <% if total_count > 1 %>
                  <span class="item-count">× <%= total_count %></span>
                <% end %>

                <%= item_form.hidden_field :_destroy, class: "destroy-flag" %>
              <% end %>

            </div>
          <% end %>

        </div>

        <!-- ADD ITEM -->
        <button id="add-item" class="btn btn-outline-primary w-100 mt-3" disabled>
          <i class="bi bi-plus-circle me-1"></i> Add Item
        </button>

      </div>

      <!-- POINTS -->
      <div class="px-4 pb-3">
        <label class="form-label fw-semibold">Redeem Points</label>
        <%= form.text_field :points,
              class: "form-control text-center",
              placeholder: "Enter points",
              required: true %>
      </div>

      <!-- ACTIONS -->
      <div class="card-footer bg-white border-0 p-3">
        <div class="d-flex gap-2">
          <%= form.submit "Update Customer",
                class: "btn btn-primary w-100",
                id: "submit_jmcustomer",
                data: { loading_text: "Updating..." } %>

          <%= link_to "Cancel", jmcustomers_path,
                class: "btn btn-light border w-100" %>
        </div>
      </div>

    </div>

  <% end %>
</div>

<style>
  
  .form-wrapper {
  max-width: 720px;
  margin: 40px auto;
}

/* Card */
.edit-card {
  border-radius: 1rem;
  overflow: hidden;
}

/* Avatar */
.reward-avatar {
  width: 95px;
  height: 95px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d6efd, #4dabf7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  color: white;
  position: relative;
}

/* Points */
.reward-points {
  position: absolute;
  bottom: -6px;
  right: -6px;
  background: #ffc107;
  color: #000;
  font-weight: 600;
  font-size: 0.75rem;
  padding: 5px 8px;
  border-radius: 999px;
  border: 2px solid white;
}

/* Updated badge */
.updated-badge {
  display: inline-block;
  background: #f1f3f5;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 0.8rem;
  margin-top: 8px;
}

/* Section */
.section-title {
  font-weight: 600;
  margin-bottom: 10px;
}

/* Items box */
.items-box {
  background: #f8f9fa;
  padding: 12px;
  border-radius: 10px;
}

/* Item row */
.item-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.item-count {
  font-size: 0.85rem;
  color: #6c757d;
}

/* Buttons */
.btn {
  border-radius: 0.5rem;
  font-weight: 600;
}

/* Mobile */
@media (max-width: 576px) {
  .item-row {
    flex-direction: column;
    align-items: stretch;
  }

  .btn {
    width: 100%;
  }
}
</style>