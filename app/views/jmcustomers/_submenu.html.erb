  min-height:80px;

  padding:10px 8px;

  gap:6px;

  border-radius:22px;

}

/* =========================================
   SUPER ADMIN ICONS
========================================= */

.super-icon{

  width:36px;
  height:36px;

  border-radius:12px;

}

.super-icon i{

  font-size:14px;

}

.super-content h6{

  font-size:9px;

}

/* SUPER CARD */

.superadmin-card{

  width:78px;
  min-height:80px;

  padding:10px 8px;

  gap:6px;

  border-radius:22px;

}

/* =========================================
   MOBILE
========================================= */

@media(max-width:768px){

  .menu-item,
  .superadmin-card{

    width:70px;
