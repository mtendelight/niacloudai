        data: { module_name: "faq faqs questions answers knowledge" } do %>

      <div class="flow-menu-icon flow-gold">
        <i class="bi bi-question-circle-fill"></i>
      </div>

      <div class="flow-menu-content">
        <strong>FAQs</strong>
        <span>Knowledge base and answers</span>
      </div>

