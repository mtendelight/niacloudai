        <span>Conversations and AI activity</span>
      </div>

      <i class="bi bi-arrow-up-right flow-arrow"></i>

    <% end %>


  </div>


  <!-- =========================================================
       INTELLIGENCE
  ========================================================== -->

  <div class="flow-section-heading">

    <div>
      <span>02</span>
      <strong>Intelligence</strong>
    </div>

    <small>
      Data & automation
