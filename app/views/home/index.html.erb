<!-- app/views/dashboard/index.html.erb -->

<div class="flow-dashboard">

  <!-- =========================================================
       HEADER
  ========================================================== -->

  <section class="flow-dashboard-header">

    <div class="flow-brand-area">

      <div class="flow-logo-box">
        <%= image_tag "flogoo.png",
                      alt: "Flow",
                      class: "flow-dashboard-logo" %>
      </div>

      <div>
        <div class="flow-eyebrow">
          <i class="bi bi-grid-1x2-fill"></i>
          COMMAND CENTRE
        </div>

        <h1>
          Flow
          <span>ERP</span>
        </h1>

        <p>
          Business operations at a glance.
        </p>
      </div>

    </div>


    <!-- USER -->

    <div class="flow-user-card">

      <div class="flow-user-avatar">
        <i class="bi bi-person-fill"></i>
      </div>

      <div class="flow-user-info">

        <span>LOGGED IN AS</span>

        <strong>
          <%= current_user.username %>
        </strong>

      </div>

      <%= button_to destroy_user_session_path,
          method: :delete,
          class: "flow-logout",
          title: "Logout" do %>

        <i class="bi bi-box-arrow-right"></i>

      <% end %>

    </div>

  </section>


  <!-- =========================================================
       SEARCH
  ========================================================== -->

  <section class="flow-search-section">

    <div class="flow-search">

      <i class="bi bi-search"></i>

      <input
        type="text"
        id="menuSearch"
        placeholder="Search modules..."
        autocomplete="off"
      >

      <span class="flow-search-shortcut">
        /
      </span>

    </div>

  </section>


  <!-- =========================================================
       BUSINESS
  ========================================================== -->

  <div class="flow-section-heading">

    <div>
      <span>01</span>
      <strong>Business</strong>
    </div>

    <small>
      Core operations
    </small>

  </div>


  <div class="flow-menu-grid">


    <!-- CUSTOMERS -->

    <%= link_to "/jmcustomers",
        class: "flow-menu-card",
        data: { module_name: "customers crm our customers" } do %>

      <div class="flow-menu-icon flow-blue">
        <i class="bi bi-briefcase-fill"></i>
      </div>

      <div class="flow-menu-content">
        <strong>Our Customers</strong>
        <span>Customer relationship management</span>
      </div>

      <i class="bi bi-arrow-up-right flow-arrow"></i>

    <% end %>


    <!-- CALL CENTRE -->

    <%= link_to "/janomaxleads/dashboard",
        class: "flow-menu-card",
        data: { module_name: "call center call centre customer care" } do %>

      <div class="flow-menu-icon flow-green">
        <i class="bi bi-headset"></i>
      </div>

      <div class="flow-menu-content">
        <strong>Call Centre</strong>
        <span>Customer calls and follow-ups</span>
      </div>

      <i class="bi bi-arrow-up-right flow-arrow"></i>

