      <div class="flow-menu-icon flow-purple">
        <i class="bi bi-robot"></i>
      </div>

      <div class="flow-menu-content">
        <strong>AI Leads</strong>
        <span>Intelligent lead management</span>
      </div>

      <i class="bi bi-arrow-up-right flow-arrow"></i>

    <% end %>


    <!-- WHATSAPP -->

    <%= link_to "/ailogs",
