    <% end %>


    <!-- AI PRODUCTS -->

    <%= link_to aiproducts_path,
        class: "flow-menu-card",
        data: { module_name: "ai products artificial intelligence products" } do %>

      <div class="flow-menu-icon flow-purple">
        <i class="bi bi-robot"></i>
      </div>

      <div class="flow-menu-content">
        <strong>AI Products</strong>
        <span>AI-powered product intelligence</span>
      </div>

      <i class="bi bi-arrow-up-right flow-arrow"></i>

    <% end %>


    <!-- FAQ -->

    <%= link_to jfaqs_path,
