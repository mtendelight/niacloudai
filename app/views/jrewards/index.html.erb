<%= render "layouts/header" %>

<div class="container py-5">

  <!-- PAGE HEADER -->
  <div class="text-center mb-5">
    <h2 class="fw-bold text-primary d-flex justify-content-center align-items-center gap-2">
      <i class="bi bi-gift-fill"></i>
      Customer Rewards
    </h2>
    <p class="text-muted mb-0">
      <i class="bi bi-search me-1"></i>
      Search by phone number to view reward points
    </p>
  </div>

  <!-- SEARCH CARD -->
  <div class="card shadow-lg border-0 search-card mx-auto">
    <div class="card-body p-4">
<div class="login">
      <%= search_form_for @y, url: query_jmcustomers_path do |f| %>
        <div class="input-group input-group-lg">

          <!-- ICON -->
          <span class="input-group-text bg-white">
            <i class="bi bi-telephone-fill text-primary"></i>
          </span>

          <!-- INPUT -->
          <%= f.search_field :phone_eq,
              class: "form-control search-input",
              placeholder: "Enter phone number (07XXXXXXXX)" %>

          <!-- BUTTON -->
          <button class="btn btn-primary px-4">
            <i class="bi bi-search"></i>
            <span class="d-none d-md-inline"> Search</span>
          </button>

        </div>
      <% end %>

    </div>
  </div>

</div>

<style>

/* ===== GLOBAL SPACING ===== */
.container {
  max-width: 900px;
}

/* ===== SEARCH CARD ===== */
.search-card {
  border-radius: 1rem;
  max-width: 600px;
  background: #ffffff;
  transition: all 0.3s ease;
}

.search-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.1);
}

/* ===== INPUT ===== */
.search-input {
  border-left: 0;
}

.input-group-text {
  border-right: 0;
}

/* Focus effect */
.form-control:focus {
  box-shadow: none;
  border-color: #0d6efd;
}

/* ===== BUTTON ===== */
.btn-primary {
  border-radius: 0 0.5rem 0.5rem 0;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 576px) {
  .input-group {
    flex-direction: column;
    gap: 10px;
  }

  .input-group-text {
    display: none;
  }

  .btn {
    width: 100%;
    border-radius: 0.5rem !important;
  }

  .search-input {
    border-radius: 0.5rem !important;
  }
}

/* ===== HEADER ICON STYLE ===== */
h2 i {
  font-size: 1.5rem;
}

/* ===== OPTIONAL REWARD CARD (IMPROVED) ===== */
.reward-circle-card {
  border-radius: 1rem;
  border-top: 4px solid #0d6efd;
  transition: all 0.3s ease;
}

.reward-circle-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 24px rgba(0,0,0,0.15);
}

.reward-avatar {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d6efd, #4dabf7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.8rem;
  color: #fff;
  position: relative;
}

.reward-points {
  position: absolute;
  bottom: -6px;
  right: -6px;
  background: #ffc107;
  color: #000;
  font-weight: bold;
  font-size: 0.8rem;
  padding: 5px 10px;
  border-radius: 999px;
  border: 2px solid #fff;
}

/* ===== ADMIN MESSAGE ===== */
.admin-message {
  text-align: center;
  background: #ffe5e5;
  color: #b02a37;
  padding: 12px;
  border-radius: 8px;
  font-weight: 600;
}

</style>