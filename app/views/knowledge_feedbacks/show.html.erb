<%= render "layouts/header" %>

<div class="container py-4">

  <!-- Header -->
  <div class="ai-feedback-header mb-4">

    <div class="d-flex align-items-center">

      <%= link_to knowledge_feedbacks_path,
          class: "back-btn me-3" do %>

        <i class="bi bi-arrow-left"></i>

      <% end %>


      <div class="ai-icon me-3">

        <i class="bi bi-lightbulb-fill"></i>

      </div>


      <div>

        <h3 class="fw-bold mb-1">
          <%= @knowledge_feedback.title %>
        </h3>

        <p class="text-muted mb-0">
          AI detected knowledge improvement opportunity
        </p>

      </div>

    </div>


  </div>



  <!-- Summary Cards -->
  <div class="row g-3 mb-4">


    <div class="col-md-4">

      <div class="info-card">

        <small>
          Type
        </small>

        <h6>
          <%= @knowledge_feedback.feedback_type.to_s.humanize %>
        </h6>

      </div>

    </div>



    <div class="col-md-4">

      <div class="info-card">

        <small>
          Priority
        </small>

        <h6>

          <% if @knowledge_feedback.priority == "high" %>

            <span class="badge bg-danger">
              High
            </span>

          <% elsif @knowledge_feedback.priority == "medium" %>

            <span class="badge bg-warning text-dark">
              Medium
            </span>

          <% else %>

            <span class="badge bg-success">
              Low
            </span>

          <% end %>

        </h6>

      </div>

    </div>



    <div class="col-md-4">

      <div class="info-card">

        <small>
          Occurrences
        </small>

        <h6>
          <span class="count-circle">
            <%= @knowledge_feedback.occurrences %>
          </span>
        </h6>

      </div>

    </div>


  </div>



  <!-- Details -->
  <div class="premium-card">


    <div class="card-body p-4">


      <div class="section-title">

        <i class="bi bi-chat-left-text-fill"></i>

        Customer Question

      </div>


      <div class="question-box">

        <%= @knowledge_feedback.question %>

      </div>



      <div class="section-title mt-4">

        <i class="bi bi-magic"></i>

        AI Recommendation

      </div>


      <div class="recommendation-box">

        <%= @knowledge_feedback.recommendation %>

      </div>



      <div class="mt-4">

        <small class="text-muted">

          Created 
          <%= time_ago_in_words(@knowledge_feedback.created_at) %>
          ago

        </small>

      </div>


    </div>


  </div>


</div>

<style>
	.ai-feedback-header{

background:#fff;
padding:25px;
border-radius:22px;
box-shadow:0 10px 35px rgba(0,0,0,.08);

}


.back-btn{

width:46px;
height:46px;

display:flex;
align-items:center;
justify-content:center;

background:#f8fafc;

border-radius:50%;

font-size:22px;

color:#111;

text-decoration:none;

transition:.25s;

}


.back-btn:hover{

background:#111;
color:#fff;

transform:translateX(-3px);

}



.ai-icon{

width:64px;
height:64px;

display:flex;
align-items:center;
justify-content:center;

border-radius:20px;

background:linear-gradient(135deg,#0d6efd,#6610f2);

color:white;

font-size:30px;

box-shadow:0 10px 25px rgba(13,110,253,.3);

}



.info-card{

background:white;

padding:22px;

border-radius:18px;

box-shadow:0 8px 25px rgba(0,0,0,.06);

height:100%;

}


.info-card small{

color:#64748b;

font-size:13px;

}


.info-card h6{

margin-top:12px;

font-weight:700;

}



.count-circle{

display:inline-flex;

width:42px;
height:42px;

align-items:center;
justify-content:center;

background:#eef4ff;

color:#0d6efd;

border-radius:50%;

}



.premium-card{

background:white;

border-radius:22px;

box-shadow:0 10px 35px rgba(0,0,0,.08);

overflow:hidden;

}



.section-title{

font-weight:700;

font-size:16px;

display:flex;

align-items:center;

gap:10px;

margin-bottom:15px;

}



.section-title i{

color:#0d6efd;

}



.question-box{

background:#f8fafc;

padding:20px;

border-radius:16px;

border-left:5px solid #0d6efd;

font-size:15px;

}



.recommendation-box{

background:#fff7ed;

padding:20px;

border-radius:16px;

border-left:5px solid #f59e0b;

font-size:15px;

}



.badge{

padding:8px 14px;

border-radius:50px;

font-weight:600;

}
</style>