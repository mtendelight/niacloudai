<%= render "layouts/header" %>

<div class="container">

<div class="container-fluid py-4">

  <div class="feedback-header mb-4">
    <div>
      <h2 class="fw-bold mb-1">
        <i class="bi bi-robot"></i>
        AI Knowledge Feedback
      </h2>
      <small class="text-muted">
        Missing FAQs, products and knowledge improvements suggested by AI.
      </small>
    </div>

    <div class="feedback-count">
      <%= @knowledge_feedbacks.count %>
      <small>Suggestions</small>
    </div>

     <!-- Back Button -->
        <%= link_to ailogs_path,
            class: "btn btn-light rounded-circle shadow-sm me-3",
            style: "width:45px;height:45px;" do %>

          <i class="bi bi-arrow-left fs-4"></i>

        <% end %>
  </div>

  <div class="premium-card mb-4">
    <div class="card-body">
<div class="login">
      <%= form_with url: knowledge_feedbacks_path,
                    method: :get,
                    local: true do |f| %>

      <div class="row g-3">

        <div class="col-lg-4">
          <%= f.search_field :q,
              value: params[:q],
              class: "form-control premium-input",
              placeholder: "🔍 Search anything..." %>
        </div>

        <div class="col-lg-2">
          <%= f.select :feedback_type,
            options_for_select(
              [["All Types",""],
              ["Missing FAQ","missing_faq"],
              ["Missing Product","missing_product"],
              ["Missing Price","missing_price"],
              ["Missing Description","missing_description"],
              ["Missing Policy","missing_policy"],
              ["Missing Delivery","missing_delivery"],
              ["Missing Branch","missing_branch_information"],
              ["Business Guidance","missing_business_guidance"]],
              params[:feedback_type]
            ),
            {},
            class:"form-select premium-input" %>
        </div>

        <div class="col-lg-2">
          <%= f.select :priority,
            options_for_select(
              [["Priority",""],
              ["High","high"],
              ["Medium","medium"],
              ["Low","low"]],
              params[:priority]
            ),
            {},
            class:"form-select premium-input" %>
        </div>

        <div class="col-lg-2">
          <%= f.select :status,
            options_for_select(
              [["Status",""],
              ["Pending","pending"],
              ["Completed","completed"]],
              params[:status]
            ),
            {},
            class:"form-select premium-input" %>
        </div>

        <div class="col-lg-2">
          <%= f.submit "Search",
                class:"btn btn-dark w-100 premium-btn" %>
        </div>

      </div>

      <% end %>
</div>
    </div>
  </div>

  <div class="premium-card">

    <div class="table-responsive">

      <table class="table align-middle premium-table mb-0">

        <thead>

          <tr>
            <th>Action</th>

            <th>Type</th>
            <th>Title</th>
            <th>Priority</th>
            <th>Asked</th>
            <th>Status</th>
            <th>Created</th>
         

          </tr>

        </thead>

        <tbody>

        <% @knowledge_feedbacks.each do |feedback| %>

          <tr>
<td>
  <%= link_to knowledge_feedback_path(feedback),
      class: "btn btn-sm btn-outline-dark rounded-pill" do %>
    <i class="bi bi-eye"></i>
  <% end %>
</td>

            <td>
              <span class="badge bg-primary-subtle text-primary">
                <%= feedback.feedback_type.to_s.humanize %>
              </span>
            </td>

            <td>

              <strong>
                <%= feedback.title %>
              </strong>

              <br>

              <small class="text-muted">
                <%= truncate(feedback.question, length:80) %>
              </small>

            </td>

            <td>

              <%=
              case feedback.priority

              when "high"

                '<span class="badge bg-danger">High</span>'.html_safe

              when "medium"

                '<span class="badge bg-warning text-dark">Medium</span>'.html_safe

              else

                '<span class="badge bg-success">Low</span>'.html_safe

              end

              %>

            </td>

            <td>

              <span class="count-pill">
                <%= feedback.occurrences %>
              </span>

            </td>

            <td>

              <% if feedback.status=="completed" %>

                <span class="badge bg-success">
                  Completed
                </span>

              <% else %>

                <span class="badge bg-secondary">
                  Pending
                </span>

              <% end %>

            </td>

            <td>

              <%= time_ago_in_words(feedback.created_at) %> ago

            </td>

          

          </tr>

        <% end %>

        </tbody>

      </table>

    </div>

  </div>


<!-- Pagination -->
<div class="digg_pagination">

  <div class="d-flex justify-content-center mb-3">
    <%= paginate  @knowledge_feedbacks%>
  </div>

  <div class="d-flex justify-content-center align-items-center gap-2 mb-3">

    <%= form_with url: request.path,
          method: :get,
          local: true,
          id: "rows-per-page-form",
          class: "d-flex align-items-center gap-2" do |f| %>

      <%= f.label :per_page, "Rows per page", class: "mb-0 fw-semibold" %>

      <%= f.select :per_page,
          options_for_select([10, 25, 50, 100, 250, 500, 1000], params[:per_page] || 10),
          {},
          class: "form-select form-select-sm",
          style: "width:100px;",
          id: "rows-per-page" %>

    <% end %>

  </div>

  <div class="text-center text-muted small">
    <%= page_entries_info  @knowledge_feedbacks %>
  </div>

</div>



<script>

  document.addEventListener("DOMContentLoaded", () => {
  const select = document.getElementById("rows-per-page");
  if (select) {
    select.addEventListener("change", () => {
      document.getElementById("rows-per-page-form").submit();
    });
  }
});


</script>












</div>





