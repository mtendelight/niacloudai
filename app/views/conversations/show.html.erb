<%= render "layouts/header" %>

<div class="container-fluid py-3">

  <% other_user = @conversation.sender == current_user ? @conversation.recipient : @conversation.sender %>

  <div class="card border-0 shadow rounded-4 overflow-hidden">

    <%= turbo_stream_from "conversation_#{@conversation.id}" %>

    <!-- HEADER -->
    <div class="chat-header px-4 py-3">

      <div class="d-flex justify-content-between align-items-center">

        <div class="d-flex align-items-center">

          <div class="avatar">
            <%= other_user.username.first.upcase %>
          </div>

          <div class="ms-3">
            <h6 class="mb-0 fw-bold">
              <%= other_user.username.titleize %>
            </h6>

            <small class="text-success d-flex align-items-center">
              <span class="online-dot me-1"></span>
              Online
            </small>

          </div>

        </div>

        <%= link_to conversations_path,
            class: "btn btn-light rounded-pill px-3" do %>
          <i class="bi bi-arrow-left"></i>
          Back
        <% end %>

      </div>

    </div>

    <!-- CHAT -->
    <div
      id="chat-box"
      class="chat-body">

      <div id="messages">
        <%= render @messages %>
      </div>

    </div>

    <!-- INPUT -->
    <div class="chat-footer">

      <%= form_with(model: [@conversation, Message.new], class: "w-100") do |f| %>

        <div class="input-group">

          <%= f.text_field :content,
                class: "form-control chat-input",
                placeholder: "Type your message...",
                autocomplete: "off" %>

          <button class="btn btn-primary px-4">
            <i class="bi bi-send-fill"></i>
          </button>

        </div>

      <% end %>

    </div>

  </div>

</div>

<script>
function scrollToBottom(smooth = false){
  const box = document.getElementById("chat-box");
  if(!box) return;

  box.scrollTo({
    top: box.scrollHeight,
    behavior: smooth ? "smooth" : "auto"
  });
}

document.addEventListener("turbo:load", () => {
  scrollToBottom();
});

document.addEventListener("turbo:render", () => {
  scrollToBottom();
});

document.addEventListener("turbo:before-stream-render", () => {
  setTimeout(() => {
    scrollToBottom(true);
    window.location.reload();
  }, 100);
});
</script>

<style>
  .chat-header{
    background:white;
    position:sticky;
    top:0;
    z-index:100;
    border-bottom:1px solid #ececec;
}

.avatar{
    width:48px;
    height:48px;
    border-radius:50%;
    background:#0d6efd;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    font-size:20px;
}

.chat-body{
    background:#eef2f7;
    height:calc(100vh - 260px);
    overflow-y:auto;
    padding:25px;
    scroll-behavior:smooth;
}

.chat-footer{
    background:white;
    border-top:1px solid #eee;
    padding:15px;
}

.chat-input{
    border-radius:30px;
    border:none;
    background:#f5f6fa;
    padding:14px 18px;
}

.chat-input:focus{
    box-shadow:none;
    background:white;
}

.chat-bubble{
    max-width:75%;
    border-radius:18px;
    padding:10px 14px;
    line-height:1.5;
    font-size:14px;
}

.message-time{
    font-size:11px;
    color:#888;
    margin-top:4px;
    display:block;
    text-align:right;
}

.online-dot{
    width:8px;
    height:8px;
    background:#00c853;
    border-radius:50%;
    display:inline-block;
    animation:pulse 1.5s infinite;
}

@keyframes pulse{
    0%{
        transform:scale(1);
        opacity:1;
    }
    50%{
        transform:scale(1.5);
        opacity:.5;
    }
    100%{
        transform:scale(1);
        opacity:1;
    }
}

::-webkit-scrollbar{
    width:7px;
}

::-webkit-scrollbar-thumb{
    background:#c9c9c9;
    border-radius:10px;
}

@media(max-width:768px){

.chat-body{
    height:calc(100vh - 220px);
    padding:15px;
}

.chat-bubble{
    max-width:90%;
}

}

/* ===============================
   PREMIUM CHAT UI
=================================*/

:root{
    --primary:#2563eb;
    --primary-dark:#1d4ed8;
    --bg:#eef3f8;
    --white:#ffffff;
    --border:#e7edf5;
    --shadow:0 12px 35px rgba(15,23,42,.08);
    --radius:22px;
}

/* Page */
body{
    background:linear-gradient(180deg,#f8fbff,#edf3f9);
}

/* Card */
.chat-card{
    border:none;
    border-radius:24px;
    overflow:hidden;
    box-shadow:var(--shadow);
    background:#fff;
}

/* Header */
.chat-header{
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(18px);
    border-bottom:1px solid var(--border);
    padding:18px 25px;
}

.chat-avatar{
    width:54px;
    height:54px;
    border-radius:50%;
    background:linear-gradient(135deg,#2563eb,#60a5fa);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
    font-weight:700;
    box-shadow:0 8px 18px rgba(37,99,235,.25);
}

.chat-name{
    font-size:17px;
    font-weight:700;
    color:#1f2937;
}

.chat-status{
    font-size:13px;
    color:#16a34a;
}

.online-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:#22c55e;
    display:inline-block;
    margin-right:6px;
    animation:pulse 1.5s infinite;
}

@keyframes pulse{
    0%{transform:scale(1);}
    50%{transform:scale(1.4);}
    100%{transform:scale(1);}
}

/* Chat Area */

.chat-body{
    height:72vh;
    overflow-y:auto;
    background:
        radial-gradient(circle at top right,#dbeafe 0,#eef3f8 45%),
        linear-gradient(#f8fbff,#eef3f8);
    padding:28px;
    scroll-behavior:smooth;
}

/* Sent */

.sent .chat-bubble{
    background:linear-gradient(135deg,#2563eb,#3b82f6);
    color:#fff;
    border-bottom-right-radius:6px;
    margin-left:auto;
}

/* Received */

.received .chat-bubble{
    background:#fff;
    color:#374151;
    border:1px solid #e5e7eb;
    border-bottom-left-radius:6px;
}

/* Bubble */

.chat-bubble{
    max-width:72%;
    padding:13px 18px;
    margin-bottom:15px;
    border-radius:18px;
    font-size:14px;
    line-height:1.65;
    box-shadow:0 6px 20px rgba(0,0,0,.05);
    transition:.25s;
    word-break:break-word;
}

.chat-bubble:hover{
    transform:translateY(-2px);
    box-shadow:0 12px 30px rgba(0,0,0,.10);
}

/* Time */

.message-time{
    font-size:11px;
    margin-top:6px;
    opacity:.75;
    text-align:right;
}

/* Footer */

.chat-footer{
    background:#fff;
    border-top:1px solid var(--border);
    padding:18px;
}

/* Input */

.chat-input{
    border:none;
    border-radius:50px;
    background:#f4f7fb;
    padding:15px 22px;
    font-size:15px;
    transition:.3s;
}

.chat-input:focus{
    background:#fff;
    box-shadow:0 0 0 4px rgba(37,99,235,.12);
}

/* Button */

.send-btn{
    width:58px;
    height:58px;
    border-radius:50%;
    border:none;
    margin-left:10px;
    background:linear-gradient(135deg,#2563eb,#3b82f6);
    color:#fff;
    font-size:20px;
    transition:.3s;
    box-shadow:0 10px 25px rgba(37,99,235,.30);
}

.send-btn:hover{
    transform:translateY(-2px) scale(1.05);
    background:linear-gradient(135deg,#1d4ed8,#2563eb);
}

/* Date Separator */

.chat-date{
    text-align:center;
    margin:20px 0;
}

.chat-date span{
    background:#fff;
    border-radius:50px;
    padding:6px 16px;
    font-size:12px;
    color:#64748b;
    box-shadow:0 5px 15px rgba(0,0,0,.05);
}

/* Scrollbar */

.chat-body::-webkit-scrollbar{
    width:8px;
}

.chat-body::-webkit-scrollbar-thumb{
    background:#cfd8e3;
    border-radius:20px;
}

.chat-body::-webkit-scrollbar-thumb:hover{
    background:#94a3b8;
}

/* Mobile */

@media(max-width:768px){

.chat-body{
    height:68vh;
    padding:15px;
}

.chat-bubble{
    max-width:90%;
}

.chat-avatar{
    width:46px;
    height:46px;
    font-size:18px;
}

.chat-name{
    font-size:15px;
}

.send-btn{
    width:52px;
    height:52px;
}

}
</style>