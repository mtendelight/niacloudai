<%= render "layouts/header" %>

<div class="container py-4">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h3 class="fw-bold mb-0">
        <i class="bi bi-chat-dots-fill text-primary me-2"></i>
        Chats
      </h3>
      <small class="text-muted">
        <i class="bi bi-lightning-charge me-1"></i>
        Stay connected in real-time
      </small>
    </div>

    <%= link_to new_conversation_path,
        class: "btn btn-primary shadow-sm rounded-pill px-3" do %>
      <i class="bi bi-plus-circle me-1"></i> New Chat
    <% end %>

  </div>


  <!-- SEARCH BAR -->
<div class="mb-3">
  <div class="login">
    <%= form_with url: conversations_path, method: :get, local: true do %>
      <div class="input-group shadow-sm">

        <%= text_field_tag :query,
              params[:query],
              class: "form-control border-0",
              placeholder: "Search chats or users..." %>

        <% if params[:query].present? %>
          <%= link_to conversations_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-x-circle"></i>
          <% end %>
        <% end %>

        <button class="btn btn-primary" type="submit">
          <i class="bi bi-search"></i>
        </button>

      </div>
    <% end %>
  </div>
</div>

<style>
  /*==================================================
 PREMIUM CHAT HEADER
==================================================*/

.chat-header-card{

    background:
        linear-gradient(135deg,#ffffff,#f8fbff);

    border-radius:24px;

    padding:35px;

    border:1px solid rgba(255,255,255,.7);

    box-shadow:
        0 20px 45px rgba(15,23,42,.08);

    position:relative;

    overflow:hidden;

}

.chat-header-card::before{

    content:"";

    position:absolute;

    top:-120px;
    right:-120px;

    width:260px;
    height:260px;

    border-radius:50%;

    background:rgba(37,99,235,.08);

}

.chat-logo{

    width:75px;
    height:75px;

    border-radius:22px;

    background:linear-gradient(135deg,#2563eb,#4f8fff);

    display:flex;

    align-items:center;

    justify-content:center;

    color:#fff;

    font-size:34px;

    box-shadow:
        0 15px 35px rgba(37,99,235,.35);

}

.chat-header-card h2{

    font-size:34px;

    color:#0f172a;

}

.chat-header-card p{

    font-size:15px;

    color:#64748b;

}

.new-chat-btn{

    height:56px;

    font-weight:700;

    box-shadow:
        0 12px 28px rgba(37,99,235,.25);

}

.new-chat-btn:hover{

    transform:translateY(-3px);

}

.chat-stat{

    background:#fff;

    border-radius:18px;

    padding:20px;

    display:flex;

    align-items:center;

    gap:18px;

    box-shadow:
        0 10px 25px rgba(15,23,42,.05);

    transition:.3s;

}

.chat-stat:hover{

    transform:translateY(-5px);

}

.chat-stat-icon{

    width:58px;

    height:58px;

    border-radius:18px;

    display:flex;

    align-items:center;

    justify-content:center;

    color:#fff;

    font-size:24px;

}

.chat-stat h4{

    margin:0;

    font-weight:700;

}

.chat-stat small{

    color:#64748b;

}


/*==================================================
 SEARCH
==================================================*/

.search-card{

    background:#fff;

    border-radius:22px;

    padding:18px;

    box-shadow:
        0 15px 35px rgba(15,23,42,.06);

}

.search-wrapper{

    display:flex;

    align-items:center;

    gap:15px;

}

.search-icon{

    color:#2563eb;

    font-size:22px;

}

.search-input{

    flex:1;

    border:none;

    outline:none;

    background:transparent;

    font-size:16px;

}

.search-input:focus{

    box-shadow:none;

}

.search-input::placeholder{

    color:#94a3b8;

}


/*==================================================
 MOBILE
==================================================*/

@media(max-width:768px){

.chat-header-card{

padding:22px;

}

.chat-header-card h2{

font-size:26px;

}

.chat-logo{

width:60px;

height:60px;

font-size:28px;

}

.chat-stat{

margin-bottom:12px;

}

.search-wrapper{

flex-wrap:wrap;

}

.search-input{

width:100%;

}

.new-chat-btn{

width:100%;

margin-top:20px;

}

}
</style>

  <!-- CARD -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

    <div class="list-group list-group-flush">

      <% if @conversations.empty? %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-chat-square-dots display-6 d-block mb-2"></i>
          <h6 class="mb-1">No conversations yet</h6>
          <small>Start a new chat and connect instantly 💬</small>
        </div>
      <% end %>

      <% @conversations.each do |conversation| %>
        <% next unless conversation.sender && conversation.recipient %>

        <% other_user = conversation.sender == current_user ? conversation.recipient : conversation.sender %>
        <% last_message = conversation.messages.last %>
        <% unread = conversation.unread_count_for(current_user) %>

        <%= link_to conversation_messages_path(conversation),
            class: "
              list-group-item list-group-item-action border-0 py-3 px-3
              d-flex align-items-center gap-3
              conversation-item
              #{'unread-chat' if unread > 0}
            " do %>

          <!-- AVATAR -->
          <div class="position-relative flex-shrink-0">

           <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm conversation-avatar">
  <%= (other_user&.username || "U")[0].upcase %>
</div>

            <!-- online dot -->
           <span class="position-absolute bottom-0 end-0 bg-success border border-3 border-white rounded-circle shadow"
      style="width:12px;height:12px;"></span>

      

          </div>

          <!-- CONTENT -->
          <div class="flex-grow-1 min-w-0">

            <!-- TOP ROW -->
            <div class="d-flex justify-content-between align-items-center">

             <!-- USER -->
<div class="fw-semibold text-truncate">
  <i class="bi bi-person-circle me-1 text-primary"></i>
  <%= other_user&.username || "Deleted User" %>
</div>

              <div class="d-flex align-items-center gap-2">

                <% if last_message %>
                 <!-- TIME -->
<small class="text-secondary">
  <i class="bi bi-clock-fill text-warning me-1"></i>
  <%= time_ago_in_words(last_message.created_at) %>
</small>
                <% end %>

                <% if unread > 0 %>
                  <span class="badge bg-danger rounded-pill shadow-sm unread-badge">
                    <%= unread %>
                  </span>
                <% end %>

              </div>

            </div>

            <!-- LAST MESSAGE -->
            <div class="d-flex justify-content-between align-items-center mt-1">

           <!-- LAST MESSAGE -->
<div class="text-muted small text-truncate">

  <% if last_message %>

    <% if last_message.user == current_user %>
      <i class="bi bi-check2-all text-primary me-1"></i>
      <span class="fw-semibold text-secondary">You:</span>
    <% else %>
      <i class="bi bi-chat-left-dots-fill text-success me-1"></i>
    <% end %>

    <%= last_message.content %>

  <% else %>

    <i class="bi bi-chat-heart-fill text-info me-1"></i>
    No messages yet

  <% end %>

</div>

              <% if unread > 0 %>
                <span class="badge bg-danger rounded-pill unread-badge-mobile">
                  <%= unread %>
                </span>
              <% end %>

            </div>

          </div>

        <% end %>

      <% end %>

    </div>
  </div>
</div>

<style>
  /* ==========================================
   PREMIUM CONVERSATION LIST
========================================== */

.card{
    background:transparent;
    border:none!important;
    box-shadow:none!important;
}

.list-group{
    gap:14px;
    background:transparent;
}

.conversation-item{

    position:relative;

    display:flex!important;

    align-items:center;

    gap:18px;

    padding:18px!important;

    margin-bottom:12px;

    border:none!important;

    border-radius:22px!important;

    background:rgba(255,255,255,.92);

    backdrop-filter:blur(18px);

    -webkit-backdrop-filter:blur(18px);

    box-shadow:
        0 12px 35px rgba(15,23,42,.08);

    transition:.30s ease;

    overflow:hidden;

}

.conversation-item:before{

    content:"";

    position:absolute;

    left:0;

    top:0;

    bottom:0;

    width:5px;

    background:transparent;

    transition:.30s;

}

.conversation-item:hover{

    transform:translateY(-4px);

    box-shadow:
        0 20px 45px rgba(37,99,235,.15);

}

.conversation-item:hover:before{

    background:#2563eb;

}

/* ==========================================
   UNREAD
========================================== */

.unread-chat{

    background:
        linear-gradient(90deg,#eff6ff,#ffffff)!important;

}

.unread-chat:before{

    background:#2563eb!important;

}

/* ==========================================
   AVATAR
========================================== */

.conversation-item .rounded-circle{

    width:60px!important;

    height:60px!important;

    font-size:22px;

    background:
        linear-gradient(135deg,#2563eb,#60a5fa)!important;

    box-shadow:
        0 10px 22px rgba(37,99,235,.28);

}

/* ==========================================
   ONLINE DOT
========================================== */

.conversation-item .bg-success{

    width:15px!important;

    height:15px!important;

    border:3px solid #fff!important;

    animation:pulseOnline 1.8s infinite;

}

@keyframes pulseOnline{

0%{

box-shadow:0 0 0 0 rgba(34,197,94,.5);

}

70%{

box-shadow:0 0 0 12px rgba(34,197,94,0);

}

100%{

box-shadow:0 0 0 0 rgba(34,197,94,0);

}

}

/* ==========================================
   USERNAME
========================================== */

.conversation-item .fw-semibold{

    font-size:17px;

    color:#0f172a;

}

.conversation-item .fw-semibold i{

    color:#94a3b8!important;

}

/* ==========================================
   LAST MESSAGE
========================================== */

.conversation-item .small{

    font-size:13px;

    color:#64748b!important;

}

.conversation-item .small i{

    color:#2563eb;

}

/* ==========================================
   TIME
========================================== */

.conversation-item small{

    font-size:12px;

    color:#94a3b8!important;

}

/* ==========================================
   BADGES
========================================== */

.unread-badge,
.unread-badge-mobile{

    min-width:28px;

    height:28px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:999px!important;

    background:
        linear-gradient(135deg,#ef4444,#dc2626)!important;

    box-shadow:
        0 8px 18px rgba(239,68,68,.28);

    font-size:12px;

    font-weight:700;

}

/* ==========================================
   EMPTY STATE
========================================== */

.text-center.py-5{

    background:rgba(255,255,255,.92);

    border-radius:24px;

    padding:70px 20px!important;

    box-shadow:
        0 15px 40px rgba(15,23,42,.08);

}

.text-center.py-5 i{

    font-size:70px;

    color:#2563eb;

    margin-bottom:20px;

}

.text-center.py-5 h6{

    font-size:22px;

    color:#0f172a;

}

.text-center.py-5 small{

    color:#64748b;

}

/* ==========================================
   MOBILE
========================================== */

@media(max-width:768px){

.conversation-item{

padding:14px!important;

border-radius:18px!important;

}

.conversation-item .rounded-circle{

width:50px!important;

height:50px!important;

font-size:18px;

}

.conversation-item .fw-semibold{

font-size:15px;

}

.conversation-item small{

display:none;

}

.unread-badge{

display:none!important;

}

.unread-badge-mobile{

display:flex!important;

}

}
</style>


<div class="container py-3">



  <div class="notepad">

    <div class="notepad-header">
      📝 Today's Tasks — <%= Date.current.strftime("%A, %d %B %Y") %>
    </div>



<div class="login">

    <%= form_with model: DailyTask.new,
      url: daily_tasks_path,
      local: true,
      class: "mb-3" do |f| %>

  <%= f.hidden_field :task_date, value: Date.current %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-2">
      <div class="row g-2 align-items-center">

        <!-- Task -->
        <div class="col">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white">
              <i class="bi bi-check2-square text-primary"></i>
            </span>
            <%= f.text_field :title,
                  class: "form-control",
                  placeholder: "Enter task...",
                  required: true %>
          </div>
        </div>

        <!-- Due Date -->
        <div class="col-auto">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white">
              <i class="bi bi-calendar-event text-danger"></i>
            </span>
            <%= f.date_field :due_date,
                  value: Date.current,
                  class: "form-control",
                  required: true %>
          </div>
        </div>

        <!-- Status -->
        <div class="col-auto">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white">
              <i class="bi bi-flag text-success"></i>
            </span>
            <%= f.select :status,
                  DailyTask.statuses.keys.map { |s| [s.humanize, s] },
                  {},
                  class: "form-select" %>
          </div>
        </div>

        <!-- Add -->
        <div class="col-auto">
          <%= f.submit "Add Task",
                class: "btn btn-primary btn-sm px-3" %>
        </div>

      </div>
    </div>
  </div>

<% end %>
</div>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body p-2">
    <div class="login">
    <%= form_with url: conversations_path, method: :get, local: true do %>
      <div class="input-group input-group-sm">

        <span class="input-group-text bg-white border-end-0">
          <i class="bi bi-search text-muted"></i>
        </span>

        <%= text_field_tag :query,
              params[:query],
              class: "form-control border-start-0",
              placeholder: "Search conversations or tasks..." %>

        <% if params[:query].present? %>
          <%= link_to conversations_path,
                class: "btn btn-outline-secondary",
                title: "Clear search" do %>
            <i class="bi bi-x-lg"></i>
          <% end %>
        <% end %>

        <%= submit_tag "Search", class: "btn btn-primary" %>

      </div>
    <% end %></div>
  </div>
</div>

<hr class="my-4">



<style>
    .login .form-control,
.login .form-select {
  border-radius: 12px;
  border: 1px solid #dee2e6;
}

.login .form-control:focus,
.login .form-select:focus {
  border-color: #0d6efd;
  box-shadow: 0 0 0 .2rem rgba(13,110,253,.15);
}

.login .btn-primary {
  border-radius: 12px;
  font-weight: 600;
  min-height: 58px;
}

.login .form-floating > label {
  font-size: .9rem;
}
</style>
<% @today_tasks.each_with_index do |task, index| %>

  <% overdue = task.due_date.present? &&
                task.due_date < Date.current &&
                task.status != "completed" %>

  <% due_today = task.due_date == Date.current &&
                 task.status != "completed" %>

  <div class="d-flex align-items-stretch mb-2">

    <!-- Number + Eye -->
    <div class="task-number d-flex flex-column align-items-center justify-content-center">

      <div class="fw-bold fs-6">
        <%= index + 1 %>
    

      <% if overdue %>
        <i class="bi bi-eye-fill text-danger fs-5 mt-1" title="Overdue"></i>
      <% elsif due_today %>
        <i class="bi bi-eye-fill text-warning fs-5 mt-1" title="Due Today"></i>
      <% else %>
        <i class="bi bi-eye-fill text-success fs-5 mt-1" title="On Schedule"></i>
      <% end %>  </div>

    </div>

    <!-- Task -->
    <div class="card flex-grow-1 shadow-sm border-0
      <%=
        case task.status
        when "pending"
          "border-start border-5 border-warning bg-warning-subtle"
        when "in_progress"
          "border-start border-5 border-primary bg-primary-subtle"
        when "completed"
          "border-start border-5 border-success bg-success-subtle"
        end
      %>">

      <div class="card-body py-2 px-3">
        <div class="login">

        <%= form_with model: task, local: true do |f| %>

          <div class="row align-items-center g-2">

            <!-- Task Title -->
            <div class="col-lg">

              <div class="d-flex justify-content-between align-items-start">

                <div class="flex-grow-1 pe-3">

                  <div class="fw-bold fs-6 text-break">
                    <%= task.title %>
                  </div>

              

                </div>

         

              </div>

            </div>

<!-- Status -->
<div class="col-md-3 col-lg-2">


      <i class="bi bi-flag text-success"></i>


 <%= f.select :status,
      DailyTask.statuses.keys.map { |s| [s.humanize, s] },
      { prompt: "Select status" },
      class: "form-select form-select-sm fw-semibold" %>

</div>

            <!-- Due Date -->
            <div class="col-md-3 col-lg-2">
              <%= f.date_field :due_date,
                    class: "form-control form-control-sm" %>

                        <div class="mt-2 d-flex flex-wrap gap-2">

               <span class="badge <%= overdue ? 'bg-danger' : due_today ? 'bg-warning text-dark' : task.due_date.present? ? 'bg-success' : 'bg-secondary' %>"
      style="font-size: 10px; padding: 2px 5px;">
  <i class="bi bi-calendar<%= overdue ? '-x' : due_today ? '-event' : '-check' %>"></i>
  <%= task.due_date.present? ? (due_today ? 'Today' : task.due_date.strftime("%d %b")) : 'No Date' %>
</span>

                  </div>
            </div>

            <!-- Position -->
            <div class="col-auto">
              <%= f.number_field :position,
                    min: 1,
                    class: "form-control form-control-sm text-center",
                    style: "width:65px;" %>
            </div>

            <!-- Save -->
            <div class="col-auto">
              <%= f.submit "✓",
                    class: "btn btn-success btn-sm px-3" %>
            </div>

            <!-- Move -->
            <div class="col-auto">

              <div class="btn-group btn-group-sm">

                <%= link_to move_up_daily_task_path(task),
                      data: { turbo_method: :patch },
                      class: "btn btn-light border",
                      title: "Move Up" do %>
                  <i class="bi bi-chevron-up"></i>
                <% end %>

                <%= link_to move_down_daily_task_path(task),
                      data: { turbo_method: :patch },
                      class: "btn btn-light border",
                      title: "Move Down" do %>
                  <i class="bi bi-chevron-down"></i>
                <% end %>

              </div>

            </div>

          </div>

        <% end %>

      </div>

    </div>

  </div></div>

<% end %>

