<%= render "layouts/header" %>

<div class="container py-4">
<div class="container mt-4">
  <h4>Start Chat</h4>
<div class="login">
  <%= form_with(model: @conversation, local: true) do |f| %>

<div class="mb-3">
  <%= f.label :recipient_id, "Select User", class: "form-label fw-semibold" %>

  <%= f.collection_select :recipient_id,
    User.joins(:roles)
        .where(roles: { name: ["superadmin", "manager", "admin"] })
        .where.not(id: current_user.id)
        .distinct
        .order(username: :asc),
    :id,
    :username,
    { prompt: "👤 Choose user to chat with..." },
    { class: "form-select shadow-sm elena" } %>




  <small class="text-muted">Start a conversation with a selected user</small>
</div>
    <%= f.submit "Chat", class: "btn btn-primary" %>

  <% end %>
</div></div>