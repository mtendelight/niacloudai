<div class="period-toolbar mb-4">

  <!-- HEADER -->
  <div class="period-header">

    <div class="period-title">

      <div class="period-title-icon">
        <i class="bi bi-clock-history"></i>
      </div>

      <div>
        <h6 class="mb-0 fw-bold">
          Lead Activity
        </h6>

        <small class="text-muted">
          Click a period to view customers contacted
        </small>
      </div>

    </div>

    <span class="period-hint">
      <i class="bi bi-hand-index-thumb"></i>
      Select period
    </span>

  </div>


  <!-- PERIOD CARDS -->
  <div class="period-cards">

    <!-- TODAY -->
    <%= link_to jmleads_path(period: "today"),
        class: "period-card #{'active' if params[:period] == 'today'}" do %>

      <div class="period-card-icon">
        <i class="bi bi-calendar-day-fill"></i>
      </div>

      <div class="period-card-content">
        <span class="period-card-title">
          Today
        </span>

        <span class="period-card-subtitle">
          Customers contacted today
        </span>
      </div>

      <i class="bi bi-chevron-right period-card-arrow"></i>

    <% end %>


    <!-- YESTERDAY -->
    <%= link_to jmleads_path(period: "yesterday"),
        class: "period-card #{'active' if params[:period] == 'yesterday'}" do %>

      <div class="period-card-icon">
        <i class="bi bi-calendar-minus-fill"></i>
      </div>

      <div class="period-card-content">
        <span class="period-card-title">
          Yesterday
        </span>

        <span class="period-card-subtitle">
          Customers contacted yesterday
        </span>
      </div>

      <i class="bi bi-chevron-right period-card-arrow"></i>

    <% end %>


    <!-- THIS WEEK -->
    <%= link_to jmleads_path(period: "week"),
        class: "period-card #{'active' if params[:period] == 'week'}" do %>

      <div class="period-card-icon">
        <i class="bi bi-calendar-week-fill"></i>
      </div>

      <div class="period-card-content">
        <span class="period-card-title">
          This Week
        </span>

        <span class="period-card-subtitle">
          Customers contacted this week
        </span>
      </div>

      <i class="bi bi-chevron-right period-card-arrow"></i>

    <% end %>


    <!-- THIS MONTH -->
    <%= link_to jmleads_path(period: "month"),
        class: "period-card #{'active' if params[:period] == 'month'}" do %>

      <div class="period-card-icon">
        <i class="bi bi-calendar3"></i>
      </div>

      <div class="period-card-content">
        <span class="period-card-title">
          This Month
        </span>

        <span class="period-card-subtitle">
          Customers contacted this month
        </span>
      </div>

      <i class="bi bi-chevron-right period-card-arrow"></i>

    <% end %>

  </div>


  <!-- SPECIFIC DATE -->
  <div class="period-date-section">

    <div class="period-date-label">
      <i class="bi bi-calendar-event"></i>
      <span>Check a specific date</span>
    </div>

    <%= form_with url: jmleads_path,
        method: :get,
        local: true,
        class: "period-date-form" do %>

      <%= hidden_field_tag :period, "date" %>

      <div class="period-date-input">

        <i class="bi bi-calendar3"></i>

        <%= date_field_tag :date,
            params[:date],
            class: "form-control",
            aria: {
              label: "Select date"
            } %>

      </div>

      <%= button_tag class: "period-open-btn" do %>
        <i class="bi bi-search"></i>
        <span>View Customers</span>
      <% end %>

    <% end %>

  </div>

</div>


<style>

/* =========================================================
   PERIOD TOOLBAR
========================================================= */

.period-toolbar {
  background: #fff;
  border: 1px solid #edf0f4;
  border-radius: 18px;
  padding: 16px;
  box-shadow:
    0 4px 18px rgba(15, 23, 42, .05);
}


/* =========================================================
   HEADER
========================================================= */

.period-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 14px;
}

.period-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.period-title-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  background: #eef4ff;
  color: #0d6efd;

  font-size: 16px;
}

.period-title h6 {
  font-size: .92rem;
}

.period-title small {
  display: block;
  margin-top: 2px;
  font-size: .72rem;
}

.period-hint {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  padding: 6px 10px;

  border-radius: 20px;

  background: #f8f9fa;

  color: #6c757d;

  font-size: .67rem;
  font-weight: 600;
}


/* =========================================================
   PERIOD CARDS
========================================================= */

.period-cards {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 9px;
}


/* =========================================================
   CARD
========================================================= */

.period-card {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 11px 12px;

  border: 1px solid #e9ecef;
  border-radius: 12px;

  background: #fff;

  color: #343a40;
  text-decoration: none;

  transition:
    transform .18s ease,
    border-color .18s ease,
    box-shadow .18s ease,
    background .18s ease;
}

.period-card:hover {
  color: #343a40;
  text-decoration: none;

  border-color: #b9d2ff;

  background: #f8fbff;

  transform: translateY(-2px);

  box-shadow:
    0 7px 16px rgba(13, 110, 253, .08);
}


/* =========================================================
   ACTIVE
========================================================= */

.period-card.active {
  color: #fff;

  border-color: #0d6efd;

  background:
    linear-gradient(
      135deg,
      #0d6efd,
      #3b82f6
    );

  box-shadow:
    0 7px 18px rgba(13, 110, 253, .20);
}

.period-card.active:hover {
  color: #fff;
}


/* =========================================================
   ICON
========================================================= */

.period-card-icon {
  width: 34px;
  height: 34px;

  flex: 0 0 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background: #f1f5ff;
  color: #0d6efd;

  font-size: 14px;
}

.period-card.active .period-card-icon {
  background: rgba(255,255,255,.18);
  color: #fff;
}


/* =========================================================
   CONTENT
========================================================= */

.period-card-content {
  min-width: 0;
  flex: 1;
}

.period-card-title {
  display: block;

  font-size: .78rem;
  font-weight: 800;

  white-space: nowrap;
}

.period-card-subtitle {
  display: block;

  margin-top: 2px;

  font-size: .61rem;

  color: #8a94a6;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.period-card.active .period-card-subtitle {
  color: rgba(255,255,255,.78);
}


/* =========================================================
   ARROW
========================================================= */

.period-card-arrow {
  flex: 0 0 auto;

  color: #adb5bd;

  font-size: 11px;

  transition: transform .18s ease;
}

.period-card:hover .period-card-arrow {
  color: #0d6efd;
  transform: translateX(2px);
}

.period-card.active .period-card-arrow {
  color: rgba(255,255,255,.85);
}


/* =========================================================
   SPECIFIC DATE
========================================================= */

.period-date-section {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin-top: 12px;

  padding-top: 12px;

  border-top: 1px solid #f0f1f3;
}

.period-date-label {
  display: flex;
  align-items: center;

  gap: 7px;

  color: #6c757d;

  font-size: .72rem;
  font-weight: 600;

  white-space: nowrap;
}

.period-date-label i {
  color: #0d6efd;
}


/* =========================================================
   DATE FORM
========================================================= */

.period-date-form {
  display: flex;

  align-items: center;

  gap: 7px;
}

.period-date-input {
  display: flex;
  align-items: center;

  height: 36px;

  padding: 0 10px;

  border: 1px solid #dee2e6;
  border-radius: 9px;

  background: #fff;
}

.period-date-input i {
  color: #0d6efd;
  font-size: 13px;

  margin-right: 7px;
}

.period-date-input .form-control {
  width: 145px;

  height: 34px;

  padding: 0;

  border: 0 !important;

  box-shadow: none !important;

  font-size: .72rem;
}


/* =========================================================
   VIEW BUTTON
========================================================= */

.period-open-btn {
  height: 36px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 6px;

  padding: 0 13px;

  border: 0;
  border-radius: 9px;

  background: #0d6efd;
  color: #fff;

  font-size: .7rem;
  font-weight: 700;

  transition: .18s ease;
}

.period-open-btn:hover {
  background: #0b5ed7;

  transform: translateY(-1px);

  box-shadow:
    0 5px 12px rgba(13,110,253,.18);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1000px) {

  .period-cards {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .period-toolbar {
    padding: 12px;
    border-radius: 14px;
  }

  .period-header {
    margin-bottom: 10px;
  }

  .period-title-icon {
    width: 34px;
    height: 34px;
    font-size: 14px;
  }

  .period-title h6 {
    font-size: .82rem;
  }

  .period-title small {
    font-size: .64rem;
  }

  .period-hint {
    display: none;
  }

  .period-cards {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 7px;
  }

  .period-card {
    padding: 9px;
    gap: 7px;
    border-radius: 10px;
  }

  .period-card-icon {
    width: 30px;
    height: 30px;
    flex-basis: 30px;
    font-size: 12px;
  }

  .period-card-title {
    font-size: .7rem;
  }

  .period-card-subtitle {
    font-size: .56rem;
  }

  .period-card-arrow {
    display: none;
  }

  .period-date-section {
    display: block;
  }

  .period-date-label {
    margin-bottom: 7px;
  }

  .period-date-form {
    width: 100%;
  }

  .period-date-input {
    flex: 1;
  }

  .period-date-input .form-control {
    width: 100%;
  }

  .period-open-btn {
    padding: 0 11px;
  }

  .period-open-btn span {
    display: none;
  }

}

</style>

<nav class="premium-leads-menu">

  <!-- ALL LEADS -->
  <%= link_to jmleads_path,
      class: "lead-menu-item #{'active' if params[:filter].blank?}",
      id: "menu_all",
      data: { loading_text: "Loading All Leads..." } do %>

    <div class="lead-menu-icon blue">
      <i class="bi bi-clipboard-data-fill"></i>
    </div>

    <div class="lead-menu-content">
      <strong>All Leads</strong>
      <small>
        <%= number_with_delimiter(Jmlead.count) %> total
      </small>
    </div>

    <div class="lead-menu-arrow">
      <i class="bi bi-chevron-right"></i>
    </div>

    <%= image_tag "/icons/poss.svg",
          size: "18x18",
          alt: "Loading",
          class: "menu-loading d-none" %>

  <% end %>


  <!-- OPEN LEADS -->
  <%= link_to jmleads_path(filter: "open"),
      class: "lead-menu-item #{'active' if params[:filter] == 'open'}",
      id: "menu_open",
      data: { loading_text: "Loading Open Leads..." } do %>

    <div class="lead-menu-icon orange">
      <i class="bi bi-folder2-open"></i>
    </div>

    <div class="lead-menu-content">
      <strong>Open Leads</strong>
      <small>
        <%= number_with_delimiter(Jmlead.where(status: "open").count) %> pending
      </small>
    </div>

    <div class="lead-menu-arrow">
      <i class="bi bi-chevron-right"></i>
    </div>

    <%= image_tag "/icons/poss.svg",
          size: "18x18",
          alt: "Loading",
          class: "menu-loading d-none" %>

  <% end %>


  <!-- CONVERTED -->
  <%= link_to jmleads_path(filter: "converted"),
      class: "lead-menu-item #{'active' if params[:filter] == 'converted'}",
      id: "menu_converted",
      data: { loading_text: "Loading Converted Leads..." } do %>

    <div class="lead-menu-icon green">
      <i class="bi bi-patch-check-fill"></i>
    </div>

    <div class="lead-menu-content">
      <strong>Converted</strong>

      <small>
        <%= number_with_delimiter(@converted_count) %> won

        <span class="conversion-pill">
          <%= @conversion_rate %>%
        </span>
      </small>
    </div>

    <div class="lead-menu-arrow">
      <i class="bi bi-chevron-right"></i>
    </div>

    <%= image_tag "/icons/poss.svg",
          size: "18x18",
          alt: "Loading",
          class: "menu-loading d-none" %>

  <% end %>


  <!-- UNCONTACTED -->
  <%= link_to jmleads_path(filter: "uncontacted"),
      class: "lead-menu-item uncontacted #{'active' if params[:filter] == 'uncontacted'}",
      id: "menu_uncontacted",
      data: { loading_text: "Loading Uncontacted Leads..." } do %>

    <div class="lead-menu-icon red">
      <i class="bi bi-person-x-fill"></i>
    </div>

    <div class="lead-menu-content">
      <strong>Uncontacted</strong>

      <small>
        <% if @uncontacted_count.to_i > 0 %>
          <%= number_with_delimiter(@uncontacted_count) %> waiting
        <% else %>
          All contacted
        <% end %>
      </small>
    </div>

    <% if @uncontacted_count.to_i > 0 %>
      <span class="lead-alert">
        <%= @uncontacted_count %>
      </span>
    <% end %>

    <div class="lead-menu-arrow">
      <i class="bi bi-chevron-right"></i>
    </div>

    <%= image_tag "/icons/poss.svg",
          size: "18x18",
          alt: "Loading",
          class: "menu-loading d-none" %>

  <% end %>


  <!-- WHATSAPP AI -->
  <%= link_to "/ailogs",
      class: "lead-menu-item #{'active' if request.path == '/ailogs'}",
      id: "menu_ailogs",
      data: { loading_text: "Loading WhatsApp AI Logs..." } do %>

    <div class="lead-menu-icon whatsapp">
      <i class="bi bi-whatsapp"></i>
    </div>

    <div class="lead-menu-content">
      <strong>WhatsApp AI</strong>
      <small>Conversation logs</small>
    </div>

    <div class="lead-menu-arrow">
      <i class="bi bi-chevron-right"></i>
    </div>

    <%= image_tag "/icons/poss.svg",
          size: "18x18",
          alt: "Loading",
          class: "menu-loading d-none" %>

  <% end %>

</nav>


<style>

/* =========================================================
   PREMIUM LEADS MENU
========================================================= */

.premium-leads-menu {

  display: grid;

  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  gap: 10px;

  width: 100%;

  margin-bottom: 18px;
}


/* =========================================================
   MENU CARD
========================================================= */

.lead-menu-item {

  position: relative;

  min-width: 0;
  min-height: 70px;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 10px 12px;

  border: 1px solid #e8edf3;
  border-radius: 14px;

  background: #fff;

  color: #172033;

  text-decoration: none !important;

  overflow: hidden;

  box-shadow:
    0 3px 12px rgba(15, 23, 42, .035);

  transition:
    transform .18s ease,
    box-shadow .18s ease,
    border-color .18s ease,
    background .18s ease;
}


/* =========================================================
   HOVER
========================================================= */

.lead-menu-item:hover {

  color: #172033;

  transform: translateY(-2px);

  border-color: #cbd5e1;

  box-shadow:
    0 8px 20px rgba(15, 23, 42, .08);
}


/* =========================================================
   ACTIVE
========================================================= */

.lead-menu-item.active {

  color: #fff;

  border-color: transparent;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #3b82f6
    );

  box-shadow:
    0 10px 24px rgba(37, 99, 235, .20);
}

.lead-menu-item.active:hover {
  color: #fff;
}

.lead-menu-item.active
.lead-menu-content strong,
.lead-menu-item.active
.lead-menu-content small {

  color: #fff;
}


/* =========================================================
   ICON
========================================================= */

.lead-menu-icon {

  width: 38px;
  height: 38px;

  flex: 0 0 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  font-size: 15px;

  transition: .18s ease;
}

.lead-menu-item.active
.lead-menu-icon {

  background: rgba(255,255,255,.17);
  color: #fff;
}


/* COLORS */

.lead-menu-icon.blue {
  background: #eaf2ff;
  color: #2563eb;
}

.lead-menu-icon.orange {
  background: #fff1e6;
  color: #ea580c;
}

.lead-menu-icon.green {
  background: #eafaf0;
  color: #16a34a;
}

.lead-menu-icon.red {
  background: #fff0f1;
  color: #dc2626;
}

.lead-menu-icon.whatsapp {
  background: #e9f9ef;
  color: #16a34a;
}


/* =========================================================
   CONTENT
========================================================= */

.lead-menu-content {

  min-width: 0;

  flex: 1;

  display: flex;
  flex-direction: column;
}

.lead-menu-content strong {

  font-size: .78rem;

  font-weight: 800;

  line-height: 1.2;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lead-menu-content small {

  margin-top: 3px;

  color: #7b8798;

  font-size: .64rem;

  font-weight: 600;

  line-height: 1.2;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


/* =========================================================
   CONVERSION %
========================================================= */

.conversion-pill {

  display: inline-flex;

  align-items: center;

  margin-left: 4px;

  padding: 2px 6px;

  border-radius: 999px;

  background: #dcfce7;

  color: #15803d;

  font-size: .55rem;

  font-weight: 800;
}

.lead-menu-item.active
.conversion-pill {

  background: rgba(255,255,255,.18);

  color: #fff;
}


/* =========================================================
   UNCONTACTED ALERT
========================================================= */

.lead-alert {

  min-width: 23px;
  height: 23px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 0 6px;

  border-radius: 999px;

  background: #dc2626;

  color: #fff;

  font-size: .62rem;

  font-weight: 900;

  box-shadow:
    0 3px 8px rgba(220,38,38,.25);

  flex-shrink: 0;
}

.lead-menu-item.uncontacted:not(.active) {

  border-color: #fecaca;

  background: #fffafa;
}

.lead-menu-item.uncontacted.active
.lead-alert {

  background: rgba(255,255,255,.20);
}


/* =========================================================
   ARROW
========================================================= */

.lead-menu-arrow {

  flex: 0 0 auto;

  color: #adb5bd;

  font-size: 10px;

  transition:
    transform .18s ease,
    color .18s ease;
}

.lead-menu-item:hover
.lead-menu-arrow {

  color: #2563eb;

  transform: translateX(2px);
}

.lead-menu-item.active
.lead-menu-arrow {

  color: rgba(255,255,255,.8);
}


/* =========================================================
   LOADING
========================================================= */

.menu-loading {

  position: absolute;

  right: 10px;

  top: 50%;

  transform: translateY(-50%);

  z-index: 3;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) {

  .premium-leads-menu {

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  .premium-leads-menu {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 7px;

  }

  .lead-menu-item {

    min-height: 62px;

    padding: 8px 9px;

    border-radius: 12px;

    gap: 8px;

  }

  .lead-menu-icon {

    width: 32px;
    height: 32px;

    flex-basis: 32px;

    border-radius: 9px;

    font-size: 13px;

  }

  .lead-menu-content strong {

    font-size: .68rem;

  }

  .lead-menu-content small {

    font-size: .57rem;

  }

  .lead-menu-arrow {

    display: none;

  }

  .lead-alert {

    min-width: 20px;
    height: 20px;

    font-size: .55rem;

  }

}


/* =========================================================
   VERY SMALL SCREENS
========================================================= */

@media (max-width: 400px) {

  .premium-leads-menu {

    gap: 6px;

  }

  .lead-menu-item {

    padding: 8px;

  }

  .lead-menu-icon {

    width: 30px;
    height: 30px;

    flex-basis: 30px;

  }

  .lead-menu-content strong {

    font-size: .64rem;

  }

  .lead-menu-content small {

    font-size: .53rem;

  }

}

</style>


<script>

document.addEventListener("DOMContentLoaded", function(){

  const menuItems = document.querySelectorAll(".lead-menu-item");

  menuItems.forEach(item => {

    item.addEventListener("click", function(){

      const loader = item.querySelector(".menu-loading");

      if(loader){

        loader.classList.remove("d-none");

      }

    });

  });

});

</script>

<style>
  /* ===============================
   PREMIUM LEADS NAVIGATION
=================================*/

.premium-leads-menu{
    display:grid;
    gap:12px;
    margin:12px 0 20px;
}

/* ===============================
   CARD
=================================*/

.lead-menu-item{
    display:flex;
    align-items:center;
    gap:12px;

    position:relative;

    padding:14px;

    background:#fff;

    border:1px solid #e9ecef;

    border-radius:18px;

    text-decoration:none;

    color:#212529;

    transition:.25s ease;

    overflow:hidden;

    min-height:74px;
}

