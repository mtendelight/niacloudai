Name: <%= @jmlead.jmcustomer&.name.presence || @jmlead.name.presence || "Lead Customer" %>
Phone: <%= @jmlead.phone %>

Last Messages:
<% messages.each do |m| %>
• <%= m[:body].to_s.strip %>
<% end %>

Link:
<%= jmlead_url(@jmlead) %>
  </textarea>



<%= link_to conversation_jmlead_path(@jmlead),
