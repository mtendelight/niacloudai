            </td>

            <td class="text-center">
              <%= link_to jmcustomer_path(@jmlead.jmcustomer),
                    class: "btn btn-sm btn-outline-success" do %>
                <i class="bi bi-eye"></i>
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <!-- Show convert button if no customer -->
  <div class="text-center mt-3">
    <span class="text-muted">No customer linked</span><br>

    <% if @jmlead.open? %>
      <%= link_to new_jmcustomer_path(
            name: @jmlead.name,
            phone: @jmlead.phone
          ),
          class: "btn btn-success btn-sm mt-2" do %>
        <i class="bi bi-person-plus-fill"></i> Convert to Customer
      <% end %>
    <% end %>
  </div>
<% end %>


<% (@audits || []).each do |audit| %>

  <% hidden_fields = %w[
    comments
    conversation
    created_at
    updated_at
  ] %>

  <% visible_changes = audit.audited_changes.to_h.reject do |attr, _|
       hidden_fields.include?(attr)
     end %>

  <% next if audit.action != "create" && visible_changes.blank? %>

  <li class="audit-log-item mb-2 p-2 shadow-sm rounded bg-light">

    <div class="audit-header mb-1 small">
      <span>
        👤 <strong>User:</strong>
        <%= audit.user&.username || "Unknown" %>
      </span>
      |
      <span>
        ⏰ <%= audit.created_at.strftime("%d %b %Y, %I:%M %p") %>
      </span>
      |
      <span>
        📄 <%= audit.action.titleize %>
      </span>
    </div>

    <% if visible_changes.present? %>

      <div class="audit-changes ps-2 small">

        <% visible_changes.each do |attr, values| %>

          <% old_val, new_val = values.is_a?(Array) ? values : [nil, values] %>

          <% if attr == "jstaff_id" %>
            <% old_val = Jstaff.find_by(id: old_val)&.name || "Unassigned" %>
            <% new_val = Jstaff.find_by(id: new_val)&.name || "Unassigned" %>
            <% attr = "Assigned To" %>
          <% end %>

          <div class="change mb-1">
            🔹 <strong><%= attr.titleize %></strong>

            <span class="text-muted"><%= old_val.presence || "—" %></span>
            →

            <span class="text-success"><%= new_val.presence || "—" %></span>
          </div>

        <% end %>

      </div>

    <% elsif audit.action == "create" %>

      <div class="audit-changes ps-2 small">
        <em>Lead created.</em>
      </div>

    <% end %>

  </li>

<% end %>

