<%= render "layouts/header" %>

<div class="container my-3">
  <div class="lead-show-card shadow-sm rounded-3 p-3 bg-white">
    <h3 class="mb-3 text-primary text-center">
      <i class="bi bi-person-badge me-2"></i> Lead Details
    </h3>
<div class="d-flex justify-content-between align-items-center mb-4">

  <div class="d-flex gap-2">

  

    <%= link_to ailogs_path,
        class: "btn btn-light rounded-pill shadow-sm" do %>
      <i class="bi bi-whatsapp me-2"></i>
      Back to WhatsApp
    <% end %>

    <%= link_to jmleads_path(filter: "uncontacted"),
      class: "btn btn-light border rounded-pill shadow-sm" do %>
  <i class="bi bi-arrow-left-circle-fill me-2"></i>
  Back to Leads
<% end %>

  </div>

</div>

    <div class="lead-details">

      <!-- Unique ID -->
      <div class="detail-item">
        <span class="label">Unique ID:</span>
        <span class="value text-muted"><%= @jmlead.sglid || "—" %></span>
      </div>

      <!-- Status -->
      <div class="detail-item">
        <span class="label">Status:</span>
        <span class="value">
          <span class="badge <%= @jmlead.status == "converted" ? "bg-success" : "bg-warning text-dark" %>">
            <%= @jmlead.status.titleize %>
          </span>
        </span>
      </div>

     <% if @jmlead.converted? %>
  <div class="alert alert-success d-flex justify-content-center align-items-center gap-2 py-1 mt-2">
    <i class="bi bi-check-circle-fill"></i>
    <span>This lead has been converted</span>
  </div>
<% end %>

<!-- Latest Conversation -->
<div class="detail-item align-items-start">
  <span class="label pt-2">
    <i class="bi bi-chat-left-text-fill text-primary me-1"></i>
    Latest Conversation
  </span>

  <div class="value">

    <% updates = @jmlead.conversation.to_s.split(/\n{2,}/).reject(&:blank?) %>

    <% if updates.any? %>

      <% update = updates.last %>

      <% body = update.gsub(/\ACustomer:\s*/m, "").strip %>
      <% lines = body.lines.map(&:strip).reject(&:blank?) %>

      <% timestamp = nil %>
      <% if lines.first&.match?(/^\[.*\]$/) %>
        <% timestamp = lines.shift.delete("[]") %>
      <% end %>

      <div class="latest-conversation-card">

        <div class="latest-conversation-header">

          <span class="badge bg-primary rounded-pill px-3">
            Latest
          </span>

          <% if timestamp.present? %>
            <small class="text-muted">
              <i class="bi bi-clock me-1"></i>
              <%= timestamp %>
            </small>
          <% end %>

        </div>

        <div class="latest-conversation-text">
          <%= truncate(lines.join(" "), length: 180) %>
        </div>

      </div>

    <% else %>

      <div class="text-muted small py-2">
        <i class="bi bi-chat-square-text me-1"></i>
        No conversations yet.
      </div>

    <% end %>

  </div>
</div>


<style>
 .latest-conversation-card{
    background:linear-gradient(180deg,#ffffff,#f8fbff);
    border:1px solid #e7edf6;
    border-left:5px solid #0d6efd;
    border-radius:16px;
    padding:14px 16px;
    box-shadow:0 4px 12px rgba(15,23,42,.06);
}

.latest-conversation-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:10px;
}

.latest-conversation-text{
    color:#334155;
    font-size:.92rem;
    line-height:1.65;
    word-break:break-word;
}

.latest-conversation-card:hover{
    box-shadow:0 8px 24px rgba(15,23,42,.10);
    transform:translateY(-2px);
    transition:all .25s ease;
}

@media (max-width:768px){
    .latest-conversation-card{
        padding:12px;
    }

    .latest-conversation-text{
        font-size:.87rem;
    }
}
</style>


    </div>


      <!-- Action Buttons -->
    <div class="mt-3 d-flex flex-wrap justify-content-center gap-2">
      <%= link_to edit_jmlead_path(@jmlead), class: "btn btn-warning btn-sm" do %>
        <i class="bi bi-pencil-fill me-1"></i> Edit
      <% end %>
     <%= link_to jmleads_path(filter: "uncontacted"),
      class: "btn btn-outline-secondary btn-sm" do %>
