              <span class="crm-status crm-status-converted">

                <span class="crm-status-dot"></span>

                <i class="bi bi-check-circle-fill"></i>

                Converted

              </span>

            <% elsif lead.status.to_s.downcase == "assigned" %>

              <span class="crm-status crm-status-assigned">

                <span class="crm-status-dot"></span>

                <i class="bi bi-person-check-fill"></i>

                Assigned

              </span>

            <% else %>

              <span class="crm-status crm-status-pending">

                <span class="crm-status-dot"></span>

                <i class="bi bi-hourglass-split"></i>

                Pending

              </span>

            <% end %>

          </td>


          <!-- ==================================================
               CREATED
          =================================================== -->

          <td>

            <div class="crm-date">

              <div class="crm-date-main">

                <i class="bi bi-calendar-event"></i>

                <%= lead.created_at.strftime("%d %b %Y") %>

              </div>

              <div class="crm-date-relative">

                <i class="bi bi-clock"></i>

                <%= time_ago_in_words(lead.created_at) %> ago

              </div>

            </div>

          </td>


          <!-- ==================================================
               LAST COMMENTS
          =================================================== -->

          <td>

            <% if updates.any? %>

              <% update = updates.last %>

              <% body =
                   update
                     .gsub(/\ACustomer:\s*/m, "")
                     .strip
              %>

              <% lines =
                   body
                     .lines
                     .map(&:strip)
                     .reject(&:blank?)
              %>

              <% timestamp = nil %>

              <% if lines.first&.match?(/^\[.*\]$/) %>

                <% timestamp =
                     lines.shift.delete("[]")
                %>

              <% end %>


              <div class="latest-conversation-card">

                <div class="latest-conversation-header">

                  <span class="latest-badge">

                    <i class="bi bi-chat-dots-fill"></i>

                    Latest

                  </span>


                  <% if timestamp.present? %>

                    <span class="latest-time">

                      <i class="bi bi-clock"></i>

                      <%= timestamp %>

                    </span>

                  <% end %>

                </div>


                <div class="latest-conversation-text">

                  <%= truncate(
                        lines.join(" "),
                        length: 180
                      ) %>

                </div>

              </div>


            <% else %>

              <div class="no-conversation">

                <span class="no-conversation-icon">

                  <i class="bi bi-chat-square-dots"></i>

                </span>

                <span>
                  No conversation yet
                </span>

              </div>

            <% end %>

          </td>


          <!-- ==================================================
               ACTIONS
          =================================================== -->

          <td>

            <div class="crm-actions">

              <!-- VIEW -->

              <%= link_to jmlead_path(lead),
                  class: "crm-action-btn crm-action-view",
                  data: { turbo: false },
                  title: "View Lead" do %>

                <i class="bi bi-eye-fill"></i>

              <% end %>


              <!-- EDIT -->

              <%= link_to edit_jmlead_path(lead),
                  class: "crm-action-btn crm-action-edit",
                  data: { turbo: false },
                  title: "Edit Lead" do %>

                <i class="bi bi-pencil-fill"></i>

              <% end %>

            </div>

          </td>

        </tr>

      <% end %>

    </tbody>

  </table>

</div>


<!-- Pagination -->
<div class="leads-pagination">

  <div class="d-flex justify-content-center mb-3">
    <%= paginate @jmleads %>
  </div>

  <div class="d-flex justify-content-center align-items-center gap-2 mb-3">

    <%= form_with url: request.path,
          method: :get,
          local: true,
          id: "rows-per-page-form",
          class: "d-flex align-items-center gap-2" do |f| %>

      <%= f.label :per_page,
          "Rows per page",
          class: "mb-0 fw-semibold" %>

      <%= f.select :per_page,
          options_for_select(
            [10, 25, 50, 100, 250, 500, 1000],
            params[:per_page] || 10
          ),
          {},
          class: "form-select form-select-sm",
          style: "width:100px;",
          id: "rows-per-page" %>

    <% end %>

  </div>

  <div class="text-center text-muted small">
    <%= page_entries_info @jmleads %>
  </div>

</div>


