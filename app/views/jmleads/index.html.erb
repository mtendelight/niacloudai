<%# =====================================================
    UNCONTACTED LEADS
===================================================== %>

<div class="d-flex justify-content-between align-items-center mb-2">

  <div>
    <h6 class="fw-bold mb-0">
      <i class="bi bi-person-x-fill text-danger me-1"></i>
      Uncontacted Leads
    </h6>

    <small class="text-muted">
      Last 60 Days
    </small>
  </div>

  <span class="badge rounded-pill bg-danger-subtle text-danger">
    <i class="bi bi-chat-dots-fill me-1"></i>
    <%= @uncontacted_count.to_i %>
  </span>

</div>


<% if @uncontacted_days.present? %>

  <div class="uncontacted-grid <%= 'single-day' if @uncontacted_days.length == 1 %>">

    <% @uncontacted_days.each do |day| %>

      <% active = params[:uncontacted_date].to_s == day[:date].to_s %>
      <% pending = day[:count].to_i > 0 %>

      <%= link_to jmleads_path(
            filter: "uncontacted",
            uncontacted_date: day[:date]
          ),
          class: [
            "uncontacted-card",
            pending ? "card-pending" : "card-clear",
            ("active" if active)
          ].compact.join(" ") do %>

        <div class="uc-top">

          <span class="uc-icon">

            <% if pending %>
              <i class="bi bi-person-x-fill"></i>
            <% else %>
              <i class="bi bi-check-circle-fill"></i>
            <% end %>

          </span>

          <i class="bi bi-arrow-up-right uc-arrow"></i>

        </div>


        <strong class="uc-count">
          <%= day[:count].to_i %>
        </strong>


        <span class="uc-date">
          <i class="bi bi-calendar3"></i>
          <%= day[:date].strftime("%d %b") %>
        </span>


        <span class="uc-status">

          <% if pending %>

            <i class="bi bi-exclamation-circle-fill"></i>
            Pending

          <% else %>

            <i class="bi bi-check-circle-fill"></i>
            Clear

          <% end %>

        </span>

      <% end %>

    <% end %>

  </div>

<% else %>

  <div class="uncontacted-empty">

    <div class="empty-icon">
      <i class="bi bi-check-circle-fill"></i>
    </div>

    <div class="empty-content">
      <strong>All caught up</strong>

      <small>
        No uncontacted leads found.
      </small>
    </div>

    <span class="empty-badge">
      <i class="bi bi-check-lg"></i>
      Clear
    </span>

  </div>

<% end %>


