<!-- MODERN PREMIUM CRM UI -->
<!-- ========================= -->

<style>


  @media (max-width:768px){

    .crm-table thead{
        display:none;
    }

    .crm-table{
        border:0;
    }

    .crm-table tbody,
    .crm-table tr,
    .crm-table td{
        display:block;
        width:100%;
    }

    .crm-table tbody tr{
        margin-bottom:18px;
        border-radius:18px;
        overflow:hidden;
        background:#fff;
        box-shadow:0 8px 25px rgba(0,0,0,.08);
        border:1px solid #edf2f7;
    }

    .crm-table td{
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        gap:12px;
        padding:14px 16px;
        border-bottom:1px solid #f1f5f9;
    }

    .crm-table td:last-child{
        border-bottom:none;
    }

    .crm-table td::before{
        content:attr(data-label);
        flex:0 0 95px;
        font-weight:700;
        color:#64748b;
        font-size:.78rem;
        text-transform:uppercase;
    }

    .crm-avatar{
        width:40px;
        height:40px;
        font-size:15px;
    }

    .crm-table .btn{
        width:42px;
        height:42px;
    }

    .crm-table .badge{
        font-size:.72rem;
    }

}

@media(max-width:768px){

    .container{
        padding-left:10px;
        padding-right:10px;
    }

    .crm-header{
        padding:14px;
    }

    .crm-title{
        font-size:1.15rem;
    }

}

:root{
  --crm-primary:#2563eb;
  --crm-primary-dark:#1d4ed8;
  --crm-success:#16a34a;
  --crm-warning:#f59e0b;
  --crm-danger:#dc2626;
  --crm-bg:#f4f7fb;
  --crm-card:#ffffff;
  --crm-text:#0f172a;
  --crm-muted:#64748b;
  --crm-border:#e2e8f0;
  --crm-shadow:0 10px 30px rgba(15,23,42,.08);
  --crm-radius:18px;
}

/* ========================= */
/* GLOBAL */
/* ========================= */

body{
  background:var(--crm-bg);
}

.crm-page{
  padding-bottom:40px;
}

.crm-glass{
  background:rgba(255,255,255,.82);
  backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,.6);
  box-shadow:var(--crm-shadow);
  border-radius:var(--crm-radius);
}

/* ========================= */
/* HEADER */
/* ========================= */

.crm-header{
  padding:20px;
  margin-bottom:18px;
}

.crm-title{
  font-size:1.55rem;
  font-weight:800;
  color:var(--crm-text);
  margin:0;
  display:flex;
  align-items:center;
  gap:10px;
}

.crm-title i{
  width:45px;
  height:45px;
  border-radius:14px;
  background:linear-gradient(135deg,var(--crm-primary),#60a5fa);
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  font-size:1.2rem;
  box-shadow:0 6px 20px rgba(37,99,235,.35);
}

.crm-subtitle{
  color:var(--crm-muted);
  font-size:.92rem;
  margin-top:4px;
}

/* ========================= */
/* PREMIUM BUTTONS */
/* ========================= */

.crm-btn{
  border:none;
  border-radius:14px;
  padding:.78rem 1.15rem;
  font-size:.88rem;
  font-weight:700;
  display:inline-flex;
  align-items:center;
  gap:.55rem;
  text-decoration:none;
  transition:.22s ease;
}

.crm-btn:hover{
  transform:translateY(-2px);
}

.crm-btn-primary{
  background:linear-gradient(135deg,var(--crm-primary),var(--crm-primary-dark));
  color:#fff;
  box-shadow:0 10px 20px rgba(37,99,235,.22);
}

.crm-btn-warning{
  background:linear-gradient(135deg,#f59e0b,#fbbf24);
  color:#fff;
  box-shadow:0 10px 20px rgba(245,158,11,.25);
}

.crm-btn-light{
  background:#fff;
  color:var(--crm-text);
  border:1px solid var(--crm-border);
}

/* ========================= */
/* SEARCH */
/* ========================= */

.crm-search{
  padding:18px;
  margin-bottom:18px;
}

.crm-search-box{
  position:relative;
}

.crm-search-box i{
  position:absolute;
  left:16px;
  top:50%;
  transform:translateY(-50%);
  color:#94a3b8;
  font-size:1rem;
}

.crm-search-input{
  border:none !important;
  height:55px;
  border-radius:16px !important;
  padding-left:48px !important;
  background:#f8fafc !important;
  font-size:.95rem;
  box-shadow:none !important;
}

.crm-search-input:focus{
  background:#fff !important;
  border:1px solid #bfdbfe !important;
  box-shadow:0 0 0 4px rgba(37,99,235,.12) !important;
}

/* ========================= */
/* TABLE CARD */
/* ========================= */

.crm-table-card{
  overflow:hidden;
}

.crm-table{
  margin:0;
}

.crm-table thead{
  background:linear-gradient(135deg,#0f172a,#1e293b);
}

.crm-table thead th{
  color:#fff;
  border:none;
  font-size:.72rem;
  text-transform:uppercase;
  letter-spacing:.08em;
  font-weight:700;
  padding:18px 16px;
}

.crm-table tbody tr{
  transition:.18s ease;
  border-bottom:1px solid #f1f5f9;
}

.crm-table tbody tr:hover{
  background:#f8fbff;
  transform:scale(1.002);
}

.crm-table td{
  padding:16px;
  vertical-align:middle;
  border:none;
}

/* ========================= */
/* AVATAR */
/* ========================= */

.crm-avatar{
  width:48px;
  height:48px;
  border-radius:16px;
  background:linear-gradient(135deg,#dbeafe,#bfdbfe);
  color:var(--crm-primary);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:1.1rem;
  flex-shrink:0;
}

/* ========================= */
/* BADGES */
/* ========================= */

.crm-badge{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:.5rem .85rem;
  border-radius:999px;
  font-size:.75rem;
  font-weight:700;
}

.crm-badge-success{
  background:#dcfce7;
  color:#15803d;
}

.crm-badge-warning{
  background:#fef3c7;
  color:#b45309;
}

.crm-badge-light{
  background:#f8fafc;
  color:#334155;
  border:1px solid #e2e8f0;
}

/* ========================= */
/* ACTION BUTTONS */
/* ========================= */

.crm-action{
  width:38px;
  height:38px;
  border:none;
  border-radius:12px;
  background:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  text-decoration:none;
  transition:.2s ease;
  border:1px solid #e2e8f0;
}

.crm-action:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 20px rgba(15,23,42,.12);
}

.crm-action-view{
  color:var(--crm-primary);
}

.crm-action-edit{
  color:var(--crm-success);
}

/* ========================= */
/* EMPTY */
/* ========================= */

.crm-empty{
  padding:70px 20px;
  text-align:center;
}

.crm-empty-icon{
  width:90px;
  height:90px;
  border-radius:28px;
  margin:auto;
  background:linear-gradient(135deg,#dbeafe,#eff6ff);
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--crm-primary);
  font-size:2rem;
  margin-bottom:18px;
}

/* ========================= */
/* PAGINATION */
/* ========================= */

.pagination{
  gap:6px;
}

.pagination a,
.pagination .current{
  border:none !important;
  border-radius:12px !important;
  padding:8px 14px !important;
  font-size:.82rem;
  font-weight:700;
}

.pagination a{
  background:#fff !important;
  color:var(--crm-primary) !important;
  box-shadow:0 2px 8px rgba(15,23,42,.05);
}

.pagination .current{
  background:linear-gradient(135deg,var(--crm-primary),var(--crm-primary-dark)) !important;
  color:#fff !important;
}

/* ========================= */
/* MOBILE */
/* ========================= */

@media(max-width:768px){

  .crm-header{
    padding:16px;
  }

  .crm-title{
    font-size:1.15rem;
  }

 /* Phones only */
@media (max-width:575.98px){

    .table-responsive{
        overflow-x:auto;
        -webkit-overflow-scrolling:touch;

        scrollbar-width:none;
        -ms-overflow-style:none;
    }

    .table-responsive::-webkit-scrollbar{
        display:none;
    }

    .crm-table{
        min-width:780px;
    }

    .crm-table thead{
        display:table-header-group;
    }

    .crm-table tbody{
        display:table-row-group;
    }

    .crm-table tr{
        display:table-row;
    }

    .crm-table td,
    .crm-table th{
        display:table-cell;
        white-space:nowrap;
        padding:10px 8px;
        font-size:.82rem;
        vertical-align:middle;
    }

    .crm-avatar{
        width:34px;
        height:34px;
        font-size:.85rem;
    }

    .crm-table .badge{
        font-size:.68rem;
        padding:.3rem .55rem;
    }

    .crm-table .btn{
        width:32px;
        height:32px;
        padding:0;
    }

    .crm-table td::before{
        content:none !important;
    }
}

  .crm-table tbody tr{
    margin:14px;
    border-radius:20px;
    background:#fff;
    box-shadow:0 8px 24px rgba(15,23,42,.06);
    overflow:hidden;
  }

  .crm-table td{
    justify-content:space-between;
    gap:12px;
    padding:14px 16px;
    border-bottom:1px solid #f1f5f9;
  }

  .crm-table td:last-child{
    border-bottom:none;
  }

  .crm-table td::before{
    content:attr(data-label);
    font-weight:700;
    color:#64748b;
    font-size:.78rem;
  }

}

</style>




<%= render "layouts/header" %>

<div class="container">

  


<!-- =========================================
     WHATSAPP CRM DASHBOARD HEADER
========================================= -->

<div class="whatsapp-dashboard-header">

  <div class="whatsapp-header-main">

    <!-- BRAND / TITLE -->
    <div class="whatsapp-header-title">

      <div class="whatsapp-header-icon">
        <i class="bi bi-whatsapp"></i>
      </div>

      <div>
        <div class="whatsapp-title-row">

          <h1>
            WhatsApp CRM
          </h1>

          <span class="whatsapp-live-badge">
            <span class="live-dot"></span>
            Live
          </span>

        </div>

        <p>
          Manage WhatsApp leads, conversations, follow-ups & conversions
        </p>
      </div>

    </div>


    <!-- ACTIONS -->
    <div class="whatsapp-header-actions">

      <%= link_to jmleads_path(format: "xlsx"),
          class: "whatsapp-action whatsapp-export",
          data: { turbo: false } do %>

        <span class="action-icon">
          <i class="bi bi-file-earmark-excel-fill"></i>
        </span>

        <span class="action-text">
          <strong>Export</strong>
          <small>Excel</small>
        </span>

      <% end %>


      <%= link_to new_jmlead_path,
          class: "whatsapp-action whatsapp-new-lead" do %>

        <span class="action-icon">
          <i class="bi bi-person-plus-fill"></i>
        </span>

        <span class="action-text">
          <strong>New Lead</strong>
          <small>Add customer</small>
        </span>

      <% end %>

    </div>

</div>



<style>

/* =====================================================
   WHATSAPP CRM HEADER
===================================================== */

.whatsapp-dashboard-header {

  position: relative;

  padding: 20px;

  margin-bottom: 20px;

  border-radius: 20px;

  background:
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f8fafc 55%,
      #f0fdf4 100%
    );

  border: 1px solid #e5e7eb;

  box-shadow:
    0 8px 30px rgba(15, 23, 42, .06);

  overflow: hidden;

}


/* subtle decoration */

.whatsapp-dashboard-header::after {

  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  right: -70px;
  top: -90px;

  border-radius: 50%;

  background: rgba(37, 211, 102, .08);

  pointer-events: none;

}


/* =====================================================
   MAIN HEADER
===================================================== */

.whatsapp-header-main {

  position: relative;

  z-index: 2;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

}


/* =====================================================
   TITLE
===================================================== */

.whatsapp-header-title {

  display: flex;

  align-items: center;

  gap: 14px;

  min-width: 0;

}


.whatsapp-header-icon {

  width: 52px;
  height: 52px;

  flex-shrink: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 16px;

  background:
    linear-gradient(
      135deg,
      #25d366,
      #128c7e
    );

  color: #fff;

  font-size: 25px;

  box-shadow:
    0 8px 18px rgba(37, 211, 102, .25);

}


.whatsapp-title-row {

  display: flex;

  align-items: center;

  gap: 9px;

  flex-wrap: wrap;

}


.whatsapp-title-row h1 {

  margin: 0;

  font-size: 1.35rem;

  line-height: 1.2;

  font-weight: 850;

  color: #0f172a;

  letter-spacing: -.4px;

}


.whatsapp-header-title p {

  margin: 4px 0 0;

  font-size: .82rem;

  font-weight: 500;

  color: #64748b;

}


/* =====================================================
   LIVE BADGE
===================================================== */

.whatsapp-live-badge {

  display: inline-flex;

  align-items: center;

  gap: 5px;

  padding: 4px 8px;

  border-radius: 999px;

  background: #dcfce7;

  color: #15803d;

  font-size: .65rem;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: .4px;

}


.live-dot {

  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #22c55e;

  box-shadow:
    0 0 0 3px rgba(34, 197, 94, .12);

}


/* =====================================================
   ACTIONS
===================================================== */

.whatsapp-header-actions {

  display: flex;

  align-items: center;

  gap: 8px;

  flex-shrink: 0;

}


.whatsapp-action {

  display: flex;

  align-items: center;

  gap: 9px;

  min-width: 120px;

  padding: 9px 12px;

  border-radius: 13px;

  text-decoration: none !important;

  border: 1px solid #e2e8f0;

  background: #fff;

  color: #0f172a;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;

}


.whatsapp-action:hover {

  transform: translateY(-2px);

  box-shadow:
    0 8px 20px rgba(15, 23, 42, .08);

}


.action-icon {

  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 10px;

  font-size: 15px;

}


.action-text {

  display: flex;

  flex-direction: column;

  line-height: 1.15;

}


.action-text strong {

  font-size: .76rem;

  font-weight: 800;

}


.action-text small {

  margin-top: 3px;

  font-size: .62rem;

  color: #94a3b8;

  font-weight: 600;

}


/* EXPORT */

.whatsapp-export .action-icon {

  background: #dcfce7;

  color: #15803d;

}


/* NEW LEAD */

.whatsapp-new-lead {

  background:
    linear-gradient(
      135deg,
      #128c7e,
      #25d366
    );

  border-color: transparent;

  color: #fff;

  box-shadow:
    0 6px 16px rgba(37, 211, 102, .20);

}


.whatsapp-new-lead .action-icon {

  background: rgba(255,255,255,.16);

  color: #fff;

}


.whatsapp-new-lead .action-text small {

  color: rgba(255,255,255,.75);

}


/* =====================================================
   STATS
===================================================== */

.whatsapp-header-stats {

  position: relative;

  z-index: 2;

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 8px;

  margin-top: 16px;

  padding-top: 14px;

  border-top: 1px solid #e5e7eb;

}


.whatsapp-mini-stat {

  display: flex;

  align-items: center;

  gap: 9px;

  padding: 9px 11px;

  border-radius: 12px;

  background: rgba(255,255,255,.72);

  border: 1px solid rgba(226,232,240,.8);

}


.mini-stat-icon {

  width: 32px;
  height: 32px;

  flex-shrink: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 9px;

  font-size: 13px;

}


.mini-stat-icon.blue {

  background: #dbeafe;
  color: #2563eb;

}


.mini-stat-icon.orange {

  background: #ffedd5;
  color: #ea580c;

}


.mini-stat-icon.green {

  background: #dcfce7;
  color: #16a34a;

}


.mini-stat-icon.red {

  background: #fee2e2;
  color: #dc2626;

}


.whatsapp-mini-stat > div:last-child {

  display: flex;

  flex-direction: column;

  min-width: 0;

}


.whatsapp-mini-stat strong {

  font-size: .95rem;

  line-height: 1;

  font-weight: 850;

  color: #0f172a;

}


.whatsapp-mini-stat span {

  margin-top: 3px;

  font-size: .61rem;

  color: #64748b;

  font-weight: 650;

}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 900px) {

  .whatsapp-header-main {

    align-items: flex-start;

    flex-direction: column;

  }

  .whatsapp-header-actions {

    width: 100%;

  }

  .whatsapp-action {

    flex: 1;

  }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 576px) {

  .whatsapp-dashboard-header {

    padding: 14px;

    border-radius: 16px;

  }

  .whatsapp-header-icon {

    width: 44px;
    height: 44px;

    border-radius: 13px;

    font-size: 21px;

  }

  .whatsapp-title-row h1 {

    font-size: 1.08rem;

  }

  .whatsapp-header-title p {

    font-size: .72rem;

    max-width: 280px;

  }

  .whatsapp-header-actions {

    gap: 6px;

  }

  .whatsapp-action {

    min-width: 0;

    padding: 8px;

  }

  .action-text small {

    display: none;

  }

  .action-text strong {

    font-size: .7rem;

  }

  .action-icon {

    width: 31px;
    height: 31px;

  }

  .whatsapp-header-stats {

    grid-template-columns: repeat(2, 1fr);

    gap: 6px;

  }

  .whatsapp-mini-stat {

    padding: 8px;

  }

}

</style>

<div class="login">
<%= form_with url: jmleads_path, method: :get, local: true do %>

  <%= hidden_field_tag :filter, params[:filter] %>
  <%= hidden_field_tag :per_page, (params[:per_page].presence || 10) %>

  <div class="input-group shadow-sm">

    <span class="input-group-text bg-white border-end-0">
      <i class="bi bi-search"></i>
    </span>

    <%= text_field_tag :search,
          params[:search],
          class: "form-control border-start-0 border-end-0",
          placeholder: "Search by ID, customer, phone, items or status..." %>

    <% if params[:search].present? %>

      <%= link_to jmleads_path(filter: params[:filter], per_page: params[:per_page]),
          class: "input-group-text bg-white border-start-0 text-danger search-clear",
          title: "Clear Search" do %>

        <i class="bi bi-x-lg"></i>

      <% end %>

    <% end %>

    <button class="btn btn-primary px-4">
      <i class="bi bi-search me-1"></i>
      Search
    </button>

  </div>

<% end %>

</div>

<style>
  .search-clear{
    cursor:pointer;
    text-decoration:none;
    transition:all .2s ease;
}

.search-clear:hover{
    background:#ef4444 !important;
    color:#fff !important;
    border-color:#ef4444 !important;
}

.input-group .form-control:focus{
    box-shadow:none;
}

.input-group{
    border-radius:14px;
    overflow:hidden;
}

.input-group-text{
    background:#fff;
}
</style>


