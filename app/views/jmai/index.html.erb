<style>


/* ==========================================
   BULK SMS — FORCE CONTENT TO STAY IN PLACE
   ========================================== */

.bulk-sms-section {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
}

/* Prevent Bootstrap rows from creating overflow */
.bulk-sms-section .row {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-left: 0;
  margin-right: 0;
}

/* Every column must be allowed to shrink */
.bulk-sms-section .col-12,
.bulk-sms-section .col-md-6,
.bulk-sms-section .col-lg-6,
.bulk-sms-section .col-lg-8,
.bulk-sms-section .col-lg-4 {
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

/* Cards and alerts must never stretch parent */
.bulk-sms-section .card,
.bulk-sms-section .alert {
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* Excel preview stays inside available width */
.bulk-sms-section #excel-preview-container {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
}

/* Table scrolls INSIDE the preview */
.bulk-sms-section #excel-preview-container .table-responsive {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
}

/* Don't allow long SMS/text to stretch page */
.bulk-sms-section table {
  max-width: 100%;
}

.bulk-sms-section th,
.bulk-sms-section td {
  white-space: nowrap;
}

/* SMS preview can wrap instead of forcing width */
.bulk-sms-section th:last-child,
.bulk-sms-section td:last-child {
  white-space: normal;
  min-width: 220px;
  max-width: 350px;
  word-break: break-word;
  overflow-wrap: anywhere;
}

/* File name / long values */
.bulk-sms-section #excel-file-name {
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Mobile */
@media (max-width: 768px) {

  .bulk-sms-section {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .bulk-sms-section .row {
    margin-left: 0;
    margin-right: 0;
  }

  .bulk-sms-section #excel-preview-container {
    width: 100%;
    max-width: 100%;
  }

  .bulk-sms-section #excel-preview-container .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .bulk-sms-section .table {
    min-width: 900px;
  }

  .bulk-sms-section .alert {
    overflow: hidden;
  }

  .bulk-sms-section #excel-file-name {
    max-width: 45%;
  }
}



/* =========================================================
   EXCEL PREVIEW TABLE — UNIVERSAL RESPONSIVE
   ========================================================= */

.excel-table-wrapper {
  width: 100%;
  max-width: 100%;

  overflow-x: auto;
  overflow-y: hidden;

  -webkit-overflow-scrolling: touch;

  scrollbar-width: thin;

  border-radius: 10px;
}


/* =========================================================
   TABLE
   ========================================================= */

.excel-preview-table {
  width: 100%;

  min-width: 850px;

  margin-bottom: 0 !important;

  white-space: normal;

  table-layout: auto;
