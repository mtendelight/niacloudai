                    <div class="metric-icon icon-cyan">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>

                    <div class="metric-number text-info">
                        <%= @sidekiq_retry.size %>
                    </div>

                    <div class="metric-title">
                        Retries
                    </div>

                </div>

            </div>

            <div class="col-lg-2 col-md-4 col-6">

                <div class="metric-card text-center">

                    <div class="metric-icon icon-gray">
                        <i class="bi bi-trash3-fill"></i>
                    </div>

                    <div class="metric-number text-secondary">
                        <%= @sidekiq_dead.size %>
                    </div>

                    <div class="metric-title">
                        Dead Jobs
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<div class="card shadow border-0">

  <div class="card-header bg-black text-success">
    <i class="bi bi-terminal-fill"></i>
    Live Worker Status
  </div>

  <div class="card-body bg-dark text-success" style="font-family:monospace;max-height:350px;overflow:auto;">

<% if @sidekiq_workers.any? %>

  <% @sidekiq_workers.each do |process_id, thread_id, work| %>

    <% payload = work.payload %>

    <div>

      [<%= Time.current.strftime("%H:%M:%S") %>]

      Worker:
      <%= process_id %>

      Thread:
      <%= thread_id %>

      Job:
      <%= payload["wrapped"] || payload["class"] %>

      Queue:
      <%= payload["queue"] %>

      Arguments:
      <%= payload["args"].inspect %>

    </div>

    <hr class="border-secondary">

  <% end %>

<% else %>

  <div class="text-warning">
    No background jobs running...
  </div>

<% end %>

  </div>

</div>

<script>
(function () {
  const INACTIVITY_TIME = 5 * 60 * 1000; // 5 minutes
  let inactivityTimer;

  function resetTimer() {
    clearTimeout(inactivityTimer);
    inactivityTimer = setTimeout(function () {
      location.reload();
    }, INACTIVITY_TIME);
  }

  // Events that count as user activity
  [
    "mousemove",
    "mousedown",
    "click",
    "scroll",
    "keypress",
    "touchstart"
  ].forEach(function(event) {
    document.addEventListener(event, resetTimer, true);
  });

  // Start the timer when the page loads
  resetTimer();
})();
</script>
