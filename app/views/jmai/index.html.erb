<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const fileInput = document.getElementById("bulk_excel_file");
  const messageInput = document.getElementById("bulk_message");
  const form = document.getElementById("bulk-sms-form");
  const submitButton = document.getElementById("bulk-sms-submit");

  const infoBox = document.getElementById("excel-info");
  const fileName = document.getElementById("excel-file-name");
  const rowCount = document.getElementById("excel-row-count");
  const validCount = document.getElementById("valid-count");
  const invalidCount = document.getElementById("invalid-count");

  const previewContainer =
    document.getElementById("excel-preview-container");

  const previewEmpty =
    document.getElementById("excel-preview-empty");

  const previewBody =
    document.getElementById("excel-preview-body");

  const previewCount =
    document.getElementById("preview-count");

  let excelRows = [];


  // ==========================================
  // NORMALIZE PHONE
  // ==========================================

  function normalizePhone(phone) {

    phone = String(phone || "")
      .replace(/\D/g, "");

    if (phone.startsWith("0")) {
      phone = "254" + phone.substring(1);
    }

    else if (
      phone.startsWith("7") ||
      phone.startsWith("1")
    ) {
      phone = "254" + phone;
    }

    if (/^254[17]\d{8}$/.test(phone)) {
      return phone;
    }

    return "";
  }


  // ==========================================
  // ESCAPE HTML
  // ==========================================

  function escapeHtml(value) {

    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }


  // ==========================================
  // PERSONALIZE MESSAGE
  // ==========================================

  function personalizeMessage(row) {

    let message = messageInput.value || "";

    return message
      .replace(/\{name\}/gi, row.name || "Customer")
      .replace(/\{points\}/gi, row.points || "")
      .replace(/\{location\}/gi, row.location || "");
  }


  // ==========================================
  // FIND COLUMN
  // ==========================================

  function findColumn(headers, possibleNames) {

    return headers.findIndex(function (header) {

      return possibleNames.includes(
        String(header || "")
          .trim()
          .toLowerCase()
          .replace(/\s+/g, "_")
      );

    });
  }


  // ==========================================
  // BUILD PREVIEW
  // ==========================================

  function buildPreview() {

    previewBody.innerHTML = "";

    let valid = 0;
    let invalid = 0;

    excelRows.forEach(function (row, index) {

      const phone = normalizePhone(row.phone);

      const isValid = phone !== "";

      if (isValid) {
        valid++;
      } else {
        invalid++;
      }

      const sms = personalizeMessage({
        name: row.name,
        points: row.points,
        location: row.location
      });

      const tr = document.createElement("tr");

      tr.innerHTML = `
        <td>${index + 1}</td>

        <td>
          <strong>
            ${escapeHtml(row.name || "Customer")}
          </strong>
        </td>

        <td>
          ${escapeHtml(phone || row.phone || "-")}
        </td>

        <td>
          ${escapeHtml(row.points || "-")}
        </td>

        <td>
          ${escapeHtml(row.location || "-")}
        </td>

        <td style="min-width:300px;">
          <div class="small text-muted"
               style="white-space: pre-line;">
            ${escapeHtml(sms)}
          </div>
        </td>

        <td>
          ${
            isValid
              ? `<span class="badge bg-success">
                   <i class="bi bi-check-circle me-1"></i>
                   Valid
                 </span>`
              : `<span class="badge bg-danger">
                   <i class="bi bi-x-circle me-1"></i>
                   Invalid Phone
                 </span>`
          }
        </td>
      `;

      previewBody.appendChild(tr);

    });


    rowCount.textContent = excelRows.length;
    previewCount.textContent = `${excelRows.length} rows`;

    validCount.textContent = `${valid} Valid`;
    invalidCount.textContent = `${invalid} Invalid`;

    infoBox.classList.remove("d-none");

    if (valid > 0) {

      previewContainer.classList.remove("d-none");
      previewEmpty.classList.add("d-none");

      submitButton.disabled = false;

    } else {

      previewContainer.classList.add("d-none");
      previewEmpty.classList.remove("d-none");

      submitButton.disabled = true;
    }
  }


  // ==========================================
  // READ EXCEL
  // ==========================================

  fileInput.addEventListener("change", function () {

    const file = fileInput.files[0];

    if (!file) {
      return;
    }

    fileName.textContent = file.name;

    const reader = new FileReader();

    reader.onload = function (event) {

      try {

        const data = new Uint8Array(event.target.result);

        const workbook = XLSX.read(data, {
          type: "array"
        });

        const firstSheet =
          workbook.Sheets[workbook.SheetNames[0]];

        const rows = XLSX.utils.sheet_to_json(
          firstSheet,
          {
            header: 1,
            defval: ""
          }
        );

        if (!rows.length) {

          alert("The Excel file is empty.");

          return;
        }

        const headers = rows[0];

        const nameIndex = findColumn(
          headers,
          [
            "name",
            "customer_name",
            "customer"
          ]
        );

        const phoneIndex = findColumn(
          headers,
          [
            "phone",
            "mobile",
            "mobile_number",
            "telephone"
          ]
        );

        const pointsIndex = findColumn(
          headers,
          [
            "points",
            "customer_points"
          ]
        );

        const locationIndex = findColumn(
          headers,
          [
            "location",
            "customer_location",
            "town",
            "city"
          ]
        );


        if (
          nameIndex === -1 ||
          phoneIndex === -1
        ) {

          alert(
            "Excel must contain Name and Phone columns."
          );

          submitButton.disabled = true;

          return;
        }


        excelRows = [];


        rows.slice(1).forEach(function (row) {

          const name =
            String(row[nameIndex] || "").trim();

          const phone =
            String(row[phoneIndex] || "").trim();

          const points =
            pointsIndex >= 0
              ? String(row[pointsIndex] || "").trim()
              : "";

          const location =
            locationIndex >= 0
              ? String(row[locationIndex] || "").trim()
              : "";


          if (!name && !phone) {
            return;
          }


          excelRows.push({
            name: name,
            phone: phone,
            points: points,
            location: location
          });

        });


        buildPreview();

      }

      catch (error) {

        console.error(error);

        alert(
          "Could not read this Excel file. Please check the file format."
        );

        submitButton.disabled = true;
      }

    };


    reader.readAsArrayBuffer(file);

  });


  // ==========================================
  // LIVE MESSAGE PREVIEW
  // ==========================================

  messageInput.addEventListener(
    "input",
    function () {

      if (excelRows.length > 0) {
        buildPreview();
      }

    }
  );


  // ==========================================
  // CONFIRM BEFORE SEND
  // ==========================================

  form.addEventListener("submit", function (event) {

    const validRecipients = excelRows.filter(function (row) {

      return normalizePhone(row.phone) !== "";

    });


    if (validRecipients.length === 0) {

      event.preventDefault();

      alert(
        "There are no valid phone numbers to send SMS to."
      );

      return;
    }


    const confirmed = confirm(
      `You are about to send SMS to ${validRecipients.length} recipients.\n\nContinue?`
    );


    if (!confirmed) {
      event.preventDefault();
      return;
    }


    submitButton.disabled = true;

    submitButton.innerHTML =
      '<i class="bi bi-hourglass-split me-2"></i> Queuing SMS...';

  });

});
</script>

