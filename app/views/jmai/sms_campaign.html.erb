<div class="container py-4">

  <div class="sms-hero shadow-lg">

    <div class="hero-left">
      <div class="hero-icon">
        <i class="bi bi-chat-dots-fill"></i>
      </div>

      <div>
        <h2>Bulk SMS Campaign</h2>
        <p>
          Send personalized SMS to customers and open leads in one click.
        </p>
      </div>
    </div>

    <div class="hero-right">
      <span class="badge bg-light text-dark px-3 py-2">
        <i class="bi bi-lightning-charge-fill text-warning"></i>
        JANOMAX SMS
      </span>
    </div>

  </div>

  <%= form_with url: send_custom_sms_path, method: :post, class: "mt-4" do %>

    <div class="card sms-card border-0 shadow">

      <div class="card-body p-4">

        <div class="row">

          <div class="col-lg-4">

            <div class="premium-box">

              <label class="form-label fw-bold">
                <i class="bi bi-people-fill text-primary"></i>
                Recipient Group
              </label>

              <%= select_tag :recipient_type,
                    options_for_select([
                      ["👥 Customers","customers"],
                      ["📞 Open Leads","leads"],
                      ["🚀 Customers + Leads","both"]
                    ]),
                    class: "form-select premium-input" %>

              <div class="sms-tip mt-4">

                <h6>
                  <i class="bi bi-stars text-warning"></i>
                  Personalization
                </h6>

                <ul>

                  <li>
                    <b>{name}</b> → Customer Name
                  </li>

                  <li>
                    <b>{points}</b> → Reward Points
                  </li>

                  <li>
                    <b>{location}</b> → Customer Location
                  </li>

                </ul>

              </div>

            </div>

          </div>

          <div class="col-lg-8">

            <label class="form-label fw-bold">
              <i class="bi bi-envelope-fill text-success"></i>
              SMS Message
            </label>

            <%= text_area_tag :message,
                  "",
                  rows: 11,
                  class: "form-control premium-textarea",
                  placeholder: "Dear {name},

Fresh premium bales have arrived.

You have {points} reward points.

Visit Janomax today." %>

            <div class="preview-card mt-3">

              <h6>
                <i class="bi bi-phone-fill text-success"></i>
                Preview
              </h6>

              <div class="preview-box">

                <b>Customer:</b>

                <div class="mt-2">
                  Dear Moses,
                </div>

                <div class="mt-2">
                  Fresh premium bales have arrived...
                </div>

              </div>

              <div class="preview-box mt-3">

                <b>Lead:</b>

                <div class="mt-2">
                  Dear Customer,
                </div>

                <div class="mt-2">
                  Fresh premium bales have arrived...
                </div>

              </div>

            </div>

          </div>

        </div>

      </div>

      <div class="card-footer bg-white border-0 text-end p-4">

        <button class="btn btn-lg btn-success premium-btn">

          <i class="bi bi-send-fill"></i>

          Send SMS Campaign

        </button>

      </div>

    </div>

  <% end %>

</div>

<style> 

.sms-hero{

background:linear-gradient(135deg,#0d6efd,#6610f2);

border-radius:20px;

padding:30px;

display:flex;

justify-content:space-between;

align-items:center;

color:white;

}

.hero-left{

display:flex;

gap:20px;

align-items:center;

}

.hero-icon{

width:75px;

height:75px;

border-radius:50%;

background:rgba(255,255,255,.2);

display:flex;

align-items:center;

justify-content:center;

font-size:32px;

}

.hero-left h2{

font-weight:700;

margin-bottom:5px;

}

.hero-left p{

opacity:.9;

margin:0;

}

.sms-card{

border-radius:22px;

overflow:hidden;

}

.premium-box{

background:#f8f9fa;

border-radius:18px;

padding:25px;

height:100%;

}

.premium-input{

border-radius:12px;

padding:14px;

font-size:16px;

}

.premium-textarea{

border-radius:18px;

padding:18px;

font-size:16px;

min-height:330px;

resize:vertical;

}

.premium-textarea:focus{

box-shadow:0 0 0 .2rem rgba(13,110,253,.15);

border-color:#0d6efd;

}

.sms-tip{

background:white;

border-radius:15px;

padding:20px;

box-shadow:0 3px 12px rgba(0,0,0,.05);

}

.sms-tip ul{

padding-left:18px;

margin-bottom:0;

}

.sms-tip li{

padding:6px 0;

}

.preview-card{

background:#f8f9fa;

padding:20px;

border-radius:18px;

}

.preview-box{

background:white;

padding:18px;

border-radius:14px;

border-left:5px solid #198754;

box-shadow:0 2px 10px rgba(0,0,0,.05);

}

.premium-btn{

padding:14px 40px;

font-size:18px;

border-radius:50px;

font-weight:600;

box-shadow:0 10px 25px rgba(25,135,84,.35);

transition:.3s;

}

.premium-btn:hover{

transform:translateY(-3px);

}

@media(max-width:768px){

.sms-hero{

flex-direction:column;

text-align:center;

gap:20px;

}

.hero-left{

flex-direction:column;

}

.premium-btn{

width:100%;

}

}
</style>