<style>
/* ============================================================
   NIACLOUD TECHNOLOGIES
   PREMIUM LANDING PAGE
   Bootstrap 5 + Bootstrap Icons
   ============================================================ */

.niacloud-page {
  --nc-primary: #2563eb;
  --nc-primary-dark: #1d4ed8;
  --nc-indigo: #4f46e5;
  --nc-dark: #0b1220;
  --nc-text: #172033;
  --nc-muted: #6b7280;
  --nc-border: #e8edf5;
  --nc-bg: #f7f9fc;
  --nc-white: #ffffff;

  color: var(--nc-text);
  background: #fff;
  overflow: hidden;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
               Roboto, Helvetica, Arial, sans-serif;
}

/* ============================================================
   GLOBAL
   ============================================================ */

.niacloud-page *,
.niacloud-page *::before,
.niacloud-page *::after {
  box-sizing: border-box;
}

.nc-section {
  padding: 105px 0;
}

.nc-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 20px;

  color: var(--nc-primary);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .14em;
}

.nc-eyebrow.light {
  color: #bfdbfe;
}

.nc-section-heading {
  max-width: 720px;
  margin: 0 auto 55px;
  text-align: center;
}

.nc-section-heading h2,
.nc-voip h2,
.nc-cta h2 {
  margin: 0;

  color: var(--nc-dark);

  font-size: clamp(36px, 5vw, 58px);
  line-height: 1.03;
  letter-spacing: -.045em;
  font-weight: 800;
}

.nc-section-heading h2 span,
.nc-voip h2 span,
.nc-cta h2 span {
  color: var(--nc-primary);
}

.nc-section-heading p {
  max-width: 610px;
  margin: 20px auto 0;

  color: var(--nc-muted);
  font-size: 16px;
  line-height: 1.75;
}

/* ============================================================
   HERO
   ============================================================ */

.nc-hero {
  position: relative;

  min-height: 720px;
  padding: 105px 0 95px;

  display: flex;
  align-items: center;

  background:
    radial-gradient(circle at 80% 25%, rgba(37,99,235,.12), transparent 28%),
    radial-gradient(circle at 20% 80%, rgba(79,70,229,.08), transparent 30%),
    #f7faff;
}

.nc-hero-glow {
  position: absolute;
  width: 320px;
  height: 320px;

  border-radius: 50%;
  filter: blur(90px);
  opacity: .18;
  pointer-events: none;
}

.nc-glow-one {
  top: -130px;
  right: 5%;
  background: #2563eb;
}

.nc-glow-two {
  bottom: -160px;
  left: 8%;
  background: #6366f1;
}

.nc-live-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;
  background: #22c55e;

  box-shadow: 0 0 0 5px rgba(34,197,94,.10);
}

.nc-hero h1 {
  margin: 0;

  color: var(--nc-dark);

  font-size: clamp(48px, 7vw, 82px);
  line-height: .98;
  letter-spacing: -.06em;
  font-weight: 850;
}

.nc-hero h1 span {
  color: var(--nc-primary);
}

.nc-hero-text {
  margin: 27px 0 12px;

  color: #374151;

  font-size: 16px;
  font-weight: 700;
  letter-spacing: .01em;
}

.nc-hero-description {
  max-width: 650px;

  margin: 0;

  color: #667085;

  font-size: 17px;
  line-height: 1.75;
}

.nc-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;

  margin-top: 32px;
}

.nc-btn {
  min-height: 52px;

  padding: 0 22px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  border-radius: 13px;

  text-decoration: none;

  font-size: 14px;
  font-weight: 750;

  transition: .22s ease;
}

.nc-btn:hover {
  transform: translateY(-2px);
}

.nc-btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  box-shadow: 0 12px 28px rgba(37,99,235,.23);
}

.nc-btn-primary:hover {
  color: #fff;
  box-shadow: 0 16px 34px rgba(37,99,235,.30);
}

.nc-btn-light {
  color: #344054;
  background: #fff;
  border: 1px solid #e5eaf2;
}

.nc-btn-light:hover {
  color: var(--nc-primary);
}

.nc-hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;

  margin-top: 28px;

  color: #7b8494;
  font-size: 11px;
  font-weight: 650;
}

.nc-hero-trust i {
  margin-right: 5px;
  color: var(--nc-primary);
}

/* PLATFORM CARD */

.nc-platform-card {
  position: relative;

  padding: 25px;

  border: 1px solid rgba(255,255,255,.75);
  border-radius: 28px;

  background: rgba(255,255,255,.78);

  box-shadow:
    0 30px 80px rgba(30,64,175,.13),
    0 5px 20px rgba(15,23,42,.05);

  backdrop-filter: blur(18px);
}

.nc-platform-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  margin-bottom: 22px;
}

.nc-platform-header small {
  display: block;

  color: #8b95a7;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: .12em;
}

.nc-platform-header h5 {
  margin: 5px 0 0;

  color: #172033;
  font-size: 16px;
  font-weight: 800;
}

.nc-status {
  padding: 6px 9px;

  color: #15803d;
  background: #f0fdf4;

  border-radius: 30px;

  font-size: 8px;
  font-weight: 800;
}

.nc-status span {
  display: inline-block;

  width: 6px;
  height: 6px;

  margin-right: 4px;

  border-radius: 50%;
  background: #22c55e;
}

.nc-channel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.nc-channel {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 16px;

  border: 1px solid #edf1f6;
  border-radius: 17px;

  background: #fff;

  transition: .2s ease;
}

.nc-channel:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 25px rgba(15,23,42,.07);
}

.nc-channel > i {
  font-size: 22px;
}

.nc-channel strong,
.nc-channel small {
  display: block;
}

.nc-channel strong {
  color: #1f2937;
  font-size: 12px;
}

.nc-channel small {
  margin-top: 2px;
  color: #98a2b3;
  font-size: 9px;
}

.nc-channel.whatsapp > i {
  color: #16a34a;
}

.nc-channel.calls > i {
  color: #2563eb;
}

.nc-channel.sms > i {
  color: #7c3aed;
}

.nc-channel.cloud > i {
  color: #0ea5e9;
}

.nc-platform-footer {
  margin-top: 17px;
