}

/* ===============================
   BODY
==================================*/

body{
    font-family:"Inter",sans-serif;
    background:
        radial-gradient(circle at top left,#dbeafe 0%,transparent 40%),
        radial-gradient(circle at bottom right,#c7d2fe 0%,transparent 35%),
        linear-gradient(135deg,#edf4ff,#f8fbff);
    background-attachment:fixed;
    color:var(--text);
}


/* ===============================
   ANIMATIONS
==================================*/

.animate-fade{
    animation:fade .35s ease;
}

.animate-slide{
    animation:slide .35s ease;
}

.animate-pop{
    animation:pop .25s ease;
}

@keyframes fade{
from{opacity:0;}
to{opacity:1;}
}

@keyframes slide{
from{
opacity:0;
transform:translateY(20px);
}
to{
opacity:1;
transform:translateY(0);
}
}

@keyframes pop{
from{
opacity:0;
transform:scale(.95);
}
to{
opacity:1;
transform:scale(1);
}
}


/* ===============================
   STICKY HEADER
==================================*/

.sticky-header{
    position:sticky;
    top:15px;
    z-index:999;
}


/* ===============================
   GLASS HEADER
==================================*/

.header-glass{
    background:rgba(255,255,255,.82);
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);

    border:1px solid rgba(255,255,255,.55);

