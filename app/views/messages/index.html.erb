<style>

/* ===============================
   PREMIUM CHAT UI - JANOMAX
==================================*/

:root{
  --primary:#2563eb;
  --primary-dark:#1d4ed8;
  --primary-light:#dbeafe;
  --success:#10b981;
  --white:#ffffff;
  --bg:#eef4ff;
  --card:rgba(255,255,255,.82);
  --border:rgba(255,255,255,.55);
  --text:#1e293b;
  --muted:#64748b;
  --shadow:0 12px 35px rgba(15,23,42,.12);
