  /* Sticky Header */
.sticky-header {
  position: sticky;
  top: 20px; /* distance from top of viewport */
  z-index: 999; /* stays above chat */
}
/* ------------------ Background ------------------ */
body {
  background: linear-gradient(135deg, #dde7ff, #eef3ff);
  background-attachment: fixed;
  font-family: "Inter", sans-serif;
}



/* ------------------ Animations ------------------ */
