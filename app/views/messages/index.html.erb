<script>
(() => {

  let submitting = false;

  function scrollChatToBottom() {
    const box = document.getElementById("chat-box");
    if (box) box.scrollTop = box.scrollHeight;
  }

  function initializeChat() {

    scrollChatToBottom();

    const form = document.getElementById("new_message");
    if (!form) return;

    const textarea = form.querySelector("textarea[name='message[content]']");
    const submitBtn = form.querySelector(".send-btn");

    const replyPreview = document.getElementById("reply-preview");
    const replyText = document.getElementById("reply-text");
    const replyInput = document.getElementById("reply_to_id");
    const cancelReply = document.getElementById("cancel-reply");

    const emojiBtn = document.getElementById("emoji-btn");
    const emojiPicker = document.getElementById("emoji-picker");

    //-----------------------------------
    // Auto resize textarea
    //-----------------------------------

    if (textarea) {

      textarea.style.height = "auto";
      textarea.style.height = textarea.scrollHeight + "px";

      textarea.addEventListener("input", function () {
        this.style.height = "auto";
        this.style.height = this.scrollHeight + "px";
      });

      //-----------------------------------
      // ENTER SEND
      //-----------------------------------

      textarea.addEventListener("keydown", function (e) {

        if (e.key === "Enter" && !e.shiftKey) {

          e.preventDefault();

          if (submitting) return;

          if (
            textarea.value.trim() === "" &&
            document.getElementById("message_attachment").files.length === 0
          ) {
            return;
          }

          form.requestSubmit();

        }

      });

    }

    //-----------------------------------
    // Prevent double submit
    //-----------------------------------

    form.addEventListener("submit", function(e){

      if(submitting){

        e.preventDefault();
        return false;

      }

      submitting = true;

      if(submitBtn){

        submitBtn.disabled = true;

        submitBtn.innerHTML =
          '<span class="spinner-border spinner-border-sm"></span>';

      }

    });

    //-----------------------------------
    // Reply cancel
    //-----------------------------------

    if(cancelReply){

      cancelReply.onclick = function(){

        replyInput.value = "";

        replyPreview.classList.add("d-none");

      }

    }

    //-----------------------------------
    // Emoji picker
    //-----------------------------------

    if(emojiBtn && emojiPicker && textarea){

      emojiBtn.onclick = function(e){

        e.preventDefault();

        emojiPicker.classList.toggle("d-none");

      };

      emojiPicker.querySelectorAll(".emoji").forEach(function(emoji){

        emoji.onclick = function(){

          const start = textarea.selectionStart;
          const end = textarea.selectionEnd;

          textarea.value =
            textarea.value.substring(0,start) +
            this.textContent +
            textarea.value.substring(end);

          textarea.focus();

        };

      });

    }

  }

  //-----------------------------------
  // Reply button
  //-----------------------------------

  document.addEventListener("click", function(e){

    const btn = e.target.closest(".reply-btn");

    if(!btn) return;

    document.getElementById("reply_to_id").value =
      btn.dataset.messageId;

    document.getElementById("reply-text").innerText =
      btn.dataset.messageText;

    document
      .getElementById("reply-preview")
      .classList.remove("d-none");

    document
      .querySelector("textarea[name='message[content]']")
      .focus();

  });

  //-----------------------------------
  // Turbo success
  //-----------------------------------

  document.addEventListener("turbo:submit-end", function(e){

    if(e.target.id !== "new_message") return;

    submitting = false;

    const form = e.target;

    const btn = form.querySelector(".send-btn");

    if(btn){

      btn.disabled = false;

      btn.innerHTML =
        '<i class="bi bi-send-check-fill"></i>';

    }

    if(e.detail.success){

      form.reset();

      const textarea =
        form.querySelector("textarea");

      if(textarea){

        textarea.style.height = "auto";

      }

      document
        .getElementById("reply-preview")
        .classList.add("d-none");

      document
        .getElementById("reply_to_id")
        .value = "";

      document
        .getElementById("attachment-name")
        .innerHTML = "";

      setTimeout(scrollChatToBottom,100);

    }

  });

  document.addEventListener("turbo:before-stream-render",function(){

      setTimeout(scrollChatToBottom,50);

  });

  document.addEventListener("DOMContentLoaded",initializeChat);
  document.addEventListener("turbo:load",initializeChat);

})();
</script>






