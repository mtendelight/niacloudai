.followup-card.active .followup-icon{
    background:rgba(255,255,255,.18);
    color:#fff;
}

.followup-arrow{
    color:#adb5bd;
    font-size:16px;
}

.followup-card.active .followup-arrow{
    color:#fff;
}

.followup-number{
    font-size:1.8rem;
    font-weight:800;
    line-height:1;
}

.followup-date{
    margin-top:6px;
    font-size:.80rem;
    font-weight:700;
    color:#6b7280;
    text-transform:uppercase;
}

.followup-status{
    margin-top:2px;
    font-size:.68rem;
    color:#94a3b8;
    font-weight:600;
}

.followup-card.active .followup-date,
.followup-card.active .followup-status{
    color:rgba(255,255,255,.88);
}

@media(max-width:768px){
    .followup-grid{
        grid-template-columns:repeat(4,1fr);
    }
}

@media(max-width:576px){
    .followup-grid{
        grid-template-columns:repeat(2,1fr);
    }
}
</style>


<div class="card border-0 shadow-lg rounded-4 mb-4">

  <div class="card-header bg-primary text-white py-3">

    <div class="d-flex justify-content-between align-items-center">

      <div>

        <h4 class="mb-1">
          <i class="bi bi-bar-chart-fill"></i>
          Manager Performance Dashboard
        </h4>

        <small>
          <%= Date.current.strftime("%B %Y") %>
        </small>

      </div>

      <span class="badge bg-light text-dark px-3 py-2">

    <%= (@comment_summary || {}).size %>

        Managers

      </span>

    </div>

  </div>

<div class="table-container shadow-sm rounded-4">

  <div class="table-responsive premium-table-scroll">

    <table class="table bi-table align-middle mb-0">

      <thead class="table-light">




        <tr>

          <th width="70">

            Rank

          </th>

          <th>

            Team Member

          </th>

          <th class="text-center">

            Comments

          </th>

          <th width="35%">

            Productivity

          </th>

        </tr>

      </thead>

      <tbody>

     <% (@comment_summary || {})
    .values
    .sort_by { |x| -x[:comments_done] }
    .each_with_index do |row, index| %>

        <% percent =
          @highest_comments.zero? ?
          0 :
          ((row[:comments_done].to_f/@highest_comments)*100).round %>

        <tr>
<%
rank =
  case index
  when 0 then "🥇"
  when 1 then "🥈"
  when 2 then "🥉"
  else "##{index + 1}"
  end
%>

<td>
  <%= rank %>
</td>

          <td>

            <div class="d-flex align-items-center">

              <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"

                   style="width:46px;height:46px;">

                <i class="bi bi-person-fill"></i>

              </div>

              <div class="ms-3">

                <div class="fw-bold">

                  <%= row[:user].username.presence || row[:user].email %>

                </div>

                <small class="text-muted">

                  Lead Manager

                </small>

              </div>

            </div>

          </td>

          <td class="text-center">

            <span class="badge bg-success fs-6">

              <%= row[:comments_done] %>

            </span>

          </td>

          <td>

            <div class="progress" style="height:12px;">

              <div class="progress-bar bg-success"

                   style="width:<%= percent %>%">

              </div>

            </div>

            <small class="text-muted">

              <%= percent %>% of Top Performer

            </small>

          </td>

        </tr>

      <% end %>

      </tbody>

    </table>

  </div>

</div>

 


