<style>

.bi-dashboard {

    background:
    linear-gradient(135deg,#f8fafc,#eef2ff);

    min-height:100vh;

}


/* HERO */

.bi-hero {

    background:
    linear-gradient(135deg,#0f172a,#2563eb);

    color:white;

    border-radius:28px;

    overflow:hidden;

    position:relative;

}


.bi-hero:after {

    content:"";

    position:absolute;

    width:300px;

    height:300px;

    background:rgba(255,255,255,.08);

    border-radius:50%;

    right:-80px;

    top:-80px;

}


.bi-badge {

    background:rgba(255,255,255,.15);

    backdrop-filter:blur(10px);

    border-radius:50px;

    padding:10px 18px;

    display:inline-flex;

    align-items:center;

    gap:8px;

}



/* KPI CARDS */


.bi-card {

    border:0;

    border-radius:24px;

    background:white;

    box-shadow:
    0 15px 40px rgba(15,23,42,.08);

    transition:.3s;

}


.bi-card:hover {

    transform:translateY(-6px);

    box-shadow:
    0 25px 50px rgba(15,23,42,.15);

}



.icon-box {

    width:70px;

    height:70px;

    border-radius:22px;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:32px;

}



.kpi-number {

    font-size:2.2rem;

    font-weight:800;

}



.summary-card {

    border-radius:24px;

    background:white;

    box-shadow:
    0 10px 30px rgba(0,0,0,.08);

}



.summary-item {

    padding:15px;

    border-radius:18px;

    background:#f8fafc;

}



.summary-item h3 {

    font-weight:800;

}



.action-btn {

    border-radius:15px;

    padding:12px 22px;

    font-weight:600;

}


</style>



<div class="container-fluid py-4">

  <!-- ================================================= -->
  <!-- HERO -->
  <!-- ================================================= -->

  <div class="bi-hero mb-5">

    <div class="row align-items-center">

      <div class="col-lg-8">

        <span class="bi-badge">
          <i class="bi bi-whatsapp"></i>
          LIVE WHATSAPP ANALYTICS
        </span>

        <h2 class="mt-3 fw-bold mb-2">
          📱 WhatsApp Leads Analysis
        </h2>

        <p class="mb-0">
          Monitor lead volume, conversion, response performance
          and customer engagement.
        </p>

      </div>

      <div class="col-lg-4 text-end">

        <div class="hero-icon">
          <i class="bi bi-whatsapp"></i>
        </div>

      </div>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- PERIOD FILTER -->
  <!-- ================================================= -->

  <div class="analytics-toolbar mb-4">

    <div class="d-flex flex-wrap gap-2">

      <%= link_to jmleads_path(period: "all"),
          class: "period-btn #{'active' if @period == 'all'}" do %>

        <i class="bi bi-grid-3x3-gap me-1"></i>
        All

      <% end %>


    </div>

  </div>


