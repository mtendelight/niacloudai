<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

document.addEventListener("DOMContentLoaded", function () {


  /* =================================================
     DAILY LEADS
  ================================================= */

  const dailyCanvas =
    document.getElementById("dailyLeadsChart");


  if (dailyCanvas) {

    const dailyData =
      <%= raw @daily_leads.to_json %>;


    new Chart(dailyCanvas, {

      type: "line",

      data: {

        labels: dailyData.map(
          item => item.date
        ),

        datasets: [

          {
            label: "Total Leads",

            data: dailyData.map(
              item => item.total
            ),

            tension: 0.4,

            fill: true,

            borderWidth: 3,

            pointRadius: 3

          },

          {
            label: "Converted",

            data: dailyData.map(
              item => item.converted
            ),

            tension: 0.4,

            borderWidth: 3,

            pointRadius: 3

          }

        ]

      },

      options: {

        responsive: true,

        maintainAspectRatio: false,

        plugins: {

          legend: {

            position: "top"

          }

        },

        scales: {

          y: {

            beginAtZero: true,

            ticks: {

              precision: 0

            }

          }

        }

      }

    });

  }



  /* =================================================
     STATUS CHART
  ================================================= */

  const statusCanvas =
    document.getElementById("statusChart");


  if (statusCanvas) {

    const statusData =
      <%= raw @status_breakdown.to_h.to_json %>;


    new Chart(statusCanvas, {

      type: "doughnut",

      data: {

        labels: Object.keys(statusData),

        datasets: [{

          data: Object.values(statusData),

          borderWidth: 0

        }]

      },

      options: {

        responsive: true,

        maintainAspectRatio: false,

        cutout: "68%",

        plugins: {

          legend: {

            display: false

          }

        }

      }

    });

  }

});

</script>



