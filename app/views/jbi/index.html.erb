  flex-direction:column;

  gap:12px;

}

.status-row {

  display:flex;

  justify-content:space-between;

  align-items:center;

  font-size:.9rem;

  color:#475569;

}

.status-dot {

  width:9px;

  height:9px;

  border-radius:50%;

  background:#2563eb;

}



/* =====================================================
   STAFF
===================================================== */

.analytics-table {

  border-collapse:separate;

  border-spacing:0 8px;

}

.analytics-table thead th {

  border:0;

  color:#94a3b8;

  font-size:.72rem;

  text-transform:uppercase;

  letter-spacing:.8px;

  font-weight:800;

  padding:12px;

}

.analytics-table tbody tr {

  background:#f8fafc;

}

.analytics-table tbody td {

  border:0;

  padding:15px 12px;

}

.analytics-table tbody tr td:first-child {

  border-radius:12px 0 0 12px;

}

.analytics-table tbody tr td:last-child {

  border-radius:0 12px 12px 0;

}

.staff-cell {

  display:flex;

  align-items:center;

  gap:12px;

}

.staff-avatar {

  width:42px;

  height:42px;

  border-radius:13px;

  background:#eff6ff;

  color:#2563eb;

  display:flex;

  align-items:center;

  justify-content:center;

  font-weight:800;

}

.staff-cell small {

  display:block;

  color:#94a3b8;

  font-size:.72rem;

}

.badge-soft {

  padding:6px 11px;

  border-radius:20px;

  font-size:.75rem;

  font-weight:700;

}

.badge-soft.warning {

  background:#fff7ed;

  color:#c2410c;

}

.badge-soft.success {

  background:#f0fdf4;

  color:#15803d;

}



/* =====================================================
   PROGRESS
===================================================== */

.analytics-progress {

  height:8px;

  background:#e2e8f0;

  border-radius:20px;

}

.analytics-progress .progress-bar {

  border-radius:20px;

  background:#2563eb;

}



/* =====================================================
   AGING
===================================================== */

.aging-list {

  display:flex;

  flex-direction:column;

  gap:10px;

}

.aging-row {

  display:flex;

  justify-content:space-between;

  align-items:center;

  padding:14px;

  background:#f8fafc;

  border-radius:14px;

}

.aging-title {

  font-weight:700;

  font-size:.9rem;

  color:#334155;

}

.aging-subtitle {

  font-size:.72rem;

  color:#94a3b8;

  margin-top:3px;

}

.aging-badge {

  min-width:42px;

  text-align:center;

  padding:7px 10px;

  border-radius:10px;

  font-weight:800;

  font-size:.8rem;

}

.aging-badge.success {

  background:#f0fdf4;
  color:#15803d;

}

.aging-badge.warning {

  background:#fff7ed;
  color:#c2410c;

}

.aging-badge.danger {

  background:#fef2f2;
  color:#dc2626;

}



/* =====================================================
   ITEMS
===================================================== */

.items-list {

  display:flex;

  flex-direction:column;

  gap:10px;

}

.item-row {

  display:flex;

  align-items:center;

  gap:14px;

  padding:12px;

  background:#f8fafc;

  border-radius:13px;

}

.item-rank {

  width:32px;

  height:32px;

  border-radius:10px;

  background:#eff6ff;

  color:#2563eb;

  display:flex;

  align-items:center;

  justify-content:center;

  font-weight:800;

  font-size:.8rem;

}

.item-name {

  flex:1;

  font-size:.88rem;

  font-weight:600;

  color:#334155;

}

.item-count {

  font-weight:800;

  color:#0f172a;

}



/* =====================================================
   CUSTOMER
===================================================== */

.customer-name {

  display:flex;

  align-items:center;

  gap:10px;

}

.customer-avatar {

  width:36px;

  height:36px;

  border-radius:11px;

  display:flex;

  align-items:center;

  justify-content:center;

  background:#eff6ff;

  color:#2563eb;

}

.item-pill {

  display:inline-block;

  padding:6px 10px;

  background:#f1f5f9;

  border-radius:9px;

  font-size:.75rem;

  font-weight:600;

}

.status-badge {

  display:inline-flex;

  padding:6px 11px;

  border-radius:20px;

  font-size:.72rem;

  font-weight:800;

}

.status-badge.success {

  background:#f0fdf4;

  color:#15803d;

}

.status-badge.warning {

  background:#fff7ed;

  color:#c2410c;

}

.status-badge.secondary {

  background:#f1f5f9;

  color:#64748b;

}



/* =====================================================
