<style>

/* =====================================================
   UNCONTACTED LEADS
===================================================== */

.uncontacted-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
}


/* =====================================================
   BASE CARD
===================================================== */

.uncontacted-card {
  display: block;
  min-height: 145px;
  padding: 18px;
  border-radius: 16px;
  text-decoration: none;
  color: #343a40;
  line-height: 1.2;
  border: 1px solid #e5e7eb;
  background: #fff;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}


/* =====================================================
   CLEAR — 0 LEADS
===================================================== */

.card-clear {
  background: #f0fff4;
  border: 1px solid #86efac;
}

.card-clear .uc-icon {
  background: #dcfce7;
  color: #16a34a;
}

.card-clear .uc-count,
.card-clear .uc-status {
  color: #15803d;
}


/* =====================================================
   PENDING — HAS LEADS
===================================================== */

.card-pending {
  background: #fff5f5;
  border: 1px solid #fca5a5;
}

.card-pending .uc-icon {
  background: #fee2e2;
  color: #dc2626;
}

.card-pending .uc-count,
.card-pending .uc-status {
  color: #b91c1c;
}


/* =====================================================
   TOP ROW
===================================================== */

.uc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}


/* =====================================================
   ICON
===================================================== */

.uc-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;

  font-size: 18px;

  flex-shrink: 0;
}


/* =====================================================
   ARROW
===================================================== */

.uc-arrow {
  font-size: 15px;
  color: #adb5bd;

  transition:
    transform .2s ease,
    color .2s ease;
}

.uncontacted-card:hover .uc-arrow {
  color: #dc3545;
  transform: translateX(3px);
}


/* =====================================================
   COUNT
===================================================== */

.uc-count {
  display: block;

  font-size: 2.4rem;
  font-weight: 900;

  line-height: 1;

  margin-bottom: 12px;

  letter-spacing: -1px;
}


/* =====================================================
   DATE
===================================================== */

.uc-date {
  display: flex;
  align-items: center;

  gap: 6px;

  font-size: .9rem;

  font-weight: 700;

  color: #64748b;

  margin-bottom: 8px;
}

.uc-date i {
  font-size: 14px;
}


/* =====================================================
   STATUS
===================================================== */

.uc-status {
  display: flex;
  align-items: center;

  gap: 6px;

  font-size: .75rem;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: .5px;
}

.uc-status i {
  font-size: 10px;
}


/* =====================================================
   HOVER
===================================================== */

.uncontacted-card:hover,
.uncontacted-card.active {

  text-decoration: none;

  transform: translateY(-5px);

  box-shadow:
    0 10px 25px rgba(15, 23, 42, .10),
    0 20px 40px rgba(15, 23, 42, .06);
}

.card-clear:hover,
.card-clear.active {
  border-color: #22c55e;
}

.card-pending:hover,
.card-pending.active {
  border-color: #ef4444;
}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 768px) {

  .uncontacted-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .uncontacted-card {
    min-height: 125px;
    padding: 14px;
    border-radius: 14px;
  }

  .uc-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    font-size: 16px;
  }

  .uc-count {
    font-size: 2rem;
  }

  .uc-date {
    font-size: .78rem;
  }

  .uc-status {
    font-size: .65rem;
  }

}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media (max-width: 480px) {

  .uncontacted-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .uncontacted-card {
    min-height: 120px;
    padding: 13px;
    border-radius: 13px;
  }

  .uc-top {
    margin-bottom: 9px;
  }

  .uc-icon {
    width: 34px;
    height: 34px;
    font-size: 15px;
  }

  .uc-arrow {
    font-size: 13px;
  }

  .uc-count {
    font-size: 1.85rem;
    margin-bottom: 9px;
  }

  .uc-date {
    font-size: .72rem;
    margin-bottom: 6px;
  }

  .uc-status {
    font-size: .6rem;
  }

}

</style>

