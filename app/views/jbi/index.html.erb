<%= render "layouts/header" %>

<div class="container">

<div class="bi-fullscreen-dashboard">
<div class="container py-4">


	


<style>

/* ==========================================
   JANOMAX PREMIUM BI HEADER
========================================== */

.bi-header .card {

border-radius:28px;

background:white;

overflow:hidden;

}



.bi-gradient {

background:
linear-gradient(
135deg,
#020617 0%,
#0f172a 35%,
#1d4ed8 75%,
#2563eb 100%
);

position:relative;

}



.bi-gradient::after{

content:"";

position:absolute;

width:400px;
height:400px;

right:-120px;
top:-120px;

background:
rgba(255,255,255,.08);

border-radius:50%;

}



/* TITLE ICON */

.bi-icon {

width:82px;
height:82px;

border-radius:24px;

background:
linear-gradient(
135deg,
rgba(255,255,255,.25),
rgba(255,255,255,.08)
);

backdrop-filter:blur(10px);

display:flex;

align-items:center;

justify-content:center;

font-size:38px;

color:white;

box-shadow:
0 15px 35px rgba(0,0,0,.25);

}



.bi-header h2{

letter-spacing:-.5px;

font-size:2rem;

}



/* STATUS PILLS */

.bi-pill {

display:flex;

align-items:center;

gap:6px;

background:
rgba(255,255,255,.12);

border:

1px solid rgba(255,255,255,.2);

padding:

.65rem 1.1rem;

border-radius:50px;

color:white;

font-size:.85rem;

font-weight:600;

backdrop-filter:blur(8px);

}



.bi-pill i{

font-size:1rem;

}



/* KPI CARDS */

.mini-kpi {


background:

linear-gradient(
145deg,
#ffffff,
#f8fafc
);


border-radius:22px;

padding:16px;


display:flex;

align-items:center;

gap:14px;


border:

1px solid #e2e8f0;


transition:.35s;


}



.mini-kpi:hover{


transform:
translateY(-6px);


box-shadow:

0 18px 35px rgba(15,23,42,.15);


}



.mini-kpi small{

font-size:.75rem;

text-transform:uppercase;

letter-spacing:.8px;

color:#64748b;

font-weight:700;

}



.mini-kpi h4{

font-size:1.45rem;

color:#0f172a;

margin-top:3px;

}



/* KPI ICONS */

.mini-icon {


width:52px;

height:52px;


border-radius:18px;


display:flex;

align-items:center;

justify-content:center;


font-size:23px;


box-shadow:

0 8px 20px rgba(0,0,0,.15);


}



/* Better gradients */

.bg-success{

background:
linear-gradient(135deg,#22c55e,#15803d)!important;

}


.bg-primary{

background:
linear-gradient(135deg,#3b82f6,#1d4ed8)!important;

}


.bg-warning{

background:
linear-gradient(135deg,#facc15,#d97706)!important;

}


.bg-danger{

background:
linear-gradient(135deg,#ef4444,#991b1b)!important;

}



/* MODULE NAVIGATION */


.bg-white{

background:#ffffff!important;

}



.module-chip {


display:flex;

align-items:center;

gap:8px;


background:

#f8fafc;


border:

1px solid #e2e8f0;


padding:

.7rem 1.15rem;


border-radius:18px;


font-size:.88rem;

font-weight:700;


color:#334155;


transition:.3s;


}



.module-chip i{

font-size:1.1rem;

color:#2563eb;

}



.module-chip:hover {


background:

linear-gradient(
135deg,
#2563eb,
#1d4ed8
);


color:white;


border-color:#2563eb;


transform:

translateY(-4px);


box-shadow:

0 12px 25px rgba(37,99,235,.25);


}



.module-chip:hover i{

color:white;

}



/* LIVE ANALYTICS DOT */

.bi-pill:nth-child(2)::before{


content:"";


width:8px;

height:8px;

background:#22c55e;

border-radius:50%;


box-shadow:

0 0 10px #22c55e;


}



/* MOBILE */

@media(max-width:768px){


.bi-gradient{

padding:1.5rem!important;

}


.bi-icon{

width:65px;

height:65px;

font-size:30px;

}


.bi-header h2{

font-size:1.45rem;

}


.mini-kpi{


border-radius:18px;


}


.module-chip{

width:100%;

justify-content:center;

}


}



</style>


<style>
	/*====================================================
 HERO
====================================================*/


.metric-value{
    font-size:clamp(1.6rem,3vw,2.8rem);
    font-weight:800;
    line-height:1.1;
    color:#0f172a;
    margin-bottom:10px;
    white-space:nowrap;
    overflow:visible;
    text-overflow:unset;
    word-break:keep-all;
}

.metric-title{
    font-size:.82rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:1px;
    color:#94a3b8;
    margin-bottom:8px;
}

.metric-subtitle{
    font-size:.85rem;
    color:#64748b;
    white-space:nowrap;
}

.metric-card{
    min-height:165px;
    padding:24px;
}

.bi-hero{

background:linear-gradient(135deg,#0f172a,#2563eb);

border-radius:24px;

padding:45px;

color:#fff;

box-shadow:0 25px 60px rgba(37,99,235,.18);

}

.bi-badge{

display:inline-flex;

align-items:center;

gap:8px;

background:rgba(255,255,255,.15);

padding:8px 18px;

border-radius:30px;

font-size:.75rem;

font-weight:700;

letter-spacing:1px;

}

.hero-icon{

font-size:6rem;

opacity:.18;

}

/*====================================================
 KPI
====================================================*/

.metric-card{

background:#fff;

border-radius:22px;

padding:28px;

border:1px solid #edf2f7;

position:relative;

overflow:hidden;

transition:.35s;

height:100%;

box-shadow:

0 4px 15px rgba(15,23,42,.05),

0 18px 45px rgba(15,23,42,.05);

}

.metric-card:hover{

transform:translateY(-8px);

box-shadow:

0 15px 30px rgba(15,23,42,.10),

0 30px 70px rgba(37,99,235,.15);

}

.metric-card::before{

content:"";

position:absolute;

top:0;

left:0;

width:100%;

height:5px;

background:var(--accent);

}

.metric-title{

font-size:.78rem;

font-weight:700;

letter-spacing:1.2px;

text-transform:uppercase;

color:#94a3b8;

margin-bottom:12px;

}

.metric-value{

font-size:2.6rem;

font-weight:800;

line-height:1;

color:#0f172a;

margin-bottom:15px;

}

.metric-subtitle{

font-size:.9rem;

color:#64748b;

}

.metric-icon{

width:74px;

height:74px;

border-radius:20px;

display:flex;

align-items:center;

justify-content:center;

font-size:2rem;

background:rgba(37,99,235,.08);

color:var(--accent);

transition:.35s;

}

.metric-card:hover .metric-icon{

transform:rotate(-10deg) scale(1.08);

}

/*====================================================
 COLORS
====================================================*/

.metric-primary{--accent:#2563eb;}
.metric-warning{--accent:#f59e0b;}
.metric-info{--accent:#06b6d4;}
.metric-success{--accent:#22c55e;}
.metric-danger{--accent:#ef4444;}
.metric-purple{--accent:#7c3aed;}
.metric-dark{--accent:#111827;}

.metric-primary .metric-icon{background:#eff6ff;}
.metric-warning .metric-icon{background:#fff7ed;}
.metric-info .metric-icon{background:#ecfeff;}
.metric-success .metric-icon{background:#f0fdf4;}
.metric-danger .metric-icon{background:#fef2f2;}
.metric-purple .metric-icon{background:#faf5ff;}
.metric-dark .metric-icon{background:#f3f4f6;}

/*====================================================
 RESPONSIVE
====================================================*/

@media(max-width:992px){

.bi-hero{

padding:30px;

}

.hero-icon{

display:none;

}

.metric-value{

font-size:2rem;

}

}
</style>


<style>
	
	/*==================================================
  PERFORMANCE PANEL
==================================================*/

.performance-card{

    border:none;

    border-radius:28px;

    overflow:hidden;

    background:#fff;

    box-shadow:
        0 8px 30px rgba(15,23,42,.06),
        0 20px 60px rgba(15,23,42,.05);

}

/*==================================================
HEADER
==================================================*/

.performance-header{

    padding:22px 30px;

    background:
        linear-gradient(135deg,#0f172a,#1e3a8a);

    color:#fff;

    display:flex;

    align-items:center;

    justify-content:space-between;

}

.performance-title{

    display:flex;

    align-items:center;

    gap:12px;

}

.performance-title i{

    font-size:1.4rem;

    color:#38bdf8;

}

.performance-title h5{

    margin:0;

    font-weight:800;

    font-size:1.2rem;

}

.performance-title p{

    margin:2px 0 0;

    color:rgba(255,255,255,.70);

    font-size:.88rem;

}

.live-badge{

    background:rgba(255,255,255,.12);

    border:1px solid rgba(255,255,255,.15);

    color:#fff;

    padding:8px 18px;

    border-radius:30px;

    font-size:.78rem;

    font-weight:700;

}

/*==================================================
TABLE
==================================================*/

.performance-table{

    margin:0;

}

.performance-table thead th{

    background:#f8fafc;

    color:#64748b;

    border:none;

    padding:18px;

    text-transform:uppercase;

    font-size:.75rem;

    letter-spacing:1px;

    font-weight:800;

}

.performance-table tbody td{

    padding:18px;

    border-top:1px solid #eef2f7;

    vertical-align:middle;

}

.performance-table tbody tr{

    transition:.25s;

}

.performance-table tbody tr:hover{

    background:#f8fbff;

    transform:scale(1.003);

}

/*==================================================
USER
==================================================*/

.team-user{

    display:flex;

    align-items:center;

    gap:14px;

}

.team-avatar{

    width:52px;

    height:52px;

    border-radius:18px;

    display:flex;

    align-items:center;

    justify-content:center;

    background:
        linear-gradient(135deg,#2563eb,#60a5fa);

    color:#fff;

    font-size:1.25rem;

    box-shadow:
        0 10px 20px rgba(37,99,235,.18);

}

.team-name{

    font-size:1rem;

    font-weight:800;

    color:#0f172a;

}

.team-role{

    color:#64748b;

    font-size:.82rem;

}

/*==================================================
METRIC BADGES
==================================================*/

.metric-pill{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    min-width:70px;

    padding:10px 18px;

    border-radius:999px;

    font-weight:800;

    font-size:.92rem;

    color:#fff;

}

.metric-dispatched{

    background:
        linear-gradient(135deg,#0284c7,#38bdf8);

}

.metric-delivered{

    background:
        linear-gradient(135deg,#16a34a,#22c55e);

}

.metric-refunded{

    background:
        linear-gradient(135deg,#dc2626,#ef4444);

}

.metric-total{

    background:
        linear-gradient(135deg,#0f172a,#334155);

}

/*==================================================
ROW RANK
==================================================*/

.rank-chip{

    width:34px;

    height:34px;

    border-radius:12px;

    display:flex;

    align-items:center;

    justify-content:center;

    background:#eff6ff;

    color:#2563eb;

    font-weight:800;

    margin-right:14px;

}

/*==================================================
SUMMARY BAR
==================================================*/

.performance-footer{

    background:#f8fafc;

    padding:22px 30px;

    border-top:1px solid #edf2f7;

}

.summary-item{

    text-align:center;

}

.summary-value{

    font-size:1.8rem;

    font-weight:800;

    color:#0f172a;

}

.summary-label{

    color:#64748b;

    font-size:.82rem;

    text-transform:uppercase;

    letter-spacing:.5px;

}

/*==================================================
RESPONSIVE
==================================================*/

@media(max-width:992px){

.performance-header{

    flex-direction:column;

    align-items:flex-start;

    gap:18px;

}

.performance-table{

    min-width:760px;

}

}

@media(max-width:768px){

.performance-card{

    border-radius:20px;

}

.performance-header{

    padding:20px;

}

.performance-footer{

    padding:20px;

}

.team-avatar{

    width:44px;

    height:44px;

}

.metric-pill{

    min-width:56px;

    padding:8px 12px;

    font-size:.82rem;

}

}




.bi-fullscreen-dashboard {

    width:100%;

    min-height:100vh;

    padding:15px;

}



/* Remove bootstrap container restrictions */

.container,
.container-fluid {

    max-width:none !important;

    width:100% !important;

}



/* Larger dashboard cards */

.card {

    border-radius:22px !important;

    box-shadow:
    0 10px 35px rgba(15,23,42,.08);

}



/* Bigger BI tables */

.table {

    font-size:1rem;

}


.table th {

    font-size:.85rem;

    letter-spacing:.05em;

}



/* Dashboard cards spacing */

.row {

    --bs-gutter-x:1.5rem;

}



/* Sticky tables for TV display */

.table-responsive {

    max-height:none;

}



/* Hide scroll bars for clean TV look */

::-webkit-scrollbar {

    width:0;

    height:0;

}



/* Make charts larger */

canvas {

    max-height:420px !important;

}



/* Mobile */

@media(max-width:768px){

    .bi-fullscreen-dashboard{

        padding:8px;

    }


    .card{

        border-radius:15px !important;

    }

}


</style>






