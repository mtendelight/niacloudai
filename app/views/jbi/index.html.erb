<div class="uncontacted-grid">

  <% @uncontacted_days.each do |day| %>

  <%= link_to jmleads_path(
        filter: "uncontacted",
        uncontacted_date: day[:date]
      ),
      class: "uncontacted-card #{day[:count].zero? ? 'card-clear' : 'card-pending'} #{'active' if params[:uncontacted_date] == day[:date].to_s}" do %>

    <div class="uc-top">

      <span class="uc-icon">
        <% if day[:count].zero? %>
          <i class="bi bi-check-circle-fill"></i>
        <% else %>
          <i class="bi bi-person-x-fill"></i>
        <% end %>
      </span>

      <i class="bi bi-arrow-up-right uc-arrow"></i>

    </div>

    <strong class="uc-count">
      <%= day[:count] %>
    </strong>

    <span class="uc-date">
      <i class="bi bi-calendar3"></i>
      <%= day[:date].strftime("%d %b") %>
    </span>

    <span class="uc-status">

      <% if day[:count].zero? %>

        <i class="bi bi-check-circle-fill"></i>
        Clear

      <% else %>

        <i class="bi bi-exclamation-circle-fill"></i>
        Pending

      <% end %>

    </span>

  <% end %>

