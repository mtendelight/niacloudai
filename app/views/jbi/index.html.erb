<script>
document.addEventListener("DOMContentLoaded", function () {

  /* =====================================================
     JANOMAX LEAD ACTIVITY
  ===================================================== */

  const leadCanvas = document.getElementById("janomaxLeadActivityChart");

  if (leadCanvas) {

    const dailyLeads = <%= raw(@daily_leads.to_json) %>;
    const dailyConversions = <%= raw(@daily_conversions.to_json) %>;

    const labels = Object.keys(dailyLeads);

    new Chart(leadCanvas, {
      type: "line",

      data: {
        labels: labels,

        datasets: [
          {
            label: "Leads",
            data: labels.map(date => dailyLeads[date] || 0),
            tension: 0.4,
            fill: true,
            borderWidth: 3,
            pointRadius: 3
          },

          {
            label: "Converted",
            data: labels.map(date => dailyConversions[date] || 0),
            tension: 0.4,
            fill: false,
            borderWidth: 3,
            pointRadius: 3
          }
        ]
      },

      options: {
        responsive: true,
        maintainAspectRatio: false,

        plugins: {
          legend: {
            position: "top"
          }
        },

        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0
            }
          }
        }
      }
    });
  }


  /* =====================================================
     LEAD STATUS
  ===================================================== */

  const statusCanvas =
    document.getElementById("janomaxLeadStatusChart");

  if (statusCanvas) {

    new Chart(statusCanvas, {

      type: "doughnut",

      data: {
        labels: [
          "Open",
          "Converted"
        ],

        datasets: [{
          data: [
            <%= @open_leads.to_i %>,
            <%= @converted.to_i %>
          ],

          borderWidth: 0
        }]
      },

      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: "65%",

        plugins: {
          legend: {
            position: "bottom"
          }
        }
      }
    });
  }


  /* =====================================================
     CALL ACTIVITY
  ===================================================== */

  const callsCanvas =
    document.getElementById("janomaxCallsChart");

  if (callsCanvas) {

    const dailyCalls =
      <%= raw(@daily_calls.to_json) %>;

    new Chart(callsCanvas, {

      type: "bar",

      data: {

        labels: Object.keys(dailyCalls),

        datasets: [{
          label: "Calls",

          data: Object.values(dailyCalls),

          borderRadius: 8,

          borderSkipped: false
        }]
      },

      options: {

        responsive: true,

        maintainAspectRatio: false,

        plugins: {
          legend: {
            display: false
          }
        },

        scales: {

          y: {
            beginAtZero: true,

            ticks: {
              precision: 0
            }
          }

        }
      }
    });
  }


  /* =====================================================
     CALL STATUS
  ===================================================== */

  const callStatusCanvas =
    document.getElementById("janomaxCallStatusChart");

  if (callStatusCanvas) {

    const callStatus =
      <%= raw(@call_status.to_json) %>;

    new Chart(callStatusCanvas, {

      type: "doughnut",

      data: {

        labels: Object.keys(callStatus),

        datasets: [{
          data: Object.values(callStatus),

          borderWidth: 0
        }]
      },

      options: {

        responsive: true,

        maintainAspectRatio: false,

        cutout: "65%",

        plugins: {

          legend: {

            position: "bottom",

            labels: {
              usePointStyle: true,
              padding: 15
            }
          }
        }
      }
    });
  }

});
</script>


