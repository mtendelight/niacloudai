<div class="container py-4">
<!-- Page Header -->
<div class="card border-0 shadow-sm rounded-4 mb-4">

  <div class="card-body p-4">

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

      <div class="d-flex align-items-center">

        <div class="rounded-4 bg-primary bg-gradient text-white d-flex align-items-center justify-content-center me-3"
             style="width:64px;height:64px;">
          <i class="bi bi-chat-left-dots-fill fs-2"></i>
        </div>

        <div>

          <h3 class="fw-bold mb-1">
            Customer Message Register
          </h3>

          <p class="text-muted mb-0">
            View and manage incoming WhatsApp customer conversations and AI knowledge improvements.
          </p>

        </div>

      </div>

      <div class="d-flex flex-wrap gap-3">

        <!-- Messages -->
        <div class="badge rounded-pill bg-primary fs-6 px-4 py-3 shadow-sm">

          <i class="bi bi-envelope-fill me-2"></i>

          <%= number_with_delimiter(@logs.total_count) %>

          Messages

        </div>

        <!-- AI Feedback -->
        <%= link_to knowledge_feedbacks_path,
            class: "text-decoration-none" do %>

          <div class="badge rounded-pill bg-warning text-dark fs-6 px-4 py-3 shadow-sm">

            <i class="bi bi-lightbulb-fill me-2"></i>

            <%= number_with_delimiter(KnowledgeFeedback.count) %>

            Feedbacks

          </div>

        <% end %>

      </div>

    </div>

  </div>

</div>

  <!-- Search -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body">
      <div class="login">

      <%= form_with url: ailogs_path,
                    method: :get,
                    local: true do %>

        <div class="row g-3 align-items-center">

          <div class="col-lg">

            <div class="input-group">

              <span class="input-group-text bg-white border-end-0 rounded-start-pill">

                <i class="bi bi-search text-primary"></i>

              </span>

              <%= text_field_tag :search,
                                 params[:search],
                                 class: "form-control border-start-0 rounded-end-pill ps-0",
                                 placeholder: "Search customer, phone or message..." %>

            </div>

          </div>

          <%= hidden_field_tag :per_page, params[:per_page] %>

          <div class="col-auto">

            <button class="btn btn-primary rounded-pill px-4">

              <i class="bi bi-search me-1"></i>

              Search

            </button>

          </div>

          <% if params[:search].present? %>

            <div class="col-auto">

              <%= link_to ailogs_path(per_page: params[:per_page]),
                          class: "btn btn-outline-secondary rounded-pill px-4" do %>

                <i class="bi bi-x-circle me-1"></i>

                Clear

              <% end %>

            </div>

          <% end %>

        </div>

      <% end %>

    </div>

  </div></div>



<script>
document.addEventListener("DOMContentLoaded", () => {

  // Per page
  const select = document.getElementById("rows-per-page");

  if (select) {
    select.addEventListener("change", () => {
      document.getElementById("rows-per-page-form").submit();
    });
  }

  // Search
  const input = document.getElementById("search-input");
  const clear = document.getElementById("clear-search");
  const form = document.getElementById("search-form");

  if (input) {

    let timer;

    input.addEventListener("keyup", () => {

      clear.style.display = input.value.length ? "flex" : "none";

      clearTimeout(timer);

      timer = setTimeout(() => {
        form.submit();
      }, 400);

    });

    clear.addEventListener("click", () => {
      input.value = "";
      clear.style.display = "none";
      form.submit();
    });

  }

});
</script>

