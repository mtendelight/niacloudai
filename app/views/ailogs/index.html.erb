<script>
let conversationModalInstance = null;


document.addEventListener("DOMContentLoaded", function(){

  document.querySelectorAll(".open-chat-link").forEach(link => {

    link.addEventListener("click", function(e){

      e.preventDefault();


      const url = this.href;

      const content = document.getElementById("conversationContent");


      content.innerHTML = `
        <div class="text-center py-5">
          <div class="spinner-border text-primary"></div>
          <div class="mt-2">
            Loading conversation...
          </div>
        </div>
      `;


      const modalElement = document.getElementById("conversationModal");


      conversationModalInstance = new bootstrap.Modal(modalElement);

      conversationModalInstance.show();


      fetch(url)
        .then(response => response.text())
        .then(html => {

          content.innerHTML = html;


          const box = content.querySelector(".conversation-box");

          if(box){
            box.scrollTop = box.scrollHeight;
          }

        })
        .catch(error => {

          console.error(error);

          content.innerHTML = `
            <div class="alert alert-danger">
              Failed loading conversation
            </div>
          `;

        });

    });

  });


});
</script>

<script>
document.addEventListener("click", function(e){

  const closeButton = e.target.closest("[data-bs-dismiss='modal']");

  if(closeButton && conversationModalInstance){

    conversationModalInstance.hide();

  }

});
</script>