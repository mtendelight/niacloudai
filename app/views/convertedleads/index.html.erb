  <%= render 'jmleads/submenu' %>

<% if current_user&.superadmin? || current_user&.manager? %>
    <% if @jmleads.any? %>
      <!-- Leads Table -->
      <div class="table-responsive shadow-sm rounded mt-3">
        <table class="table table-hover align-middle mb-0">
       <thead class="bg-primary text-white text-uppercase text-center">
  <tr>
    <th><i class="bi bi-hash me-1"></i> Unique ID</th>
    <th><i class="bi bi-person-badge-fill me-1"></i> Name</th>
    <th><i class="bi bi-telephone-outbound-fill me-1"></i> Phone</th>
    <th><i class="bi bi-bag-fill me-1"></i> Items Required</th>
    <th><i class="bi bi-person-check-fill me-1"></i> Assigned To</th>
    <th><i class="bi bi-bell-fill me-1"></i> Status</th>
    <th class="text-center"><i class="bi bi-tools me-1"></i> Actions</th>
  </tr>
</thead>


         <tbody>
  <% @jmleads.each do |lead| %>
    <tr>
      <!-- Unique ID -->
      <td class="fw-semibold text-muted text-center">
        <%= lead.sglid || "—" %>
      </td>

      <!-- Name -->
      <td class="fw-semibold text-dark">
        <i class="bi bi-person-badge-fill text-primary me-2"></i>
        <%= lead.name %>
      </td>

      <!-- Phone -->
      <td>
        <i class="bi bi-telephone-outbound-fill text-success me-2"></i>
        <%= lead.phone %>
      </td>

      <!-- Items Required -->
      <td>
        <div class="d-flex align-items-center text-secondary">
          <i class="bi bi-bag-fill text-warning me-2"></i>
          <%= truncate(lead.items_required, length: 25) %>
        </div>
      </td>

      <!-- Assigned To -->
      <td class="text-center">
        <% if lead.jstaff.present? %>
          <span class="badge bg-info text-dark px-3 py-2">
            <i class="bi bi-person-check-fill me-1"></i>
            <%= lead.jstaff.name %>
          </span>
        <% else %>
          <span class="badge bg-secondary px-3 py-2">
            Unassigned
          </span>
        <% end %>
      </td>

      <!-- Status -->
      <td class="text-center">
        <% if lead.status == "converted" %>
          <span class="badge bg-success px-3 py-2">
            <i class="bi bi-check-circle-fill"></i> Converted
          </span>
        <% else %>
          <span class="badge bg-warning text-dark px-3 py-2">
            <i class="bi bi-clock-history"></i> Pending
          </span>
        <% end %>
      </td>

      <!-- Actions -->
      <td class="text-center">
        <div class="d-flex justify-content-center gap-2">
          <%= link_to jmlead_path(lead),
            class: "btn btn-sm btn-outline-primary btn-action",
            title: "View Lead",
            data: { turbo: false } do %>
            <i class="bi bi-eye"></i> View
          <% end %>

          <%= link_to edit_jmlead_path(lead),
            class: "btn btn-sm btn-outline-success btn-action",
            title: "Edit Lead",
            data: { turbo: false } do %>
            <i class="bi bi-pencil-fill"></i> Edit
          <% end %>
        </div>
      </td>
    </tr>
  <% end %>
</tbody>

        </table>
      </div>
    <% else %>
      <!-- No Leads -->
      <div class="alert alert-info text-center mt-4 shadow-sm">
        <i class="bi bi-info-circle-fill me-2"></i>
        No leads found.
        <%= link_to new_jmlead_path, class: "alert-link fw-semibold" do %>
          <i class="bi bi-plus-circle me-1"></i> Add one now
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="digg_pagination">
  <div class="pagination justify-content-center">
    <%= paginate  @jmleads %>
  </div>

  <div class="login text-center mt-3">
    <%= form_with url: request.path, method: :get, local: true, id: 'rows-per-page-form' do |f| %>
      <%= f.label :per_page, "Rows per page" %>
    <%= f.select :per_page,
  options_for_select([10, 25, 50, 100, 250, 500, 1000], params[:per_page] || 5),
  {},
  class: "form-select form-select-sm d-inline-block w-auto",
  id: "rows-per-page" %>
    <% end %>
  </div>

  <br/>
  <center><%= page_entries_info  @jmleads %></center>
</div>


</div>





<script>

  document.addEventListener("DOMContentLoaded", () => {
  const select = document.getElementById("rows-per-page");
  if (select) {
    select.addEventListener("change", () => {
      document.getElementById("rows-per-page-form").submit();
    });
  }
});


</script>

<!-- JS -->
<script>
function attachMenuLoadingHandlers() {
  document.querySelectorAll(".submenu-link").forEach(link => {
    if (link.dataset.bound === "true") return;
    link.dataset.bound = "true";

    link.addEventListener("click", () => {
      if (link.classList.contains("disabled")) return;

      const textEl = link.querySelector(".menu-text");
      const loadingIcon = link.querySelector(".menu-loading");
      const loadingText = link.dataset.loadingText || "Loading...";

      if (textEl) textEl.textContent = loadingText;
      if (loadingIcon) loadingIcon.classList.remove("d-none");
      link.classList.add("disabled");
    });
  });
}

document.addEventListener("turbo:load", attachMenuLoadingHandlers);
document.addEventListener("DOMContentLoaded", attachMenuLoadingHandlers);
</script>

