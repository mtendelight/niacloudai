<%= render "layouts/header" %>


<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

  <div class="d-flex align-items-center">

    <%= link_to janomaxleads_path,
        class: "btn btn-light border rounded-circle shadow-sm me-3",
        title: "Back to Leads" do %>

      <i class="bi bi-arrow-left fs-5"></i>

    <% end %>

    <div>

      <h3 class="fw-bold mb-1">
        <i class="bi bi-person-lines-fill text-primary me-2"></i>
        Lead Details
      </h3>

      <small class="text-muted">
        Complete lead, customer & payment history
      </small>

    </div>



  </div>

    <%= link_to janomaxleads_path,
        class: "btn btn-light border rounded-pill shadow-sm px-4" do %>

      <i class="bi bi-arrow-left-circle me-2"></i>
      Back

    <% end %>

  <div class="d-flex gap-2">

    <%= link_to dashboard_janomaxleads_path,
        class: "btn btn-primary rounded-pill shadow-sm px-4" do %>

      <i class="bi bi-speedometer2 me-2"></i>
      Dashboard

    <% end %>

  </div>

</div>




<div class="row g-3">

  <div class="col-lg-4">

    <div class="card border-0 shadow-sm rounded-4 h-100">

      <div class="card-body">

        <div class="d-flex align-items-center mb-4">

          <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
            <i class="bi bi-person-badge-fill fs-3 text-primary"></i>
          </div>

          <div>
            <h5 class="fw-bold mb-0">
              Lead Information
            </h5>

            <small class="text-muted">
              CRM Lead Profile
            </small>

          </div>

        </div>


        <div class="mb-3">

          <small class="text-muted">
            Lead ID
          </small>

          <div class="fw-bold fs-5">
            #<%= @lead.id %>
          </div>

        </div>


        <div class="mb-3">

          <small class="text-muted">
            Status
          </small>

          <div>

            <% badge =
              case @lead.lead_status.to_s.downcase
              when "open"
                "bg-warning text-dark"
              when "converted"
                "bg-success"
              when "closed"
                "bg-danger"
              else
                "bg-secondary"
              end %>

            <span class="badge <%= badge %> rounded-pill px-3 py-2">

              <i class="bi bi-circle-fill me-1" style="font-size:7px;"></i>

              <%= @lead.lead_status.to_s.titleize %>

            </span>

          </div>

        </div>


        <div>

          <small class="text-muted">
            Customer Phone
          </small>

          <div class="fw-semibold">

            <i class="bi bi-telephone-fill text-success me-2"></i>

            <%= @lead.phone %>

          </div>

        </div>

      </div>

    </div>

  </div>


  <div class="col-lg-4">

    <div class="card border-0 shadow-sm rounded-4 h-100">

      <div class="card-body">

        <div class="d-flex align-items-center mb-4">

          <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">

            <i class="bi bi-person-vcard-fill fs-3 text-success"></i>

          </div>

          <div>

            <h5 class="fw-bold mb-0">
              Customer
            </h5>

            <small class="text-muted">
              Linked CRM Customer
            </small>

          </div>

        </div>


        <% if @customer.present? %>

          <div class="mb-3">

            <small class="text-muted">
              Full Name
            </small>

            <div class="fw-semibold">
              <%= @customer.name %>
            </div>

          </div>


          <div class="mb-3">

            <small class="text-muted">
              Phone
            </small>

            <div>
              <i class="bi bi-telephone-fill text-success me-2"></i>
              <%= @customer.phone %>
            </div>

          </div>


          <div class="mb-4">

            <small class="text-muted">
              Location
            </small>

            <div>
              <i class="bi bi-geo-alt-fill text-danger me-2"></i>
              <%= @customer.location.presence || "Not Available" %>
            </div>

          </div>


          <%= link_to @customer,
              class: "btn btn-success rounded-pill w-100" do %>

              <i class="bi bi-person-lines-fill me-2"></i>

              Open Customer

          <% end %>

        <% else %>

          <div class="text-center py-5">

            <i class="bi bi-person-x fs-1 text-secondary"></i>

            <div class="mt-3 text-muted">

              No customer linked yet.

            </div>

          </div>

        <% end %>

      </div>

    </div>

  </div>



  <div class="col-lg-4">

    <div class="card border-0 shadow-sm rounded-4 h-100">

      <div class="card-body p-0">

        <div class="p-4 border-bottom">

          <div class="d-flex justify-content-between align-items-center">

            <div>

              <h5 class="fw-bold mb-0">

                <i class="bi bi-credit-card-fill text-warning me-2"></i>

                Payments

              </h5>

              <small class="text-muted">

                Customer Transactions

              </small>

            </div>

            <span class="badge bg-primary rounded-pill">

              <%= @payments.count %>

            </span>

          </div>

        </div>


        <% if @payments.any? %>

          <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

              <thead class="table-light">

                <tr>

                  <th>

                    <i class="bi bi-calendar-event me-1"></i>

                    Date

                  </th>

                  <th class="text-end">

                    <i class="bi bi-cash-stack me-1"></i>

                    Amount

                  </th>

                </tr>

              </thead>

              <tbody>

                <% @payments.each do |payment| %>

                  <tr>

                    <td>

                      <%= payment.created_at.strftime("%d %b %Y") %>

                    </td>

                    <td class="text-end fw-bold text-success">

                      <%= number_to_currency(payment.amount, unit: "KES ") %>

                    </td>

                  </tr>

                <% end %>

              </tbody>

            </table>

          </div>

        <% else %>

          <div class="text-center py-5">

            <i class="bi bi-wallet2 fs-1 text-secondary"></i>

            <div class="mt-3 text-muted">

              No payments recorded

            </div>

          </div>

        <% end %>

      </div>

    </div>

  </div>

</div>

 <hr/>
<div class="login">

<%= form_with model: @janomaxlead, local: true do |f| %>

  <div class="card border-0 shadow-sm rounded-4">

    <div class="card-header bg-white border-0 py-3">
      <h6 class="mb-0 fw-bold">
        <i class="bi bi-chat-left-text-fill text-primary me-2"></i>
        Customer Care Notes
      </h6>
    </div>

    <div class="card-body">

      <%= f.text_area :comments,
          value: nil,
          rows: 4,
          class: "form-control rounded-4 shadow-sm",
          placeholder: "Write today's customer update..." %>

      <div class="text-end mt-3">

        <%= f.submit "Save Comment",
            class: "btn btn-primary rounded-pill px-4" %>

      </div>

    </div>

  </div>

<% end %>
</div>

<% comments = @lead.comments.to_s.split("\n\n").reject(&:blank?).reverse %>

<% if comments.any? %>

<div class="comment-list">

  <% comments.each do |comment| %>

    <% time = comment[/\[(.*?)\]/,1] %>

    <div class="comment-card">

      <div class="comment-icon">

        <i class="bi bi-chat-left-text-fill"></i>

      </div>

      <div class="comment-content">

        <div class="d-flex justify-content-between align-items-center">

          <span class="fw-semibold">
            Customer Care
          </span>

          <% if time.present? %>

            <small class="text-muted">

              <i class="bi bi-clock me-1"></i>

              <%= time %>

            </small>

          <% end %>

        </div>

        <div class="mt-2">

          <%= simple_format(comment.gsub(/\[.*?\]/,'')) %>

        </div>

      </div>

    </div>

  <% end %>

</div>

<% else %>

<div class="text-center py-5">

    <i class="bi bi-chat-left display-5 text-muted"></i>

    <div class="mt-3 text-muted">

        No comments yet

    </div>

</div>

<% end %>


<hr/>

<div class="card border-0 shadow-sm rounded-4">

<div class="card-header bg-white border-0">

    <div class="d-flex justify-content-between">

        <div>

            <h6 class="fw-bold mb-0">

                <i class="bi bi-telephone-fill text-success me-2"></i>

                Call History

            </h6>

            <small class="text-muted">

                <%= @calls.count %> Calls

            </small>

        </div>

    </div>

</div>

<div class="card-body p-2">

<% if @calls.any? %>

    <% @calls.each do |call| %>

        <div class="call-card">

            <div class="call-icon <%= call.status == 'ANSWERED' ? 'success' : 'danger' %>">

                <% if call.status == "ANSWERED" %>

                    <i class="bi bi-telephone-fill"></i>

                <% else %>

                    <i class="bi bi-telephone-x-fill"></i>

                <% end %>

            </div>

            <div class="flex-grow-1">

                <div class="d-flex justify-content-between">

                    <strong>

                        <%= call.agent.presence || "Unknown Agent" %>

                    </strong>

                    <small class="text-muted">

                        <i class="bi bi-clock"></i>

                        <%= call.called_at.strftime("%d %b %I:%M %p") %>

                    </small>

                </div>

                <div class="mt-2">

                    <% color =
                        case call.status
                        when "ANSWERED" then "success"
                        when "ABANDONED" then "danger"
                        when "BUSY" then "warning"
                        when "NO ANSWER" then "secondary"
                        else "primary"
                        end %>

                    <span class="badge rounded-pill bg-<%= color %>">

                        <%= call.status %>

                    </span>

                </div>

            </div>

        </div>

    <% end %>

<% else %>

<div class="text-center py-5">

<i class="bi bi-telephone display-5 text-muted"></i>

<div class="mt-3 text-muted">

No calls available

</div>

</div>

<% end %>

</div>

</div>

<style>
  .comment-list{
display:flex;
flex-direction:column;
gap:12px;
}

.comment-card,
.call-card{
display:flex;
gap:12px;
padding:14px;
background:#fff;
border-radius:16px;
box-shadow:0 4px 18px rgba(0,0,0,.05);
border:1px solid #edf2f7;
transition:.25s;
margin-bottom:10px;
}

.comment-card:hover,
.call-card:hover{
transform:translateY(-2px);
box-shadow:0 12px 28px rgba(0,0,0,.10);
}

.comment-icon,
.call-icon{
width:42px;
height:42px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
color:#fff;
font-size:18px;
flex-shrink:0;
}

.comment-icon{
background:#0d6efd;
}

.call-icon.success{
background:#198754;
}

.call-icon.danger{
background:#dc3545;
}

.form-control{
font-size:.9rem;
}

.badge{
padding:7px 12px;
font-size:.72rem;
letter-spacing:.3px;
}

@media(max-width:768px){

.comment-card,
.call-card{

padding:12px;
gap:10px;

}

.comment-icon,
.call-icon{

width:36px;
height:36px;
font-size:15px;

}

}
</style>


<div class="card border-0 shadow-sm rounded-4">

  <div class="card-header bg-white border-0 py-3">

    <div class="d-flex justify-content-between align-items-center">

      <div>

        <h5 class="fw-bold mb-1">
          <i class="bi bi-activity text-primary me-2"></i>
          Activity Timeline
        </h5>

        <small class="text-muted">
          Calls, Follow-ups & Lead History
        </small>

      </div>

      <span class="badge rounded-pill bg-primary px-3 py-2">
        <i class="bi bi-clock-history me-1"></i>
        <%= @activity.count %>
      </span>

    </div>

  </div>

  <div class="card-body p-3">

    <% if @activity.any? %>

      <div class="activity-feed">

        <% @activity.each do |item| %>

          <% if item[:type] == :inbound %>

            <div class="activity-card border-danger">

              <div class="activity-icon bg-danger">
                <i class="bi bi-telephone-inbound-fill"></i>
              </div>

              <div class="activity-content">

                <div class="activity-header">

                  <div>

                    <div class="activity-title">
                      Incoming Call
                    </div>

                    <span class="badge bg-danger">
                      <%= item[:record].status %>
                    </span>

                  </div>

                  <div class="activity-time">
                    <i class="bi bi-clock"></i>
                    <%= item[:time].strftime("%d %b %I:%M %p") %>
                  </div>

                </div>

                <div class="activity-meta">

                  <span>
                    <i class="bi bi-person-circle"></i>
                    <%= item[:record].agent.presence || "Unknown Agent" %>
                  </span>

                </div>

              </div>

            </div>

          <% elsif item[:type] == :outbound %>

            <div class="activity-card border-success">

              <div class="activity-icon bg-success">
                <i class="bi bi-telephone-outbound-fill"></i>
              </div>

              <div class="activity-content">

                <div class="activity-header">

                  <div>

                    <div class="activity-title text-success">
                      Outbound Call
                    </div>

                    <span class="badge bg-success">
                      <%= item[:record].status %>
                    </span>

                  </div>

                  <div class="activity-time">
                    <i class="bi bi-clock"></i>
                    <%= item[:time].strftime("%d %b %I:%M %p") %>
                  </div>

                </div>

                <div class="activity-meta">

                  <span>
                    <i class="bi bi-person-circle"></i>
                    <%= item[:record].agent.presence || "Unknown Agent" %>
                  </span>

                </div>

              </div>

            </div>

          <% elsif item[:type] == :audit %>

            <% audit = item[:record] %>
            <% user = audit.user&.username.presence || audit.user&.email.presence || "System" %>

            <div class="activity-card border-primary">

              <div class="activity-icon bg-primary">
                <i class="bi bi-pencil-square"></i>
              </div>

              <div class="activity-content">

                <div class="activity-header">

                  <div class="activity-title">

                    <i class="bi bi-person-circle me-1"></i>

                    <%= user %>

                  </div>

                  <div class="activity-time">

                    <i class="bi bi-clock"></i>

                    <%= audit.created_at.strftime("%d %b %I:%M %p") %>

                  </div>

                </div>

                <% audit.audited_changes.each do |field, change| %>

                  <% next if %w[updated_at created_at].include?(field) %>

                  <% if change.is_a?(Array) %>

                    <div class="change-row">

                      <span class="field">
                        <i class="bi bi-tag-fill text-primary me-1"></i>
                        <%= field.humanize %>
                      </span>

                      <span class="old-value">
                        <%= change[0].presence || "-" %>
                      </span>

                      <i class="bi bi-arrow-right text-primary"></i>

                      <span class="new-value">
                        <%= change[1].presence || "-" %>
                      </span>

                    </div>

                  <% else %>

                    <div class="change-row">

                      <span class="field">
                        <i class="bi bi-tag-fill text-primary me-1"></i>
                        <%= field.humanize %>
                      </span>

                      <span class="new-value">
                        <%= change %>
                      </span>

                    </div>

                  <% end %>

                <% end %>

              </div>

            </div>

          <% end %>

        <% end %>

      </div>

    <% else %>

      <div class="text-center py-5">

        <i class="bi bi-clock-history display-5 text-secondary"></i>

        <h6 class="mt-3 text-muted">
          No activity available
        </h6>

      </div>

    <% end %>

  </div>

</div>

<div class="mt-3">

  <%= link_to janomaxleads_path,
      class: "btn btn-dark rounded-pill px-4" do %>

      <i class="bi bi-arrow-left me-2"></i>

      Back to Leads

  <% end %>

</div>

<style>

  .activity-feed{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.activity-card{
    display:flex;
    gap:14px;
    background:#fff;
    border-radius:16px;
    padding:14px;
    border-left:5px solid;
    box-shadow:0 4px 18px rgba(0,0,0,.06);
    transition:.25s;
}

.activity-card:hover{
    transform:translateY(-2px);
    box-shadow:0 12px 28px rgba(0,0,0,.12);
}

.border-danger{border-color:#dc3545;}
.border-success{border-color:#198754;}
.border-primary{border-color:#0d6efd;}

.activity-icon{
    width:42px;
    height:42px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-size:18px;
    flex-shrink:0;
}

.activity-content{
    flex:1;
}

.activity-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    margin-bottom:8px;
}

.activity-title{
    font-weight:700;
    font-size:.95rem;
}

.activity-time{
    font-size:.72rem;
    color:#6c757d;
    white-space:nowrap;
}

.activity-meta{
    font-size:.78rem;
    color:#6c757d;
}

.change-row{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:8px;
    padding:8px 10px;
    background:#f8fafc;
    border-radius:10px;
    font-size:.82rem;
}

.field{
    min-width:130px;
    font-weight:600;
}

.old-value{
    color:#6c757d;
    text-decoration:line-through;
}

.new-value{
    color:#198754;
    font-weight:700;
}

@media(max-width:768px){

.activity-header{
    flex-direction:column;
    gap:5px;
}

.field{
    min-width:90px;
}

.change-row{
    flex-wrap:wrap;
}

}


  .timeline-item.callback .icon{
    background:#d1fae5;
    color:#047857;
}

.timeline-item.inbound .icon{
    background:#dbeafe;
    color:#1d4ed8;
}

.timeline-item.comment .icon{
    background:#f3f4f6;
}
  
  /* =========================
   TIMELINE
========================= */

.timeline {
  position: relative;
  margin-left: 10px;
  padding-left: 20px;
  border-left: 2px solid #e5e7eb;
}

.timeline-item {
  position: relative;
  margin-bottom: 20px;
}

.timeline-dot {
  position: absolute;
  left: -8px;
  top: 4px;
  width: 14px;
  height: 14px;
  background: #2563eb;
  border-radius: 50%;
  border: 3px solid #fff;
  box-shadow: 0 0 0 2px #e5e7eb;
}

.timeline-content {
  background: #f9fafb;
  padding: 12px 14px;
  border-radius: 10px;
}

.timeline-content strong {
  font-size: 13px;
}

.text-sm {
  font-size: 13px;
}


.timeline {
  position: relative;
  padding-left: 20px;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 10px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #e5e7eb;
}

.timeline-item {
  display: flex;
  gap: 12px;
  margin-bottom: 18px;
  position: relative;
}

.timeline-item .icon {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  font-size: 14px;
  z-index: 1;
}

.timeline-item.call .icon {
  background: #dcfce7;
}

.timeline-item.comment .icon {
  background: #dbeafe;
}

.timeline-item .content {
  background: #fff;
  padding: 10px 12px;
  border-radius: 10px;
  box-shadow: 0 1px 6px rgba(0,0,0,0.05);
  width: 100%;
}
</style>