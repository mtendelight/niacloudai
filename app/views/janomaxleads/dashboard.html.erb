<% growth_1 = @growth_1 || 0 %>
<% growth_2 = @growth_2 || 0 %>

<% curr_total  = @current_daily.sum %>
<% prev1_total = @prev1_daily.sum %>
<% prev2_total = @prev2_daily.sum %>

<div class="card border-0 shadow-lg rounded-4 mb-4 trend-card">

  <div class="card-header bg-transparent border-0 py-3 px-4">
    <div class="d-flex justify-content-between align-items-center">

      <div>
        <h5 class="mb-0 fw-bold">
          <i class="bi bi-graph-up-arrow text-primary me-2"></i>
          Call Performance Analytics
        </h5>
        <small class="text-muted">
          Compare call volumes across the last 3 months
        </small>
      </div>

      <span class="badge bg-primary-subtle text-primary px-3 py-2">
        Last 90 Days
      </span>

    </div>
  </div>

  <div class="card-body">

    <div class="row g-3 mb-4">

      <!-- THIS MONTH -->
      <div class="col-lg-4">
        <div class="metric-card primary">

          <div class="metric-label">
            This Month
          </div>

          <div class="metric-value">
            <%= number_with_delimiter(curr_total) %>
          </div>

          <div class="metric-subtitle">
            Total Calls
          </div>

          <div class="mt-2">
            <span class="badge <%= growth_1 >= 0 ? 'bg-success' : 'bg-danger' %>">
              <i class="bi <%= growth_1 >= 0 ? 'bi-arrow-up' : 'bi-arrow-down' %>"></i>
              <%= growth_1 %>%
            </span>
          </div>

        </div>
      </div>

      <!-- LAST MONTH -->
      <div class="col-lg-4">
        <div class="metric-card danger">

          <div class="metric-label">
            Last Month
          </div>

          <div class="metric-value">
            <%= number_with_delimiter(prev1_total) %>
          </div>

          <div class="metric-subtitle">
            Total Calls
          </div>

          <div class="mt-2">
            <span class="badge <%= growth_2 >= 0 ? 'bg-success' : 'bg-danger' %>">
              <i class="bi <%= growth_2 >= 0 ? 'bi-arrow-up' : 'bi-arrow-down' %>"></i>
              <%= growth_2 %>%
            </span>
          </div>

        </div>
      </div>

      <!-- 2 MONTHS AGO -->
      <div class="col-lg-4">
        <div class="metric-card success">

          <div class="metric-label">
            2 Months Ago
          </div>

          <div class="metric-value">
            <%= number_with_delimiter(prev2_total) %>
          </div>

          <div class="metric-subtitle">
            Baseline Month
          </div>

          <div class="mt-2">
            <span class="badge bg-secondary">
              Baseline
            </span>
          </div>

        </div>
      </div>

    </div>


  </div>
</div>



