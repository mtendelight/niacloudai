<%= render "layouts/header" %>



<div class="container py-4">

<div class="container-fluid mt-4">

<div class="dashboard-header mb-4">

  <div class="dashboard-header-content">

    <div>

      <div class="dashboard-tag">
        <i class="bi bi-telephone-fill"></i>
        Janomax Call Centre
      </div>

      <h1 class="dashboard-title">
        Leads Dashboard
      </h1>

      <p class="dashboard-subtitle">
        Monitor calls, conversions, lead quality, customer engagement and performance trends in real time.
      </p>

    </div>

    <div class="dashboard-actions">

      <% if params[:status].present? || params[:existing].present? %>
        <div class="active-filter">

          <i class="bi bi-funnel-fill"></i>

          Filter Applied

          <%= link_to janomaxleads_path,
              class: "clear-filter" do %>
            Clear
          <% end %>

        </div>
      <% end %>

      <%= link_to janomaxleads_path,
          class: "dashboard-btn",
          data: { turbo: false } do %>

        <i class="bi bi-list-ul"></i>
        View Leads

      <% end %>

    </div>

  </div>

</div>




<style>

  /* ====================================
   DASHBOARD HEADER
==================================== */

.dashboard-header{
  background:#fff;
  border:1px solid #edf2f7;
  border-radius:24px;
  padding:24px 28px;
  box-shadow:0 8px 30px rgba(15,23,42,.05);
  position:relative;
  overflow:hidden;
}

.dashboard-header::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:4px;
  background:linear-gradient(
    90deg,
    #2563eb,
    #06b6d4,
    #10b981
  );
}

.dashboard-header-content{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
}

.dashboard-tag{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:#eff6ff;
  color:#2563eb;
  font-weight:600;
  font-size:.82rem;
  padding:8px 14px;
  border-radius:30px;
  margin-bottom:12px;
}

.dashboard-title{
  font-size:2.2rem;
  font-weight:800;
  color:#0f172a;
  margin-bottom:6px;
  line-height:1.1;
}

.dashboard-subtitle{
  color:#64748b;
  font-size:.95rem;
  max-width:700px;
  margin:0;
}

.dashboard-actions{
  display:flex;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}

.dashboard-btn{
  background:linear-gradient(
    135deg,
    #2563eb,
    #3b82f6
  );
  color:#fff;
  text-decoration:none;
  padding:12px 22px;
  border-radius:14px;
  font-weight:700;
  display:flex;
  align-items:center;
  gap:8px;
  transition:.25s ease;
  box-shadow:0 8px 20px rgba(37,99,235,.20);
}

.dashboard-btn:hover{
  color:#fff;
  transform:translateY(-2px);
}

.active-filter{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 14px;
  background:#fff7ed;
  border:1px solid #fed7aa;
  border-radius:14px;
  color:#c2410c;
  font-weight:600;
}

.clear-filter{
  text-decoration:none;
  color:#dc2626;
  font-weight:700;
  border-left:1px solid #fdba74;
  padding-left:10px;
}

.clear-filter:hover{
  color:#b91c1c;
}

/* RESPONSIVE */

@media(max-width:992px){

  .dashboard-header-content{
    flex-direction:column;
    align-items:flex-start;
  }

  .dashboard-actions{
    width:100%;
  }
}

@media(max-width:768px){

  .dashboard-header{
    padding:20px;
  }

  .dashboard-title{
    font-size:1.7rem;
  }

  .dashboard-btn{
    width:100%;
    justify-content:center;
  }

  .active-filter{
    width:100%;
    justify-content:center;
  }
}
  .dashboard-hero{
  background:linear-gradient(
    135deg,
    #0f172a,
    #1e3a8a
  );
  border-radius:24px;
  padding:28px;
  color:#fff;
  position:relative;
  overflow:hidden;
  box-shadow:0 15px 40px rgba(0,0,0,.12);
}

.dashboard-hero::before{
  content:"";
  position:absolute;
  right:-80px;
  top:-80px;
  width:220px;
  height:220px;
  background:rgba(255,255,255,.06);
  border-radius:50%;
}

.dashboard-hero::after{
  content:"";
  position:absolute;
  left:-50px;
  bottom:-50px;
  width:150px;
  height:150px;
  background:rgba(255,255,255,.04);
  border-radius:50%;
}

.hero-content{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  position:relative;
  z-index:2;
}

.hero-badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:rgba(255,255,255,.12);
  padding:8px 14px;
  border-radius:30px;
  font-size:.85rem;
  margin-bottom:12px;
}

.hero-title{
  font-size:2rem;
  font-weight:800;
  margin-bottom:8px;
}

.hero-subtitle{
  color:rgba(255,255,255,.85);
  max-width:650px;
  margin-bottom:0;
  font-size:.95rem;
}

.hero-actions{
  display:flex;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}

.hero-btn{
  background:#fff;
  color:#1e3a8a;
  padding:12px 20px;
  border-radius:14px;
  text-decoration:none;
  font-weight:700;
  transition:.25s;
  display:flex;
  align-items:center;
  gap:8px;
}

.hero-btn:hover{
  transform:translateY(-2px);
  color:#1e3a8a;
  box-shadow:0 8px 20px rgba(255,255,255,.15);
}

.filter-badge{
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.15);
  padding:10px 14px;
  border-radius:14px;
  display:flex;
  align-items:center;
  gap:10px;
}

.filter-clear{
  color:#fff;
  font-weight:700;
  text-decoration:none;
  border-left:1px solid rgba(255,255,255,.25);
  padding-left:10px;
}

.filter-clear:hover{
  color:#fff;
}

@media(max-width:768px){

  .hero-content{
    flex-direction:column;
    align-items:flex-start;
  }

  .hero-title{
    font-size:1.6rem;
  }

  .hero-actions{
    width:100%;
  }

  .hero-btn{
    width:100%;
    justify-content:center;
  }
}

/* ===== QUICK ACTIONS FONT SIZE FIX ===== */

.quick-card {
  padding: 14px; /* optional: makes card more compact */
}

.quick-value {
  font-size: 1.2rem !important;   /* smaller number */
  font-weight: 700;
  line-height: 1.1;
}

.quick-label {
  font-size: 0.72rem;
  font-weight: 600;
  color: #6b7280;
}

.quick-icon {
  font-size: 1rem;
}

/* TOP "small rate text" also reduce */
.quick-card small {
  font-size: 0.7rem;
}

/* =========================================
   ULTRA COMPACT PREMIUM MENU
========================================= */

.compact-admin-menu{

  gap:8px;

  padding:12px;

  border-radius:24px;

}

/* =========================================
   MENU ITEM
========================================= */

.menu-item{

  width:64px;
  min-height:68px;

  padding:7px 5px;

  gap:5px;

  border-radius:18px;

  box-shadow:
    0 4px 14px rgba(15,23,42,.05);

}

/* ICON */

.menu-icon{

  width:28px;
  height:28px;

  border-radius:9px;

}

.menu-icon i{

  font-size:11px;

}

/* TEXT */

.menu-item span{

  font-size:7.5px;

  line-height:1.1;

  font-weight:800;

  letter-spacing:.1px;

}

/* BADGE */

.menu-badge{

  min-width:16px;
  height:16px;

  font-size:8px;

  top:4px;
  right:4px;

  border-width:1px;

}

/* =========================================
   SUPER ADMIN
========================================= */

.superadmin-wrapper{

  margin-top:8px;

  padding-top:12px;

}

.superadmin-grid{

  gap:8px;

}

.superadmin-card{

  width:64px;
  min-height:68px;

  padding:7px 5px;

  gap:5px;

  border-radius:18px;

}

/* SUPER ICON */

.super-icon{

  width:28px;
  height:28px;

  border-radius:9px;

}

.super-icon i{

  font-size:11px;

}

/* SUPER TEXT */

.super-content h6{

  font-size:7.5px;

  line-height:1.1;

  letter-spacing:.1px;

}

/* =========================================
   HOVER
========================================= */

.menu-item:hover,
.superadmin-card:hover{

  transform:
    translateY(-2px);

}

/* =========================================
   MOBILE
========================================= */

@media(max-width:768px){

  .compact-admin-menu{

    gap:6px;

    padding:10px;

  }

  .menu-item,
  .superadmin-card{

    width:58px;
    min-height:62px;

    padding:6px 4px;

  }

  .menu-icon,
  .super-icon{

    width:24px;
    height:24px;

    border-radius:8px;

  }

  .menu-icon i,
  .super-icon i{

    font-size:10px;

  }

  .menu-item span,
  .super-content h6{

    font-size:7px;

  }

}
</style>

  <div class="container">
<%= render 'jmcustomers/submenu' %>

    </div>


<!-- QUICK ACTIONS -->
<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">

  <div class="card-header border-0 py-4 px-4 bg-white">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

      <div class="d-flex align-items-center">

        <div class="header-icon me-3">
          <i class="bi bi-grid-1x2-fill"></i>
        </div>

        <div>
          <h4 class="fw-bold mb-1 text-dark">
            Lead Management
          </h4>

          <p class="text-muted mb-0">
            Monitor leads, track conversions and manage customer engagement.
          </p>
        </div>

      </div>

      <div class="header-badge">
        <i class="bi bi-activity me-2"></i>
        CRM Dashboard
      </div>

    </div>

  </div>

  <style>
    .header-icon{
    width:68px;
    height:68px;
    border-radius:20px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,#0d6efd,#6ea8fe);
    color:#fff;
    font-size:30px;
    box-shadow:0 15px 35px rgba(13,110,253,.25);
}

.header-badge{
    display:inline-flex;
    align-items:center;
    padding:10px 18px;
    border-radius:999px;
    background:#eef5ff;
    color:#0d6efd;
    font-weight:700;
    font-size:.9rem;
    border:1px solid rgba(13,110,253,.12);
}

.card-header{
    background:
        radial-gradient(circle at top right, rgba(13,110,253,.08), transparent 35%),
        linear-gradient(180deg,#ffffff,#fbfcfe) !important;
}

.card-header h4{
    letter-spacing:-.4px;
}

.card-header p{
    font-size:.95rem;
}

@media(max-width:768px){

.header-icon{
    width:58px;
    height:58px;
    font-size:24px;
}

.header-badge{
    width:100%;
    justify-content:center;
}

}
  </style>

<div class="d-flex justify-content-between align-items-center mb-2">

  <div>
    <h6 class="fw-bold mb-0">
      <i class="bi bi-telephone-x-fill text-danger me-1"></i>
      Follow-up Queue
    </h6>

    <small class="text-muted">
      Outstanding calls · Last 30 Days
    </small>
  </div>

  <span class="badge rounded-pill bg-danger-subtle text-danger">
    <i class="bi bi-clock-history me-1"></i>
    <%= @followup_days.sum { |d| d[:count].to_i } %>
  </span>

</div>


<%# =====================================================
    FOLLOW-UP DAYS

    Only days with actual follow-ups are displayed.
    A single day remains a compact card.
===================================================== %>

<% if @followup_days.present? %>

  <div class="followup-grid <%= 'single-day' if @followup_days.length == 1 %>">

    <% @followup_days.each do |day| %>

      <% active = params[:followup_date].to_s == day[:date].to_s %>

      <%= link_to janomaxleads_path(
            followup_date: day[:date]
          ),
          class: [
            "followup-card",
            ("active" if active)
          ].compact.join(" ") do %>

        <div class="followup-top">

          <span class="followup-icon">
            <i class="bi bi-telephone-x-fill"></i>
          </span>

          <i class="bi bi-arrow-up-right followup-arrow"></i>

        </div>


        <strong class="followup-number">
          <%= day[:count].to_i %>
        </strong>


        <span class="followup-date">
          <i class="bi bi-calendar3"></i>
          <%= day[:date].day.ordinalize %>
        </span>


        <span class="followup-status">

          <i class="bi bi-clock-fill text-danger"></i>
          Remaining

        </span>

      <% end %>

    <% end %>

  </div>

<% else %>

  <!-- =====================================================
       EMPTY FOLLOW-UP STATE
  ====================================================== -->

  <div class="followup-empty">

    <div class="followup-empty-icon">
      <i class="bi bi-check-circle-fill"></i>
    </div>

    <div class="followup-empty-content">

      <strong>No Follow-ups Pending</strong>

      <small>
        All customer calls are up to date for the last 30 days.
      </small>

    </div>

    <span class="followup-empty-badge">
      <i class="bi bi-check-lg"></i>
      Clear
    </span>

  </div>

<% end %>


<hr/>


<style>


  /* =====================================================
   EMPTY STATE
===================================================== */

.followup-empty {
  display: flex;
  align-items: center;
  gap: 14px;

  padding: 14px 16px;

  background: linear-gradient(
    135deg,
    #f0fff4,
    #f8fffa
  );

  border: 1px solid #bbf7d0;

  border-radius: 14px;

  box-shadow: 0 3px 12px rgba(15, 23, 42, .04);
}


/* ICON */

.followup-empty-icon {
  width: 42px;
  height: 42px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;

  background: #dcfce7;
  color: #16a34a;

  font-size: 19px;
}


/* CONTENT */

.followup-empty-content {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.followup-empty-content strong {
  color: #166534;

  font-size: .9rem;
  font-weight: 800;
}

.followup-empty-content small {
  margin-top: 2px;

  color: #64748b;

  font-size: .74rem;
}


/* BADGE */

.followup-empty-badge {
  margin-left: auto;

  display: inline-flex;
  align-items: center;
  gap: 4px;

  padding: 5px 10px;

  border-radius: 999px;

  background: #dcfce7;
  color: #15803d;

  font-size: .65rem;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: .3px;
}


/* MOBILE */

@media (max-width: 480px) {

  .followup-empty {
    padding: 12px;
    gap: 10px;
  }

  .followup-empty-icon {
    width: 36px;
    height: 36px;

    border-radius: 10px;

    font-size: 16px;
  }

  .followup-empty-content strong {
    font-size: .82rem;
  }

  .followup-empty-content small {
    font-size: .68rem;
  }

  .followup-empty-badge {
    display: none;
  }

}

/* =====================================================
   FOLLOW-UP HEADER
===================================================== */

.followup-header h6 {
  font-size: 1rem;
}

.followup-header small {
  font-size: .8rem;
}

.followup-header .badge {
  font-size: .85rem;
  padding: 8px 13px;
}


/* =====================================================
   GRID
===================================================== */

.followup-grid {

  display: grid;

  grid-template-columns:
    repeat(auto-fit, minmax(120px, 1fr));

  gap: 10px;

  align-items: stretch;
}


/* =====================================================
   SINGLE DAY
   Keep one card compact instead of full width
===================================================== */

.followup-grid.single-day {
  grid-template-columns: 120px;
}


/* =====================================================
   CARD
===================================================== */

.followup-card {

  display: block;

  width: 100%;

  min-height: 125px;

  padding: 13px;

  box-sizing: border-box;

  border: 1px solid #e9ecef;

  border-radius: 13px;

  background: #fff;

  color: #212529;

  text-decoration: none;

  line-height: 1.2;

  box-shadow:
    0 3px 10px rgba(15, 23, 42, .04);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease,
    background .2s ease;
}


/* =====================================================
   TOP
===================================================== */

.followup-top {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 10px;
}


/* =====================================================
   ICON
===================================================== */

.followup-icon {

  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 10px;

  background: #fff0f1;

  color: #dc3545;

  font-size: 14px;

  flex-shrink: 0;
}


/* =====================================================
   ARROW
===================================================== */

.followup-arrow {

  font-size: 13px;

  color: #adb5bd;

  transition: .2s ease;
}

.followup-card:hover .followup-arrow {

  color: #dc3545;

  transform:
    translate(2px, -2px);
}


/* =====================================================
   NUMBER
===================================================== */

.followup-number {

  display: block;

  font-size: 1.75rem;

  font-weight: 900;

  line-height: 1;

  margin-bottom: 8px;

  letter-spacing: -.5px;
}


/* =====================================================
   DATE
===================================================== */

.followup-date {

  display: flex;

  align-items: center;

  gap: 5px;

  font-size: .75rem;

  font-weight: 700;

  color: #6b7280;

  margin-bottom: 6px;

  text-transform: uppercase;
}

.followup-date i {

  font-size: 11px;
}


/* =====================================================
   STATUS
===================================================== */

.followup-status {

  display: flex;

  align-items: center;

  gap: 5px;

  font-size: .65rem;

  font-weight: 700;

  color: #94a3b8;
}

.followup-status i {

  font-size: 9px;
}


/* =====================================================
   HOVER
===================================================== */

.followup-card:hover,
.followup-card.active {

  text-decoration: none;

  transform:
    translateY(-3px);

  box-shadow:
    0 8px 20px rgba(15, 23, 42, .09),
    0 15px 35px rgba(15, 23, 42, .05);
}


/* =====================================================
   ACTIVE
===================================================== */

.followup-card.active {

  background:
    linear-gradient(
      135deg,
      #dc3545,
      #ef4444
    );

  border-color: #dc3545;

  color: #fff;
}

.followup-card.active .followup-icon {

  background:
    rgba(255,255,255,.18);

  color: #fff;
}

.followup-card.active .followup-arrow {

  color: #fff;
}

.followup-card.active .followup-date,
.followup-card.active .followup-status {

  color:
    rgba(255,255,255,.9);
}

.followup-card.active .followup-status i {

  color: #fff !important;
}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 768px) {

  .followup-grid {

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 8px;
  }

  .followup-card {

    min-height: 115px;

    padding: 11px;
  }

  .followup-icon {

    width: 30px;
    height: 30px;

    border-radius: 9px;

    font-size: 13px;
  }

  .followup-number {

    font-size: 1.55rem;
  }

  .followup-date {

    font-size: .68rem;
  }

  .followup-status {

    font-size: .58rem;
  }

  .followup-grid.single-day {

    grid-template-columns: 115px;
  }
}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media (max-width: 480px) {

  .followup-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 8px;
  }

  .followup-card {

    min-height: 110px;

    padding: 10px;

    border-radius: 11px;
  }

  .followup-top {

    margin-bottom: 8px;
  }

  .followup-icon {

    width: 28px;
    height: 28px;

    border-radius: 8px;

    font-size: 12px;
  }

  .followup-arrow {

    font-size: 11px;
  }

  .followup-number {

    font-size: 1.45rem;

    margin-bottom: 7px;
  }

  .followup-date {

    font-size: .64rem;

    gap: 4px;
  }

  .followup-status {

    font-size: .56rem;

    gap: 4px;
  }

  .followup-grid.single-day {

    grid-template-columns: 110px;
  }
}

</style>

  <div class="card-body">

    <div class="row g-4">

      <!-- ALL LEADS -->
