      </div>

      <!-- OPEN -->
      <div class="col-xl col-lg-4 col-md-6">
        <%= link_to janomaxleads_path(status: "open"), class: "text-decoration-none" do %>

          <div class="quick-card warning h-100">

            <div class="quick-icon">
              <i class="bi bi-hourglass-split"></i>
            </div>

            <div class="quick-value">
              <%= number_with_delimiter(@open_leads) %>
