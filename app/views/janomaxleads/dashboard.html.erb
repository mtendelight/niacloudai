    <!-- HEADER -->
    <div class="comment-summary-header">

      <div class="comment-summary-title">

        <i class="bi bi-chat-dots-fill"></i>

        <div>
          Lead Comment Summary
          <div style="font-size:.78rem; opacity:.78; font-weight:500;">
            <%= Date.current.strftime("%B %Y") %>
          </div>
        </div>

      </div>

    </div>

    <!-- BODY -->
    <div class="table-responsive">

      <table class="table comment-summary-table align-middle">

        <thead>

          <tr>

            <th>
              <i class="bi bi-person-circle me-1"></i>
              Team Member
            </th>

            <th class="text-center">
              <i class="bi bi-chat-left-text me-1"></i>
              Comments Done
            </th>

          </tr>

        </thead>

        <tbody>

          <% if @comment_summary.present? %>

            <% @comment_summary.values
                  .sort_by { |u| -u[:comments_done] }
                  .each do |row| %>

              <tr>

                <!-- USER -->
                <td>

                  <div class="user-box">

                    <div class="user-avatar">
                      <i class="bi bi-person-fill"></i>
                    </div>

                    <div>

                      <div class="user-name">
                        <%= row[:user].username.presence ||
                            row[:user].email %>
                      </div>

                      <div class="user-role">
                        Lead Management Team
                      </div>

                    </div>

                  </div>

                </td>

                <!-- COMMENTS -->
                <td class="text-center">

                  <span class="comment-badge">

                    <i class="bi bi-chat-dots me-1"></i>

                    <%= row[:comments_done] %>

                  </span>

                </td>

              </tr>

            <% end %>

          <% else %>

            <tr>

              <td colspan="2">

                <div class="empty-state">

                  <i class="bi bi-chat-square-text"></i>

                  <p>
                    No comment activity found this month.
                  </p>

                </div>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>