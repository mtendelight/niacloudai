<div class="followup-section mb-4">

  <!-- =====================================================
       HEADER
  ====================================================== -->

  <div class="d-flex justify-content-between align-items-center mb-3">

    <div>

      <h5 class="fw-bold mb-1">
        <i class="bi bi-telephone-x-fill text-danger me-2"></i>
        Follow-up Queue
      </h5>

      <small class="text-muted">
        Outstanding calls • Last 30 Days
      </small>

    </div>

    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">

      <i class="bi bi-clock-history me-1"></i>

      <%= @followup_days.sum { |d| d[:count].to_i } %> Remaining

    </span>

  </div>


  <!-- =====================================================
       FOLLOW-UP DAYS

       Only days with actual follow-ups are displayed.
       One day = compact card.
       No days = empty state.
  ====================================================== -->

  <% if @followup_days.present? %>

    <div class="followup-grid <%= 'single-day' if @followup_days.length == 1 %>">

      <% @followup_days.each do |day| %>

        <% active = params[:followup_date].to_s == day[:date].to_s %>

        <%= link_to janomaxleads_path(
              followup_date: day[:date]
            ),
            class: [
              "followup-card",
              ("active" if active)
            ].compact.join(" ") do %>


          <div class="followup-top">

            <div class="followup-icon">
              <i class="bi bi-telephone-x-fill"></i>
            </div>

            <div class="followup-arrow">
              <i class="bi bi-arrow-up-right"></i>
            </div>

          </div>


          <div class="followup-number">
            <%= day[:count].to_i %>
          </div>


          <div class="followup-date">

            <i class="bi bi-calendar3"></i>

            <%= day[:date].day.ordinalize %>

          </div>


          <div class="followup-status">

            <i class="bi bi-clock-fill"></i>
            Remaining

          </div>


        <% end %>

      <% end %>

    </div>


  <% else %>


    <!-- =====================================================
         EMPTY STATE
    ====================================================== -->

    <div class="followup-empty">

      <div class="followup-empty-icon">

        <i class="bi bi-check-circle-fill"></i>

      </div>


      <div class="followup-empty-content">

        <strong>
          No Follow-ups Pending
        </strong>

        <small>
          All customer calls are up to date for the last 30 days.
        </small>

      </div>


      <span class="followup-empty-badge">

        <i class="bi bi-check-lg"></i>

        Clear

      </span>

    </div>


  <% end %>

</div>


<style>

  /* =====================================================
   FOLLOW-UP GRID
===================================================== */

.followup-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 10px;
}


/* =====================================================
   SINGLE DAY
   Keep one card compact instead of stretching it
===================================================== */

.followup-grid.single-day {
  grid-template-columns: minmax(120px, 155px);
}


/* =====================================================
   CARD
===================================================== */

.followup-card {
  display: block;

  min-height: 125px;

  padding: 13px;

  background: #fff;

  border: 1px solid #e9ecef;
  border-radius: 14px;

  color: #212529;
  text-decoration: none;

  box-shadow: 0 3px 10px rgba(15, 23, 42, .04);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}


/* =====================================================
   HOVER
===================================================== */

.followup-card:hover {
  transform: translateY(-3px);

  border-color: #dc3545;

  color: #212529;
  text-decoration: none;

  box-shadow:
    0 10px 24px rgba(220, 53, 69, .10);
}


/* =====================================================
   ACTIVE
===================================================== */

.followup-card.active {
