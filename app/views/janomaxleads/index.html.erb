<div class="menu-wrap mb-3">

  <div class="menu-grid lead-grid">

    <% lead_items = [
      { name: "All Leads", path: janomaxleads_path, emoji: "👥", hint: "All records" },
      { name: "Open", path: janomaxleads_path(status: "open"), emoji: "🟡", hint: "Pending follow-ups" },
      { name: "Converted", path: janomaxleads_path(status: "converted"), emoji: "🟢", hint: "Successful deals" },
      { name: "Existing", path: janomaxleads_path(existing: true), emoji: "👤", hint: "Returning customers" },
      { name: "Calls", path: janomaxleads_path(sort: "calls_desc"), emoji: "📞", hint: "Call ranking" }
    ] %>

    <% lead_items.each do |item| %>

      <%= link_to item[:path],
        class: "menu-card lead-card #{'active' if current_page?(item[:path])}" do %>

        <div class="menu-card-body">

          <div class="menu-icon-box">
            <span class="menu-emoji"><%= item[:emoji] %></span>
          </div>

          <div class="menu-info">
            <div class="menu-name"><%= item[:name] %></div>
            <div class="menu-count"><%= item[:hint] %></div>
          </div>

          <div class="menu-arrow">
            <i class="bi bi-chevron-right"></i>
          </div>

        </div>

      <% end %>

    <% end %>

  </div>
</div>

