  <div class="card shadow-sm border-0 mb-3">
  <div class="card-body">
    <div class="login">

    <%= form_with url: janomaxleads_path, method: :get, local: true do |f| %>

      <div class="input-group">

        <%= text_field_tag :q,
              params[:q],
              class: "form-control",
              placeholder: "Search phone, customer name, status..." %>

        <button class="btn btn-primary">
          🔍 Search
        </button>

        <% if params[:q].present? %>
          <%= link_to "Clear", janomaxleads_path,
              class: "btn btn-outline-secondary" %>
        <% end %>

      </div>
</div>
    <% end %>

  </div>
</div>

  <!-- ===================== -->
  <!-- TABLE -->
  <!-- ===================== -->
  <div class="card border-0 shadow-sm rounded-4">

    <div class="table-responsive">

      <table class="table modern-table align-middle mb-0">

        <thead>
          <tr>
            <th>Lead</th>
            <th>Status</th>
            <th>Customer</th>
            <th>Calls</th>
            <th>Last Comment</th>
            <th>Last Activity</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>

        <tbody>

          <% @janomaxleads.each do |lead| %>

            <% status_class =
              case lead.lead_status
              when "open" then "open"
              when "converted" then "converted"
              when "lost" then "lost"
              else "muted"
              end %>

            <% last_call = lead.janomaxleadcalls.order(called_at: :desc).first %>

            <tr class="table-row">

              <!-- LEAD -->
              <td>
                <div class="lead-box">
                  <div class="lead-icon">📞</div>
                  <div>
                    <div class="fw-semibold"><%= lead.phone %></div>
                    <small class="text-muted">Lead #<%= lead.id %></small>
                  </div>
                </div>
              </td>

              <!-- STATUS -->
              <td>
                <span class="pill <%= status_class %>">
                  <%= lead.lead_status.capitalize %>
                </span>
              </td>

              <!-- CUSTOMER -->
              <td>
                <%= lead.jmcustomer.present? ? "✔ Yes" : "— New" %>
              </td>

              <!-- CALLS -->
              <td>
                <span class="badge bg-dark rounded-pill">
                  <%= lead.calls_count.to_i %>
                </span>
              </td>
<td>
  <!-- LAST COMMENT -->

  <% last_comment = lead.comments.to_s.split("\n\n").last %>

  <% if last_comment.present? %>

    <% clean_comment = last_comment
        .gsub(/💬 \[.*?\]\s*/, '')
        .strip %>

    <div class="mt-1">
      💬 <small class="text-dark">
        <%= truncate(clean_comment, length: 40) %>
      </small>
    </div>

  <% else %>
    <span class="text-muted">No comments</span>
  <% end %>
</td>

              <!-- LAST ACTIVITY -->
              <td>
                <% if last_call %>
                  <div class="text-sm">
                    🕒 <%= last_call.called_at.strftime("%d %b %H:%M") %>
                  </div>
                  <small class="text-muted"><%= last_call.status %></small>
                <% else %>
                  <span class="text-muted">No activity</span>
                <% end %>
              </td>

              <!-- ACTION -->
              <td class="text-end">
                <%= link_to "View →", lead, class: "btn btn-sm btn-outline-primary rounded-pill" %>
              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>




<div class="digg_pagination">

  <div class="d-flex justify-content-center mb-3">
    <%= paginate @janomaxleads %>
  </div>

  <div class="text-center mb-3">
    <%= form_with url: request.path, method: :get, local: true, id: "rows-per-page-form", class: "d-inline-flex align-items-center gap-2" do |f| %>

      <%= f.label :per_page, "Rows per page", class: "mb-0 fw-semibold" %>

      <%= f.select :per_page,
          options_for_select([20,25,50,100,250,500,1000], params[:per_page] || 20),
          {},
          class: "form-select form-select-sm",
          style: "width:100px;",
          id: "rows-per-page" %>

    <% end %>
  </div>

  <div class="text-center text-muted small">
    <%= page_entries_info @janomaxleads %>
  </div>

</div>

<style>
  .digg_pagination nav{
    display:flex;
    justify-content:center;
}

.digg_pagination .pagination{
    margin-bottom:0;
}

.digg_pagination{
    overflow:hidden;
}
</style>



<script>

  document.addEventListener("DOMContentLoaded", () => {
  const select = document.getElementById("rows-per-page");
  if (select) {
    select.addEventListener("change", () => {
      document.getElementById("rows-per-page-form").submit();
    });
  }
});


</script>






