<%= render "layouts/header" %>

<div class="container py-4">

<!-- ===================================== -->
<!-- PREMIUM PAGE HEADER -->
<!-- ===================================== -->

<div class="crm-page-header mb-4">

  <div class="d-flex align-items-center gap-3">

  <%= link_to(request.referer || dashboard_janomaxleads_path,
    class: "crm-back-btn",
    title: "Back") do %>

  <i class="bi bi-arrow-left"></i>

<% end %>

    <div class="crm-header-icon">

      <i class="bi bi-telephone-inbound-fill"></i>

    </div>

    <div>

      <div class="crm-title">
        Janomax Leads
      </div>

      <div class="crm-subtitle">
        <i class="bi bi-graph-up-arrow me-1"></i>
        Inbound Calls • Lead Tracking • Conversion Monitoring
      </div>

    </div>

  </div>

  <div class="crm-header-actions">

    <%= link_to dashboard_janomaxleads_path,
        class: "crm-btn crm-btn-light" do %>

      <i class="bi bi-speedometer2"></i>
      <span>Dashboard</span>

    <% end %>

    <%= link_to new_jmlead_path,
        class: "crm-btn crm-btn-primary" do %>

      <i class="bi bi-plus-circle-fill"></i>
      <span><strong style="color: black;">New Lead</strong></span>

    <% end %>

  </div>

</div>

<style>
  /* Back Button */

.crm-back-btn{

    width:46px;
    height:46px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:14px;

    background:#fff;

    border:1px solid #dee2e6;

    color:#475569;

    text-decoration:none;

    transition:.25s ease;

    box-shadow:0 4px 12px rgba(15,23,42,.05);

}

.crm-back-btn:hover{

    background:#0d6efd;

    border-color:#0d6efd;

    color:#fff;

    transform:translateX(-3px);

    box-shadow:0 10px 20px rgba(13,110,253,.18);

}

.crm-back-btn i{

    font-size:20px;

}

/*=====================================
 PREMIUM HEADER
======================================*/

.crm-page-header{

    display:flex;
    align-items:center;
    justify-content:space-between;

    gap:20px;

    padding:18px 22px;

    background:#fff;

    border:1px solid #e9ecef;

    border-radius:20px;

    box-shadow:0 8px 30px rgba(15,23,42,.05);

}

.crm-header-left{

    display:flex;

    align-items:center;

    gap:16px;

}

.crm-header-icon{

    width:58px;

    height:58px;

    border-radius:18px;

    background:linear-gradient(135deg,#2563eb,#3b82f6);

    color:#fff;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:24px;

    box-shadow:0 10px 25px rgba(37,99,235,.20);

}

.crm-title{

    font-size:1.45rem;

    font-weight:800;

    color:#0f172a;

    line-height:1.1;

}

.crm-subtitle{

    margin-top:4px;

    font-size:.88rem;

    color:#64748b;

    font-weight:500;

}

.crm-header-actions{

    display:flex;

    gap:12px;

    flex-wrap:wrap;

}

.crm-btn{

    display:inline-flex;

    align-items:center;

    gap:8px;

    padding:10px 16px;

    border-radius:12px;

    text-decoration:none;

    font-weight:600;

    transition:.25s;

}

.crm-btn-light{

    background:#fff;

    border:1px solid #dee2e6;

    color:#334155;

}

.crm-btn-light:hover{

    background:#f8fafc;

    color:#0d6efd;

    border-color:#0d6efd;

}

.crm-btn-primary{

    background:linear-gradient(135deg,#2563eb,#3b82f6);

    color:#fff;

    border:1px solid transparent;

    box-shadow:0 8px 20px rgba(37,99,235,.18);

}

.crm-btn-primary:hover{

    transform:translateY(-2px);

    color:#fff;

    box-shadow:0 12px 28px rgba(37,99,235,.28);

}

/* Mobile */

@media(max-width:768px){

    .crm-page-header{

        flex-direction:column;

        align-items:flex-start;

    }

    .crm-header-actions{

        width:100%;

    }

    .crm-btn{

        flex:1;

        justify-content:center;

    }

}
</style>
 





<div class="row g-3 mb-4">

  <!-- ALL LEADS -->
  <div class="col-12 col-md-6 col-lg-2-4">
    <%= link_to janomaxleads_path, class: "kpi-link" do %>
      <div class="card kpi-card kpi-all">

        <div class="card-body">

          <div class="kpi-top">
            <div class="kpi-icon bg-primary">
              <i class="bi bi-people"></i>
            </div>
            <span class="kpi-badge">All</span>
          </div>

          <div class="kpi-number"><%= @unique_leads %></div>
          <div class="kpi-label">Total Leads</div>

               <div class="mt-auto">
            <%= link_to janomaxleads_path(format: :csv),
                class: "btn btn-sm btn-outline-primary w-100 export-btn d-flex align-items-center justify-content-center gap-2",
                data: { turbo: false } do %>

              <i class="bi bi-download"></i>
              <span class="spinner-border spinner-border-sm d-none"></span>

            <% end %>
          </div>

 

        </div>
      </div>
    <% end %>
  </div>

  <!-- OPEN -->
  <div class="col-12 col-md-6 col-lg-2-4">
    <%= link_to janomaxleads_path(status: "open"), class: "kpi-link" do %>
      <div class="card kpi-card kpi-open">

        <div class="card-body">

          <div class="kpi-top">
            <div class="kpi-icon bg-warning">
              <i class="bi bi-exclamation-circle"></i>
            </div>
            <span class="kpi-badge">Open</span>
          </div>

          <div class="kpi-number"><%= @open_leads %></div>
          <div class="kpi-label">Open Leads</div>

 
<div class="mt-auto">
            <%= link_to janomaxleads_path(status: "open", format: :csv),
                class: "btn btn-sm btn-outline-warning w-100 export-btn d-flex align-items-center justify-content-center gap-2",
                data: { turbo: false } do %>

              <i class="bi bi-download"></i>
              <span class="spinner-border spinner-border-sm d-none"></span>

            <% end %>
          </div>


        </div>
      </div>
    <% end %>
  </div>

  <!-- CALLS -->
  <div class="col-12 col-md-6 col-lg-2-4">
    <%= link_to janomaxleads_path(sort: "calls_desc"), class: "kpi-link" do %>
      <div class="card kpi-card kpi-calls">

        <div class="card-body">

          <div class="kpi-top">
            <div class="kpi-icon bg-dark">
              <i class="bi bi-telephone"></i>
            </div>
            <span class="kpi-badge">Calls</span>
          </div>

          <div class="kpi-number">TOP</div>
          <div class="kpi-label">Most Calls</div>


             <div class="mt-auto">
            <%= link_to janomaxleads_path(sort: "calls_desc", format: :csv),
                class: "btn btn-sm btn-outline-dark w-100 export-btn d-flex align-items-center justify-content-center gap-2",
                data: { turbo: false } do %>

              <i class="bi bi-download"></i>
              <span class="spinner-border spinner-border-sm d-none"></span>

            <% end %>
          </div>
         

        </div>
      </div>
    <% end %>
  </div>

  <!-- CONVERTED -->
  <div class="col-12 col-md-6 col-lg-2-4">
    <%= link_to janomaxleads_path(status: "converted"), class: "kpi-link" do %>
      <div class="card kpi-card kpi-converted">

        <div class="card-body">

          <div class="kpi-top">
            <div class="kpi-icon bg-success">
              <i class="bi bi-check-circle"></i>
            </div>
            <span class="kpi-badge">Done</span>
          </div>

          <div class="kpi-number"><%= @converted %></div>
          <div class="kpi-label">Converted</div>

                <div class="mt-auto">
            <%= link_to janomaxleads_path(status: "converted", format: :csv),
                class: "btn btn-sm btn-outline-success w-100 export-btn d-flex align-items-center justify-content-center gap-2",
                data: { turbo: false } do %>

              <i class="bi bi-download"></i>
              <span class="spinner-border spinner-border-sm d-none"></span>

            <% end %>
          </div>
    

        </div>
      </div>
    <% end %>
  </div>



  <!-- EXISTING -->
  <div class="col-12 col-md-6 col-lg-2-4">
    <%= link_to janomaxleads_path(existing: true), class: "kpi-link" do %>
      <div class="card kpi-card kpi-existing">

        <div class="card-body">

          <div class="kpi-top">
            <div class="kpi-icon bg-info">
              <i class="bi bi-person-check"></i>
            </div>
            <span class="kpi-badge">Existing</span>
          </div>

          <div class="kpi-number"><%= @existing_customers %></div>
          <div class="kpi-label">Customers</div>

               <div class="mt-auto">
            <%= link_to janomaxleads_path(existing: true, format: :csv),
                class: "btn btn-sm btn-outline-info w-100 export-btn d-flex align-items-center justify-content-center gap-2",
                data: { turbo: false } do %>

              <i class="bi bi-download"></i>

              <span class="spinner-border spinner-border-sm d-none"></span>

            <% end %>
          </div>
         

        </div>
      </div>
    <% end %>
  </div>

</div>




