
<%= render "layouts/header" %>

<div class="container py-4">


<div class="container-fluid py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">
        <i class="bi bi-box-seam-fill text-primary"></i>
        AI Products
      </h2>
      <p class="text-muted mb-0">
        Manage the products used by the AI Assistant.
      </p>
    </div>

    <%= link_to "#", class: "btn btn-primary rounded-pill px-4 shadow-sm" do %>
      <i class="bi bi-plus-circle"></i>
      New Product
    <% end %>
  </div>

  <div class="row g-4 mb-4">

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body">

          <div class="d-flex align-items-center mb-3">

            <div class="icon-circle bg-primary-subtle text-primary me-3">
              <i class="bi bi-upload"></i>
            </div>

            <div>
              <h5 class="mb-0 fw-semibold">
                Import Products
              </h5>
              <small class="text-muted">
                Upload Excel Spreadsheet
              </small>
            </div>

          </div>
<div class="login">
          <%= form_with url: import_aiproducts_path,
                        multipart: true,
                        method: :post,
                        local: true do |f| %>

            <div class="mb-3">
              <%= f.file_field :file,
                    class: "form-control form-control-lg" %>
            </div>

            <%= f.submit "Import Excel",
                  class: "btn btn-primary w-100 rounded-pill" %>

          <% end %>
</div>
        </div>
      </div>
    </div>


    <div class="col-lg-8">

      <div class="row g-3">

        <div class="col-md-4">

          <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body">

              <small class="text-muted">
                Products
              </small>

              <h2 class="fw-bold">
                <%= @aiproducts.count %>
              </h2>

            </div>

          </div>

        </div>

        <div class="col-md-4">

          <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body">

              <small class="text-muted">
                Average Price
              </small>

              <h2 class="fw-bold">

                <%= number_to_currency(
                      @aiproducts.average(:price),
                      unit: "KES "
                    ) %>

              </h2>

            </div>

          </div>

        </div>

        <div class="col-md-4">

          <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body">

              <small class="text-muted">
                Active Products
              </small>

              <h2 class="fw-bold">

                <%= @aiproducts.where(active: true).count rescue @aiproducts.count %>

              </h2>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>



  <div class="card border-0 shadow-sm rounded-4">

    <div class="card-header bg-white border-0 py-3">

      <div class="d-flex justify-content-between align-items-center">

        <h5 class="fw-bold mb-0">
          Product Knowledge Base
        </h5>

        <span class="badge bg-primary rounded-pill px-3">
          <%= @aiproducts.count %> Products
        </span>

      </div>

    </div>


    <div class="login">

<%= form_with url: aiproducts_path, method: :get, local: true, class: "mb-3" do %>
  <div class="input-group">
    <%= text_field_tag :search,
        params[:search],
        class: "form-control",
        placeholder: "Search bale name..." %>

    <button class="btn btn-primary" type="submit">
      <i class="bi bi-search"></i> Search
    </button>

    <% if params[:search].present? %>
      <%= link_to "Clear", aiproducts_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>
</div>

    <div class="table-responsive">

      <table class="table align-middle mb-0">

        <thead class="table-light">

          <tr>

            <th>Bale Name</th>

            <th>Pieces</th>

            <th class="text-end">
              Price
            </th>

            <th>Description</th>

          </tr>

        </thead>

        <tbody>

          <% @aiproducts.each do |product| %>

            <tr>

              <td>

                <div class="fw-semibold">

                  <i class="bi bi-box text-primary me-2"></i>

                  <%= product.bale_name %>

                </div>

              </td>

              <td>

                <span class="badge bg-light text-dark border">

                  <%= product.pieces_range.presence || "-" %>

                </span>

              </td>

              <td class="text-end fw-bold text-success">

                <%= number_to_currency(
                      product.price,
                      unit: "KES "
                    ) %>

              </td>

              <td class="text-muted">

                <%= truncate(
                      product.description,
                      length: 120
                    ) %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>


<style>

.icon-circle{
    width:55px;
    height:55px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
}

.card{
    transition:.25s;
}

.card:hover{
    transform:translateY(-3px);
}

.table tbody tr:hover{
    background:#f8fafc;
}

.table td{
    vertical-align:middle;
}

.table thead th{
    font-weight:600;
    border-bottom:0;
}

</style>