<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const canvas = document.getElementById("growthChart");
  if (!canvas) return;

  const ctx = canvas.getContext("2d");

  // =========================
  // GRADIENTS
  // =========================

  const blueGradient = ctx.createLinearGradient(0, 0, 0, 400);
  blueGradient.addColorStop(0, "rgba(37,99,235,.30)");
  blueGradient.addColorStop(1, "rgba(37,99,235,0)");

  const redGradient = ctx.createLinearGradient(0, 0, 0, 400);
  redGradient.addColorStop(0, "rgba(239,68,68,.22)");
  redGradient.addColorStop(1, "rgba(239,68,68,0)");

  const greenGradient = ctx.createLinearGradient(0, 0, 0, 400);
  greenGradient.addColorStop(0, "rgba(16,185,129,.22)");
  greenGradient.addColorStop(1, "rgba(16,185,129,0)");

  // =========================
  // GLOW EFFECT
  // =========================

  const glowPlugin = {
    id: "glowPlugin",

    beforeDatasetDraw(chart, args) {
      const { ctx } = chart;

      ctx.save();

      const colors = [
        "#2563eb",
        "#ef4444",
        "#10b981"
      ];

      ctx.shadowColor = colors[args.index] || "#2563eb";
      ctx.shadowBlur = 12;
      ctx.shadowOffsetX = 0;
      ctx.shadowOffsetY = 5;
    },

    afterDatasetDraw(chart) {
      chart.ctx.restore();
    }
  };

  // =========================
  // CROSSHAIR
  // =========================

  const crosshairPlugin = {
    id: "crosshairPlugin",

    afterDraw(chart) {

      if (!chart.tooltip?._active?.length) return;

      const ctx = chart.ctx;

      const x = chart.tooltip._active[0].element.x;

      const topY = chart.scales.y.top;
      const bottomY = chart.scales.y.bottom;

      ctx.save();

      ctx.beginPath();
      ctx.setLineDash([5, 5]);

      ctx.moveTo(x, topY);
      ctx.lineTo(x, bottomY);

      ctx.strokeStyle = "rgba(148,163,184,.35)";
      ctx.lineWidth = 1;

      ctx.stroke();

      ctx.restore();
    }
  };

  Chart.register(glowPlugin, crosshairPlugin);

  // =========================
  // CHART
  // =========================

  new Chart(ctx, {
    type: "line",

    data: {
      labels: <%= raw @days.to_json %>,

      datasets: [

        {
          label: "This Month",
          data: <%= raw @current_daily.to_json %>,

          borderColor: "#2563eb",
          backgroundColor: blueGradient,

          fill: true,
          tension: 0.45,
          borderWidth: 4,

          pointRadius: 4,
          pointHoverRadius: 9,
          pointHitRadius: 25,

          pointBackgroundColor: "#fff",
          pointBorderColor: "#2563eb",
          pointBorderWidth: 3,

          pointHoverBackgroundColor: "#2563eb",
          pointHoverBorderColor: "#fff",
          pointHoverBorderWidth: 3
        },

        {
          label: "Last Month",
          data: <%= raw @prev1_daily.to_json %>,

          borderColor: "#ef4444",
          backgroundColor: redGradient,

          fill: true,
          tension: 0.45,
          borderDash: [8, 5],
          borderWidth: 3,

          pointRadius: 4,
          pointHoverRadius: 9,
          pointHitRadius: 25,

          pointBackgroundColor: "#fff",
          pointBorderColor: "#ef4444",
          pointBorderWidth: 3,

          pointHoverBackgroundColor: "#ef4444",
          pointHoverBorderColor: "#fff",
          pointHoverBorderWidth: 3
        },

        {
          label: "2 Months Ago",
          data: <%= raw @prev2_daily.to_json %>,

          borderColor: "#10b981",
          backgroundColor: greenGradient,

          fill: true,
          tension: 0.45,
          borderDash: [3, 3],
          borderWidth: 3,

          pointRadius: 4,
          pointHoverRadius: 9,
          pointHitRadius: 25,

          pointBackgroundColor: "#fff",
          pointBorderColor: "#10b981",
          pointBorderWidth: 3,

          pointHoverBackgroundColor: "#10b981",
          pointHoverBorderColor: "#fff",
          pointHoverBorderWidth: 3
        }

      ]
    },

    options: {

      responsive: true,
      maintainAspectRatio: false,

      animation: {
        duration: 1800,
        easing: "easeOutQuart"
      },

      interaction: {
        mode: "index",
        intersect: false
      },

      hover: {
        mode: "index",
        intersect: false
      },

      plugins: {

        datalabels: {
          display: false
        },

        legend: {
          position: "bottom",

          labels: {
            usePointStyle: true,
            pointStyle: "circle",

            padding: 24,
            boxWidth: 10,
            boxHeight: 10,

            color: "#475569",

            font: {
              size: 13,
              weight: "600"
            }
          }
        },

        tooltip: {

          backgroundColor: "#ffffff",

          titleColor: "#0f172a",
          bodyColor: "#475569",

          borderColor: "#e2e8f0",
          borderWidth: 1,

          cornerRadius: 16,

          padding: 16,
          boxPadding: 6,

          displayColors: true,

          callbacks: {

            title(context) {
              return `Day ${context[0].label}`;
            },

            label(context) {
              return (
                context.dataset.label +
                ": KSh " +
                Number(context.raw || 0).toLocaleString()
              );
            }
          }
        }
      },

      scales: {

        x: {

          grid: {
            display: false,
            drawBorder: false
          },

          ticks: {
            color: "#94a3b8",

            font: {
              size: 12,
              weight: "600"
            }
          }
        },

        y: {

          beginAtZero: true,

          border: {
            display: false
          },

          grid: {
            color: "rgba(148,163,184,.12)",
            drawBorder: false
          },

          ticks: {

            padding: 10,

            color: "#64748b",

            font: {
              size: 12
            },

            callback(value) {
              return "KSh " + Number(value).toLocaleString();
            }
          }
        }
      }
    }
  });

});
</script>



