                  <%= rank == 1 ? 'bg-warning text-dark' : rank == 2 ? 'bg-secondary' : rank == 3 ? 'bg-danger' : 'bg-primary' %>">
                  <%= rank %>
                </span>
              </td>

              <!-- Name -->
              <td class="fw-semibold">
                <%= c.name %>
              </td>

              <!-- Phone -->
              <td class="text-muted">
                <%= c.phone %>
              </td>

              <!-- Total Paid -->
              <td class="text-end fw-bold text-success">
                KES <%= number_with_delimiter(c.total_paid.to_i) %>
              </td>

              <!-- Payments count -->
              <td class="text-center">
                <span class="badge bg-light text-dark border">
                  <%= c.total_payments %>
                </span>
              </td>

            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>
</div>

  <!-- TODAY -->
  <div class="card shadow-sm mb-3">
    <div class="card-header bg-success text-white">
      <i class="bi bi-sun-fill me-1"></i> Today
      
    </div>
    <div class="table-responsive">
      <%= render "table", payments: @today %>
    </div>
  </div>

  <!-- YESTERDAY -->
  <div class="card shadow-sm mb-3">
    <div class="card-header bg-primary text-white">
      <i class="bi bi-moon-fill me-1"></i> Yesterday
    </div>
    <div class="table-responsive">
      <%= render "table", payments: @yesterday %>
    </div>
  </div>

  <!-- DAY BEFORE -->
  <div class="card shadow-sm mb-3">
    <div class="card-header bg-warning">
      <i class="bi bi-clock-history me-1"></i> Day Before Yesterday
    </div>
    <div class="table-responsive">
      <%= render "table", payments: @day_before %>
    </div>
  </div>

  <!-- OLDER -->
  <div class="card shadow-sm mb-3">
    <div class="card-header bg-dark text-white">
      <i class="bi bi-archive me-1"></i> Older Payments
    </div>
    <div class="table-responsive">
       <h3 class="fw-bold">
          KSh <%= number_with_delimiter(@current_year_total.to_i) %>
        </h3>
    </div>
    <div class="digg_pagination">
  <div class="pagination justify-content-center">
    <%= paginate @older %>
  </div>
  <p class="text-center">
    <div class="login">
    <%= form_with url: request.path, method: :get, local: false, id: 'rows-per-page-form' do |f| %>
      <%= f.label :per_page, "Rows per page" %>
     <%= f.select :per_page, options_for_select([10, 25, 50, 100,250,500,1000], params[:per_page] || 10), {}, class: "form-select", data: { turbo: false } %>


    <% end %></div>
      <br/>
    <center><%= page_entries_info @older %></center>
  </p>
</div>



