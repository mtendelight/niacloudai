                <% rank = i + 1 %>
                <span class="badge rounded-pill 
                  <%= rank == 1 ? 'bg-warning text-dark' : rank == 2 ? 'bg-secondary' : rank == 3 ? 'bg-danger' : 'bg-primary' %>">
                  <%= rank %>
                </span>
              </td>

              <!-- Name -->
