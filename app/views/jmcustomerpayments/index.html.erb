<%= render "layouts/header" %>

<div class="container my-4">

  <div class="container">
<%= render 'jmcustomers/submenu' %>

    </div>



  <h3 class="fw-bold mb-4">
    <i class="bi bi-graph-up-arrow text-success me-1"></i>
    Payments Tracker

  </h3>
<center>
      <!-- IMPORT BUTTON -->
  <%= link_to jmpayments_import_path,
        class: "admin-btn d-flex align-items-center gap-1 px-3 py-2 #{'active' if current_page?(jmpayments_import_path)}",
        data: { turbo: false } do %>
    <i class="bi bi-file-earmark-arrow-up-fill"></i>
    <span style="color: black !important;">Import PDF</span>
  <% end %>

<%= link_to jmcustomers_path,
      class: "admin-btn d-flex align-items-center gap-1 px-3 py-2 #{'active' if current_page?(jmcustomers_path)}",
      data: { turbo: false } do %>
  <i class="bi bi-arrow-left-circle-fill"></i>
  <span style="color: black !important;">Back to Customers</span>
<% end %>

<%= form_with url: search_jmpayments_path, method: :get, local: true do %>
  <div class="input-group mb-3">

    <%= text_field_tag :q, params[:q],
          class: "form-control",
          placeholder: "Search Mpesa, name, phone, ref..." %>

    <button class="btn btn-primary">
      <i class="bi bi-search"></i> Search
    </button>

  </div>
<% end %>

<%
today_val      = @today_total.to_f
yesterday_val  = @yesterday_total.to_f
day2_val       = @day_before_total.to_f   # 2 days ago
day3_val       = @three_days_ago_total.to_f # 👈 ADD THIS IN CONTROLLER

# Growth chain
today_growth =
  yesterday_val > 0 ? ((today_val - yesterday_val) / yesterday_val * 100).round : nil

yesterday_growth =
  day2_val > 0 ? ((yesterday_val - day2_val) / day2_val * 100).round : nil

day2_growth =
  day3_val > 0 ? ((day2_val - day3_val) / day3_val * 100).round : nil
%>




<script>
  
  document.querySelectorAll('.export-btn').forEach(btn => {
  btn.addEventListener('click', function () {
    const icon = this.querySelector('i');
    const spinner = this.querySelector('.spinner-border');

    if (icon) icon.classList.add('d-none');
    if (spinner) spinner.classList.remove('d-none');

    this.classList.add('disabled');
  });
});
</script>


<div class="row g-3 mb-4">

  <!-- TODAY -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card kpi-card border-0 h-100 highlight-card">
      <div class="card-body d-flex flex-column">

        <div class="d-flex justify-content-between mb-2">
          <div class="kpi-icon bg-primary">
            <i class="bi bi-calendar-day"></i>
          </div>
          <span class="badge bg-light text-dark">Today</span>
        </div>

         <h3 class="fw-bold">
          KSh <%= number_with_delimiter(today_val.to_i) %>
        </h3>

        <% if today_growth %>
          <div class="small <%= today_growth >= 0 ? 'text-success' : 'text-danger' %> mb-2">
            <i class="bi <%= today_growth >= 0 ? 'bi-arrow-up' : 'bi-arrow-down' %>"></i>
            <%= today_growth %>% vs yesterday
          </div>
        <% end %>

        <!-- BUTTON -->
        <div class="mt-auto">
          <%= link_to jmcustomerpayments_path(format: :csv, type: "today"),
              class: "btn btn-sm btn-outline-primary w-100 export-btn d-flex align-items-center justify-content-center gap-2",
              data: { turbo: false } do %>

            <i class="bi bi-download"></i>
            <span>Download CSV</span>
            <span class="spinner-border spinner-border-sm d-none"></span>

          <% end %>
        </div>

      </div>
    </div>
  </div>


  <!-- YESTERDAY -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card kpi-card border-0 h-100">
      <div class="card-body d-flex flex-column">

        <div class="d-flex justify-content-between mb-2">
          <div class="kpi-icon bg-secondary">
            <i class="bi bi-clock-history"></i>
          </div>
          <span class="badge bg-light text-dark">Yesterday</span>
        </div>

        <h3 class="fw-bold">
          KSh <%= number_with_delimiter(yesterday_val.to_i) %>
        </h3>

        <% if yesterday_growth %>
          <div class="small <%= yesterday_growth >= 0 ? 'text-success' : 'text-danger' %> mb-2">
            <i class="bi <%= yesterday_growth >= 0 ? 'bi-arrow-up' : 'bi-arrow-down' %>"></i>
            <%= yesterday_growth %>% vs 2 days ago
          </div>
        <% end %>

        <div class="mt-auto">
          <%= link_to jmcustomerpayments_path(format: :csv, type: "yesterday"),
              class: "btn btn-sm btn-outline-secondary w-100 export-btn d-flex align-items-center justify-content-center gap-2",
              data: { turbo: false } do %>

            <i class="bi bi-download"></i>
            <span>Download CSV</span>
            <span class="spinner-border spinner-border-sm d-none"></span>

          <% end %>
        </div>

      </div>
    </div>
  </div>


  <!-- 2 DAYS AGO -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card kpi-card border-0 h-100">
      <div class="card-body d-flex flex-column">

        <div class="d-flex justify-content-between mb-2">
          <div class="kpi-icon bg-warning">
            <i class="bi bi-calendar2-minus"></i>
          </div>
          <span class="badge bg-light text-dark">2 Days Ago</span>
        </div>

         <h3 class="fw-bold">
          KSh <%= number_with_delimiter(day2_val.to_i) %>
        </h3>

        <% if day2_growth %>
          <div class="small <%= day2_growth >= 0 ? 'text-success' : 'text-danger' %> mb-2">
            <i class="bi <%= day2_growth >= 0 ? 'bi-arrow-up' : 'bi-arrow-down' %>"></i>
            <%= day2_growth %>% vs baseline
          </div>
        <% end %>

        <div class="mt-auto">
          <%= link_to jmcustomerpayments_path(format: :csv, type: "day_before"),
              class: "btn btn-sm btn-outline-warning w-100 export-btn d-flex align-items-center justify-content-center gap-2",
              data: { turbo: false } do %>

            <i class="bi bi-download"></i>
            <span>Download CSV</span>
            <span class="spinner-border spinner-border-sm d-none"></span>

          <% end %>
        </div>

      </div>
    </div>
  </div>


  <!-- OLDER -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card kpi-card border-0 h-100">
      <div class="card-body d-flex flex-column">

        <div class="d-flex justify-content-between mb-2">
          <div class="kpi-icon bg-dark">
            <i class="bi bi-archive"></i>
          </div>
          <span class="badge bg-light text-dark">Older</span>
        </div>

          <h3 class="fw-bold">
          KSh <%= number_with_delimiter(@current_year_total.to_i) %>
        </h3>

        <div class="mt-auto">
          <%= link_to jmcustomerpayments_path(format: :csv, type: "older"),
              class: "btn btn-sm btn-outline-dark w-100 export-btn d-flex align-items-center justify-content-center gap-2",
              data: { turbo: false } do %>

            <i class="bi bi-download"></i>
            <span>Download CSV</span>
            <span class="spinner-border spinner-border-sm d-none"></span>

          <% end %>
        </div>

      </div>
    </div>
  </div>

</div>

<hr class="separator">
<style>

/* =========================================================
   🚀 ULTRA PREMIUM KPI ANALYTICS UI
========================================================= */

/* =========================================================
   ANALYTICS SECTION BACKGROUND
========================================================= */

.row.g-3.mb-4{

  position:relative;

  z-index:2;
}

/* =========================================================
   KPI CARD
========================================================= */

.kpi-card{

  position:relative;

  overflow:hidden;

  border-radius:30px !important;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.92),
      rgba(248,250,252,.82)
    ) !important;

  border:
    1px solid rgba(255,255,255,.7) !important;

  backdrop-filter:blur(18px);

  box-shadow:
    0 10px 35px rgba(15,23,42,.05),
    inset 0 1px 0 rgba(255,255,255,.9);

  transition:
    transform .35s ease,
    box-shadow .35s ease,
    border-color .35s ease;

  isolation:isolate;
}

/* =========================================================
   AURORA GLOW
========================================================= */

.kpi-card::before{

  content:"";

  position:absolute;

  top:-100px;
  right:-100px;

  width:240px;
  height:240px;

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(37,99,235,.12),
      transparent 72%
    );

  transition:.45s ease;

  z-index:-1;
}

.kpi-card::after{

  content:"";

  position:absolute;

  inset:0;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.14),
      transparent
    );

  opacity:.7;

  pointer-events:none;
}

/* =========================================================
   HOVER EFFECT
========================================================= */

.kpi-card:hover{

  transform:
    translateY(-8px);

  box-shadow:
    0 28px 60px rgba(15,23,42,.12);

  border-color:
    rgba(37,99,235,.18) !important;
}

.kpi-card:hover::before{

  transform:
    scale(1.2);

  opacity:1;
}

/* =========================================================
   FEATURED CARD
========================================================= */

.highlight-card{

  background:
    linear-gradient(
      145deg,
      rgba(37,99,235,.10),
      rgba(255,255,255,.88)
    ) !important;

  border:
    1px solid rgba(37,99,235,.18) !important;

  box-shadow:
    0 20px 45px rgba(37,99,235,.12);
}

/* =========================================================
   CARD BODY
========================================================= */

.kpi-card .card-body{

  padding:1.35rem;

  position:relative;

  z-index:2;
}

/* =========================================================
   ICON WRAPPER
========================================================= */

.kpi-icon{

  position:relative;

  width:54px;
  height:54px;

  border-radius:18px;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:1.2rem;

  color:white;

  overflow:hidden;

  box-shadow:
    0 14px 30px rgba(15,23,42,.14);
}

/* =========================================================
   ICON GLOSS
========================================================= */

.kpi-icon::before{

  content:"";

  position:absolute;

  inset:0;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.35),
      transparent
    );

  opacity:.9;
}

/* =========================================================
   ICON COLORS
========================================================= */

.bg-primary{

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #3b82f6
    ) !important;
}

.bg-secondary{

  background:
    linear-gradient(
      135deg,
      #64748b,
      #94a3b8
    ) !important;
}

.bg-warning{

  background:
    linear-gradient(
      135deg,
      #f59e0b,
      #fbbf24
    ) !important;
}

.bg-dark{

  background:
    linear-gradient(
      135deg,
      #0f172a,
      #334155
    ) !important;
}

/* =========================================================
   BADGE
========================================================= */

.kpi-card .badge{

  height:32px;

  padding:0 14px;

  border-radius:999px;

  display:flex;
  align-items:center;

  background:
    rgba(255,255,255,.72) !important;

  border:
    1px solid rgba(226,232,240,.7);

  color:#334155 !important;

  font-size:.72rem;
  font-weight:800;

  letter-spacing:.03em;

  backdrop-filter:blur(8px);
}

/* =========================================================
   VALUE
========================================================= */

.kpi-card h3{

  margin-top:18px;
  margin-bottom:10px;

  font-size:1.75rem;

  font-weight:900;

  letter-spacing:-.04em;

  color:#0f172a;

  line-height:1.1;
}

/* =========================================================
   GROWTH TEXT
========================================================= */

.kpi-card .small{

  display:inline-flex;
  align-items:center;
  gap:8px;

  width:fit-content;

  min-height:34px;

  padding:0 14px;

  border-radius:999px;

  font-size:.74rem;
  font-weight:800;

  letter-spacing:.02em;
}

.text-success{

  background:
    rgba(16,185,129,.12);

  color:#059669 !important;
}

.text-danger{

  background:
    rgba(239,68,68,.12);

  color:#dc2626 !important;
}

/* =========================================================
   DOWNLOAD BUTTON
========================================================= */

.export-btn{

  position:relative;

  overflow:hidden;

  height:44px;

  border-radius:16px !important;

  border:none !important;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #3b82f6
    ) !important;

  color:white !important;

  font-size:.78rem;
  font-weight:800;

  letter-spacing:.02em;

  transition:
    transform .28s ease,
    box-shadow .28s ease;
}

/* =========================================================
   BUTTON SHINE
========================================================= */

.export-btn::before{

  content:"";

  position:absolute;

  top:0;
  left:-120%;

  width:80%;
  height:100%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.35),
      transparent
    );

  transition:.7s ease;
}

.export-btn:hover::before{

  left:140%;
}

/* =========================================================
   BUTTON HOVER
========================================================= */

.export-btn:hover{

  transform:
    translateY(-2px);

  box-shadow:
    0 14px 30px rgba(37,99,235,.28);
}

.export-btn:active{

  transform:scale(.98);
}

/* =========================================================
   BUTTON ICON
========================================================= */

.export-btn i{

  font-size:.9rem;
}

/* =========================================================
   SPINNER
========================================================= */

.spinner-border-sm{

  width:.85rem;
  height:.85rem;
}

/* =========================================================
   SEPARATOR
========================================================= */

.separator{

  border:none;

  height:1px;

  background:
    linear-gradient(
      to right,
      transparent,
      rgba(148,163,184,.24),
      transparent
    );

  margin:2.5rem 0;

  opacity:1;
}

/* =========================================================
   FLOATING GRID EFFECT
========================================================= */

.kpi-card .card-body::before{

  content:"";

  position:absolute;

  inset:0;

  background-image:

    linear-gradient(
      rgba(148,163,184,.025) 1px,
      transparent 1px
    ),

    linear-gradient(
      90deg,
      rgba(148,163,184,.025) 1px,
      transparent 1px
    );

  background-size:30px 30px;

  pointer-events:none;

  z-index:-1;
}

/* =========================================================
   MOBILE UX
========================================================= */

@media(max-width:768px){

  .kpi-card{

    border-radius:24px !important;
  }

  .kpi-card .card-body{

    padding:1rem;
  }

  .kpi-icon{

    width:46px;
    height:46px;

    border-radius:15px;

    font-size:1rem;
  }

  .kpi-card h3{

    font-size:1.3rem;
  }

  .export-btn{

    height:40px;

    border-radius:14px !important;

    font-size:.74rem;
  }

  .kpi-card .badge{

    height:28px;

    font-size:.66rem;
  }

  .kpi-card .small{

    font-size:.68rem;

    padding:0 10px;
  }
}
</style>


<div class="container my-4">

<div class="row g-3 mt-2">

  <!-- CURRENT YEAR -->
  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex flex-column">

        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <span class="badge bg-success">Current Year</span>
            <div class="small text-muted mt-1">
              Revenue Collected
            </div>
          </div>

          <div class="fs-4 text-success">
            <i class="bi bi-calendar-range"></i>
          </div>
        </div>

        <h3 class="fw-bold">
          KSh <%= number_with_delimiter(@current_year_total.to_i) %>
        </h3>

        <div class="mt-2">
          <span class="badge <%= @year_growth_1 >= 0 ? 'bg-success' : 'bg-danger' %>">
            <%= @year_growth_1 %>%
          </span>
          <small class="text-muted ms-1">vs Previous Year</small>
        </div>

      </div>
    </div>
  </div>

  <!-- PREVIOUS YEAR -->
  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex flex-column">

        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <span class="badge bg-primary">Previous Year</span>
            <div class="small text-muted mt-1">
              Revenue Collected
            </div>
          </div>

          <div class="fs-4 text-primary">
            <i class="bi bi-calendar3"></i>
          </div>
        </div>

        <h3 class="fw-bold">
          KSh <%= number_with_delimiter(@prev_year_total.to_i) %>
        </h3>

        <div class="mt-2">
          <span class="badge <%= @year_growth_2 >= 0 ? 'bg-success' : 'bg-danger' %>">
            <%= @year_growth_2 %>%
          </span>
          <small class="text-muted ms-1">vs 2 Years Ago</small>
        </div>

      </div>
    </div>
  </div>

  <!-- 2 YEARS AGO -->
  <div class="col-md-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex flex-column">

        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <span class="badge bg-dark">2 Years Ago</span>
            <div class="small text-muted mt-1">
