<hr/>

<div class="row g-3 mb-4">

  <!-- PROJECTED CURRENT MONTH -->
<div class="col-md-3">
  <div class="card border-0 shadow-sm h-100 bg-success bg-gradient text-white">
    <div class="card-body d-flex flex-column">

      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <span class="badge bg-light text-success fw-semibold">
            Projected Revenue
          </span>
          <div class="small opacity-75 mt-1">
            Current Month Forecast
          </div>
        </div>

        <div class="fs-3">
          <i class="bi bi-graph-up-arrow"></i>
        </div>
      </div>

      <h3 class="fw-bold mb-2">
        KSh <%= number_with_delimiter(@projected_current_month.to_i) %>
      </h3>

 <% if @projection_vs_last_month.present? %>
  <% positive = @projection_vs_last_month >= 0 %>

  <span class="badge rounded-pill px-3 py-2
    <%= positive ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %>">

    <i class="bi <%= positive ? 'bi-arrow-up-right' : 'bi-arrow-down-right' %>"></i>

    <%= number_with_precision(@projection_vs_last_month, precision: 0) %>%
  </span>

  <small class="text-muted ms-2">
    vs last month
  </small>
<% end %>

      <div class="mt-auto pt-3 border-top border-light border-opacity-25">
        <small class="text-white-50 d-block">
          Based on 3-Month Average + KSh 1M
        </small>

        <small class="fw-semibold">
          Avg: KSh <%= number_with_delimiter(@avg_3_months.to_i) %>
        </small>
      </div>

    </div>
  </div>
</div>
<!-- CURRENT MONTH -->
<div class="col-md-3">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-body d-flex flex-column">

      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <span class="badge bg-primary">
            Current Month
          </span>
          <div class="small text-muted mt-1">
            Revenue Collected
          </div>
        </div>

        <div class="fs-4 text-primary">
          <i class="bi bi-calendar3"></i>
        </div>
      </div>

      <h3 class="fw-bold mb-2">
        KSh <%= number_with_delimiter(@current_month_total.to_i) %>
      </h3>

      <% if @month_growth_1.present? %>
        <div class="mb-3">
          <span class="badge <%= @month_growth_1 >= 0 ? 'bg-success' : 'bg-danger' %>">
            <i class="bi <%= @month_growth_1 >= 0 ? 'bi-arrow-up-right' : 'bi-arrow-down-right' %>"></i>
            <%= @month_growth_1 %>%
          </span>

          <small class="text-muted ms-1">
            vs Last Month
          </small>
        </div>
      <% end %>

      <div class="mt-auto pt-3 border-top">
        <small class="text-muted d-block mb-2">
          Current Month Transactions
        </small>

        <%= link_to jmcustomerpayments_path(format: :csv, type: "current_month"),
            class: "btn btn-sm btn-outline-primary w-100 export-btn d-flex align-items-center justify-content-center gap-2",
            data: { turbo: false } do %>

          <i class="bi bi-download"></i>
          <span>Download CSV</span>
          <span class="spinner-border spinner-border-sm d-none"></span>

        <% end %>
      </div>

    </div>
  </div>
</div>
<!-- LAST MONTH -->
<div class="col-md-3">
  <div class="card border-0 shadow-sm h-100">
