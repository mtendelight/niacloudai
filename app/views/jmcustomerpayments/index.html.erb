<div class="container my-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">🔁 Most Active Customers (By Transactions)</h5>
  </div>

  <!-- Card -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">

      <table class="table align-middle table-hover mb-0">

        <!-- Head -->
        <thead class="table-light">
          <tr class="text-muted small text-uppercase">
            <th style="width: 60px;">#</th>
            <th>Customer</th>
            <th class="text-center">Transactions</th>
            <th class="text-end">Total Paid</th>
          </tr>
        </thead>

        <!-- Body -->
        <tbody>
          <% @top_customers_by_transactions.each_with_index do |c, i| %>
            <% rank = i + 1 %>

            <tr>

              <!-- Rank -->
              <td>
                <span class="badge rounded-pill px-3 py-2 
                  <%= case rank
                      when 1 then 'bg-warning text-dark'
                      when 2 then 'bg-secondary'
                      when 3 then 'bg-danger'
                      else 'bg-light text-dark border'
                      end %>">
                  <%= rank %>
                </span>
              </td>

              <!-- Name -->
              <td class="fw-semibold">
                <%= c.name.presence || "—" %>
              </td>


              <!-- Transactions -->
              <td class="text-center">
                <span class="badge bg-primary-subtle text-dark px-3 py-2">
                  <%= c.total_payments %>
                </span>
              </td>

              <!-- Total Paid -->
              <td class="text-end fw-bold">
                <span class="text-success">
                  KES <%= number_with_delimiter(c.total_paid.to_i) %>
                </span>
              </td>

            </tr>
          <% end %>

          <!-- Empty state -->
          <% if @top_customers_by_transactions.blank? %>
            <tr>
              <td colspan="5" class="text-center text-muted py-4">
                No transaction data available
              </td>
            </tr>
          <% end %>

        </tbody>

      </table>
    </div>
  </div>
</div>


<script type="text/javascript">
  
document.addEventListener('DOMContentLoaded', function() {
  const selectElement = document.querySelector('#rows-per-page-form select');

  if (selectElement) {
    selectElement.addEventListener('change', function() {
      document.querySelector('#rows-per-page-form').submit();
    });
  }
});

</script>



