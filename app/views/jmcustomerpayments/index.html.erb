<script>

document.addEventListener("DOMContentLoaded", function(){

  // =====================================================
  // GLOBAL CHART FIXES
  // =====================================================

  Chart.defaults.responsive = true;

  Chart.defaults.maintainAspectRatio = false;

  Chart.defaults.animation = false;

  Chart.defaults.devicePixelRatio =
    window.devicePixelRatio || 1;

  Chart.defaults.events = [

    "mousemove",
    "mouseout",
    "click",
    "touchstart",
    "touchmove"

  ];

  // =====================================================
  // DATA
  // =====================================================

  const labels =
    <%= raw @days.to_json %>;

  const current =
    <%= raw @current_daily.to_json %>;

  const prev1 =
    <%= raw @prev1_daily.to_json %>;

  const prev2 =
    <%= raw @prev2_daily.to_json %>;

  const cumulative =
    <%= raw @current_cumulative.to_json %>;

  // =====================================================
  // COLORS
  // =====================================================

  const COLORS = {

    blue:"#2563eb",

    green:"#10b981",

    orange:"#f59e0b",

    red:"#ef4444",

    purple:"#7c3aed",

    text:"#64748b",

    dark:"#0f172a",

    grid:"rgba(148,163,184,.08)"
  };

  // =====================================================
  // CHART REGISTRY
  // =====================================================

  const charts = {};

  // =====================================================
  // GRADIENT
  // =====================================================

  function gradient(ctx,color){

    const g =
      ctx.createLinearGradient(
        0,
        0,
        0,
        520
      );

    g.addColorStop(
      0,
      color.replace("1)", ".28)")
    );

    g.addColorStop(
      1,
      color.replace("1)", ".02)")
    );

    return g;
  }

  // =====================================================
  // COMMON OPTIONS
  // =====================================================

  const commonOptions = {

    responsive:true,

    maintainAspectRatio:false,

    interaction:{

      mode:"nearest",

      axis:"x",

      intersect:false
    },

    plugins:{

      legend:{

        position:"bottom",

        labels:{

          usePointStyle:true,

          pointStyle:"circle",

          padding:24,

          color:COLORS.text,

          font:{
            size:12,
            weight:"700"
          }
        }
      },

      tooltip:{

        enabled:true,

        backgroundColor:
          "rgba(255,255,255,.96)",

        titleColor:
          COLORS.dark,

        bodyColor:
          COLORS.text,

        borderColor:
          "rgba(226,232,240,.9)",

        borderWidth:1,

        cornerRadius:18,

        padding:16,

        displayColors:true,

        callbacks:{

          label(context){

            return (
              context.dataset.label +
              ": KSh " +
              Number(
                context.raw ||
                context.parsed.y ||
                0
              ).toLocaleString()
            );

          }
        }
      }
    },

    scales:{

      x:{

        grid:{
          display:false
        },

        border:{
          display:false
        },

        ticks:{

          color:"#94a3b8",

          font:{
            size:11,
            weight:"700"
          }
        }
      },

      y:{

        beginAtZero:true,

        border:{
          display:false
        },

        grid:{
          color:COLORS.grid
        },

        ticks:{

          color:COLORS.text,

          font:{
            size:11,
            weight:"700"
          },

          callback(value){

            return (
              "KSh " +
              Number(value).toLocaleString()
            );
          }
        }
      }
    }
  };

  // =====================================================
  // DATASET HELPER
  // =====================================================

  function datasetConfig(){

    return {

      hitRadius:24,

      hoverRadius:8,

      pointHitRadius:24,

      pointHoverRadius:8
    };

  }

  // =====================================================
  // LINE
  // =====================================================

  const lineCtx =
    document
      .getElementById(
        "mergedLineChart"
      )
      .getContext("2d");

  charts.line = new Chart(lineCtx,{

    type:"line",

    data:{

      labels,

      datasets:[

        {

          ...datasetConfig(),

          label:"This Month",

          data:current,

          borderColor:COLORS.blue,

          backgroundColor:
            gradient(
              lineCtx,
              "rgba(37,99,235,1)"
            ),

          fill:true,

          tension:.45,

          borderWidth:4,

          pointRadius:0
        },

        {

          ...datasetConfig(),

          label:"Last Month",

          data:prev1,

          borderColor:COLORS.red,

          borderDash:[8,6],

          borderWidth:3,

          tension:.45,

          pointRadius:0
        },

        {

          ...datasetConfig(),

          label:"2 Months Ago",

          data:prev2,

          borderColor:COLORS.green,

          borderDash:[3,3],

          borderWidth:3,

          tension:.45,

          pointRadius:0
        }

      ]
    },

    options:commonOptions
  });

  // =====================================================
  // BAR
  // =====================================================

  charts.bar = new Chart(

    document.getElementById(
      "mergedBarChart"
    ),

    {

      type:"bar",

      data:{

        labels,

        datasets:[

          {

            ...datasetConfig(),

            label:"This Month",

            data:current,

            backgroundColor:
              "rgba(37,99,235,.88)",

            borderRadius:18,

            borderSkipped:false
          },

          {

            ...datasetConfig(),

            label:"Last Month",

            data:prev1,

            backgroundColor:
              "rgba(16,185,129,.88)",

            borderRadius:18,

            borderSkipped:false
          },

          {

            ...datasetConfig(),

            label:"2 Months Ago",

            data:prev2,

            backgroundColor:
              "rgba(245,158,11,.88)",

            borderRadius:18,

            borderSkipped:false
          }

        ]
      },

      options:commonOptions
    }
  );

  // =====================================================
  // RADAR
  // =====================================================

  charts.radar = new Chart(

    document.getElementById(
      "mergedRadarChart"
    ),

    {

      type:"radar",

      data:{

        labels,

        datasets:[

          {

            ...datasetConfig(),

            label:"This Month",

            data:current,

            borderColor:COLORS.blue,

            backgroundColor:
              "rgba(37,99,235,.18)",

            borderWidth:3
          },

          {

            ...datasetConfig(),

            label:"Last Month",

            data:prev1,

            borderColor:COLORS.red,

            backgroundColor:
              "rgba(239,68,68,.12)",

            borderWidth:3
          }

        ]
      },

      options:{
        ...commonOptions
      }
    }
  );

  // =====================================================
  // STREAM
  // =====================================================

  charts.stream = new Chart(

    document.getElementById(
      "mergedStreamChart"
    ),

    {

      type:"line",

      data:{

        labels,

        datasets:[

          {

            ...datasetConfig(),

            label:"2 Months Ago",

            data:prev2,

            fill:true,

            backgroundColor:
              "rgba(245,158,11,.35)",

            borderColor:"#f59e0b",

            tension:.45,

            pointRadius:0
          },

          {

            ...datasetConfig(),

            label:"Last Month",

            data:prev1,

            fill:true,

            backgroundColor:
              "rgba(16,185,129,.35)",

            borderColor:"#10b981",

            tension:.45,

            pointRadius:0
          },

          {

            ...datasetConfig(),

            label:"This Month",

            data:current,

            fill:true,

            backgroundColor:
              "rgba(37,99,235,.35)",

            borderColor:"#2563eb",

            tension:.45,

            pointRadius:0
          }

        ]
      },

      options:commonOptions
    }
  );

  // =====================================================
  // BUBBLE
  // =====================================================

  // =====================================================
// BUBBLE CHART FIXED
// =====================================================

charts.bubble = new Chart(

  document.getElementById(
    "mergedBubbleChart"
  ),

  {

    type:"bubble",

    data:{

      datasets:[

        {

          label:"This Month",

          data:
            current.map((v,i)=>({

              x:i + 1,

              y:v,

              r:Math.max(
                Math.min(v / 7000, 28),
                6
              )

            })),

          backgroundColor:
            current.map(v => {

              const alpha =
                Math.max(
                  Math.min(v / Math.max(...current), 1),
                  .25
                );

              return `rgba(37,99,235,${alpha})`;

            }),

          borderColor:"#2563eb",

          borderWidth:2,

          hoverBorderWidth:3,

          hoverBackgroundColor:
            "rgba(37,99,235,.72)",

          hoverBorderColor:"#1d4ed8",

          hitRadius:30,

          hoverRadius:10
        }

      ]
    },

    options:{

      ...commonOptions,

      interaction:{

        mode:"nearest",

        intersect:true
      },

      plugins:{

        ...commonOptions.plugins,

        tooltip:{

          ...commonOptions.plugins.tooltip,

          callbacks:{

            label(context){

              const point =
                context.raw;

              return [

                `Day: ${point.x}`,

                `Revenue: KSh ${
                  Number(point.y)
                    .toLocaleString()
                }`,

                `Intensity: ${point.r}`
              ];

            }
          }
        }
      },

      scales:{

        x:{

          beginAtZero:true,

          grid:{
            color:"rgba(148,163,184,.08)"
          },

          ticks:{

            color:"#94a3b8",

            font:{
              size:11,
              weight:"700"
            }
          }
        },

        y:{

          beginAtZero:true,

          grid:{
            color:"rgba(148,163,184,.08)"
          },

          ticks:{

            color:"#64748b",

            font:{
              size:11,
              weight:"700"
            },

            callback(value){

              return (
                "KSh " +
                Number(value)
                  .toLocaleString()
              );

            }
          }
        }
      }
    }
  }
);

  // =====================================================
  // FORECAST
  // =====================================================

  const forecastCtx =
    document
      .getElementById(
        "mergedForecastChart"
      )
      .getContext("2d");

  charts.forecast = new Chart(

    forecastCtx,

    {

      type:"line",

      data:{

        labels,

        datasets:[

          {

            ...datasetConfig(),

            label:"Cumulative Revenue",

            data:cumulative,

            borderColor:"#7c3aed",

            backgroundColor:
              gradient(
                forecastCtx,
                "rgba(124,58,237,1)"
              ),

            fill:true,

            tension:.45,

            borderWidth:4,

            pointRadius:0
          }

        ]
      },

      options:commonOptions
    }
  );

  // =====================================================
  // REFRESH ENGINE
  // =====================================================

  function refreshChart(chart){

    if(!chart) return;

    chart._active = [];

    chart.resize();

    chart.update("resize");

    chart.render();

    chart.bindEvents();

  }

  function refreshAllCharts(){

    Object.values(charts)
      .forEach(chart => {

        refreshChart(chart);

      });

  }

  // =====================================================
// PREMIUM HEATMAP ENGINE
// =====================================================

const heatmap =
  document.getElementById(
    "mergedHeatmap"
  );

if(heatmap){

  // CLEAR OLD
  heatmap.innerHTML = "";

  const months = [

    {
      name:"<%= 2.months.ago.strftime('%b %Y') %>",
      values:prev2
    },

    {
      name:"<%= 1.month.ago.strftime('%b %Y') %>",
      values:prev1
    },

    {
      name:"<%= Date.today.strftime('%b %Y') %>",
      values:current
    }

  ];

  const allValues =
    months.flatMap(m => m.values);

  const max =
    Math.max(...allValues,1);

  const grid =
    document.createElement("div");

  grid.className =
    "modern-heatmap-grid";

  // EMPTY CORNER
  const corner =
    document.createElement("div");

  grid.appendChild(corner);

  // DAYS
  for(let d=1; d<=31; d++){

    const header =
      document.createElement("div");

    header.className =
      "modern-heatmap-header";

    header.innerText = d;

    grid.appendChild(header);

  }

  // MONTHS
  months.forEach(month => {

    const label =
      document.createElement("div");

    label.className =
      "modern-month-label";

    label.innerText =
      month.name;

    grid.appendChild(label);

    for(let i=0;i<31;i++){

      const value =
        month.values[i] || 0;

      const intensity =
        value / max;

      const alpha =
        Math.max(
          intensity,
          .08
        );

      const cell =
        document.createElement("div");

      cell.className =
        "modern-heat-cell";

      cell.style.background =
        `linear-gradient(
          145deg,
          rgba(59,130,246,${alpha}),
          rgba(37,99,235,${alpha * .88})
        )`;

      cell.title =
        `${month.name}
Day ${i+1}
KSh ${Number(value)
          .toLocaleString()}`;

      grid.appendChild(cell);

    }

  });

  heatmap.appendChild(grid);

}

  // =====================================================
  // TAB SWITCHER
  // =====================================================

  const tabs =
    document.querySelectorAll(".chart-tab");

  const panes =
    document.querySelectorAll(".chart-pane");

  tabs.forEach(tab => {

    tab.addEventListener("click", function(){

      const targetId =
        this.dataset.chart;

      tabs.forEach(t =>
        t.classList.remove("active")
      );

      panes.forEach(p =>
        p.classList.remove("active")
      );

      this.classList.add("active");

      const target =
        document.getElementById(targetId);

      if(target){

        target.classList.add("active");

        requestAnimationFrame(() => {

          setTimeout(() => {

            refreshAllCharts();

            window.dispatchEvent(
              new Event("resize")
            );

          }, 120);

        });

      }

    });

  });

  // =====================================================
  // INITIAL FIX
  // =====================================================

  window.addEventListener("load", () => {

    setTimeout(() => {

      refreshAllCharts();

    }, 400);

  });

  // =====================================================
  // VISIBILITY FIX
  // =====================================================

  document.addEventListener(
    "visibilitychange",
    () => {

      if(!document.hidden){

        setTimeout(() => {

          refreshAllCharts();

        }, 120);

      }

    }
  );

});
</script>

